probeSource : String
probeSource = "{-# OPTIONS --guardedness #-}\nmodule Probe where\nopen import Data.List using (List; []; _∷_)\nopen import Data.Product using (_,_; proj₂)\nopen import Data.String using (String; _≟_)\nopen import Data.Bool using (Bool; true; false; _∧_; if_then_else_)\nopen import Data.Nat using (_≡ᵇ_)\nopen import Data.Unit using (⊤; tt)\nopen import Agda.Builtin.String using (primStringEquality)\nimport IO.Primitive as IO\nimport IO.Primitive.Finite as F\nopen import Ownership\nopen import OwnershipIO.FFI using (ProcResult; procResult; exitFailure)\nopen import SessionEnv\n\nsame : ProcResult → ProcResult → Bool\nsame (procResult n out err) (procResult m out′ err′) = (n ≡ᵇ m) ∧ primStringEquality out out′ ∧ primStringEquality err err′\n\nLive : St\nLive = Dir ((\"procExec\" , Chan (Srv ProcReq ProcOut (Dir []))) ∷ [])\n\ncases : List String\ncases = \"\" ∷ \"alpha\\nbeta\\n\" ∷ \"λ unicode\\n\" ∷ \"no newline\" ∷ []\n\nloop : List String → Prog SessionΨ Live Live Bool\nloop [] = done true\nloop (s ∷ ss) = call \"procExec\" (procReq \"ref\" [] s) >>= λ ref →\n  loop ss >>= λ rest → done (same ref (procResult 0 s \"\") ∧ rest)\n\nmyProg : Prog SessionΨ (Dir []) (Dir []) Bool\nmyProg = mkdir \"procExec\" >> open′ \"procExec\" >> loop cases >>= λ passed →\n  stop \"procExec\" >> rmdir \"procExec\" >> done passed\n\nmain : IO.IO ⊤\nmain = evalIO sessionEnv myProg tt IO.>>= λ result →\n  if proj₂ result then F.putStrLn \"batch probe passed\" else exitFailure\n"

replaySource : String
replaySource = "{-# OPTIONS --guardedness #-}\nmodule Replay where\nopen import Data.List using (List; []; _∷_)\nopen import Data.Product using (_,_; proj₂)\nopen import Data.String using (String; _≟_)\nopen import Data.Bool using (Bool; true; false; _∧_; if_then_else_)\nopen import Data.Nat using (_≡ᵇ_)\nopen import Data.Unit using (⊤; tt)\nopen import Agda.Builtin.String using (primStringEquality)\nimport IO.Primitive as IO\nimport IO.Primitive.Finite as F\nopen import Ownership\nopen import OwnershipIO.FFI using (ProcResult; procResult; exitFailure)\nopen import SessionEnv\n\nsame : ProcResult → ProcResult → Bool\nsame (procResult n out err) (procResult m out′ err′) = (n ≡ᵇ m) ∧ primStringEquality out out′ ∧ primStringEquality err err′\n\nLive : St\nLive = Dir ((\"procExec\" , Chan (Srv ProcReq ProcOut (Dir []))) ∷ [])\n\ncases : List String\ncases = \"\" ∷ \"alpha\\nbeta\\n\" ∷ \"λ unicode\\n\" ∷ \"no newline\" ∷ []\n\nloop : List String → Prog SessionΨ Live Live Bool\nloop [] = done true\nloop (s ∷ ss) = call \"procExec\" (procReq \"ref\" [] s) >>= λ ref →\n  call \"procExec\" (procReq \"cand\" [] s) >>= λ cand →\n  loop ss >>= λ rest → done (same ref cand ∧ rest)\n\nmyProg : Prog SessionΨ (Dir []) (Dir []) Bool\nmyProg = mkdir \"procExec\" >> open′ \"procExec\" >> loop cases >>= λ passed →\n  stop \"procExec\" >> rmdir \"procExec\" >> done passed\n\nmain : IO.IO ⊤\nmain = evalIO sessionEnv myProg tt IO.>>= λ result →\n  if proj₂ result then F.putStrLn \"replay passed\" else exitFailure\n"

ptySource : String
ptySource = "{-# OPTIONS --guardedness #-}\nmodule TerminalProbe where\nopen import Data.List using ([]; _∷_)\nopen import Data.Product using (_,_; proj₂)\nopen import Data.Bool using (if_then_else_)\nopen import Data.Maybe using (just; nothing)\nopen import Data.Nat using (ℕ; zero; suc)\nopen import Data.Unit using (⊤; tt)\nimport IO.Primitive as IO\nimport IO.Primitive.Finite as F\nopen import Ownership hiding (Home)\nopen import OwnershipIO.FFI using (exitFailure)\nopen import SessionEnv\nopen import Code.TermTool using (hexBytes)\nopen import Agda.Builtin.String using (primStringEquality)\n\ncfg : TermConfig\ncfg = termConfig localSandbox pipeStdioWithTTY \"ref\" [] [] 24 80 []\nHome Live : St\nHome = Dir ((\"terminal\" , Dir []) ∷ [])\nLive = Dir ((\"terminal\" , Chan (Srv TermStep RawTermObs (Dir []))) ∷ [])\nsettle : ℕ → RawTermObs → Prog SessionΨ Live Live RawTermObs\nsettle zero obs = done obs\nsettle (suc fuel) obs with exitStatus obs\n... | just _ = done obs\n... | nothing = call \"terminal\" drainRaw >>= λ more → settle fuel (appendObs obs more)\n\nmyProg : Prog SessionΨ Home Home RawTermObs\nmyProg = openAs \"terminal\" \"pty\" cfg >>\n  call \"terminal\" (writeStdin (bytes \"hello\\n\")) >>= λ a →\n  call \"terminal\" (sleepMs 50) >>= λ b →\n  call \"terminal\" (resizeTTY 20 70) >>= λ r →\n  call \"terminal\" (writeTTY (encodeKey escape)) >>= λ k →\n  call \"terminal\" closeStdin >>= λ c →\n  call \"terminal\" (sleepMs 50) >>= λ d →\n  settle 100 (appendObs a (appendObs b (appendObs r (appendObs k (appendObs c d))))) >>= λ obs →\n  stop \"terminal\" >> done obs\nmain : IO.IO ⊤\nmain = evalIO sessionEnv myProg (tt , tt) IO.>>= λ result →\n  if primStringEquality (hexBytes (stdoutOut (proj₂ result))) (hexBytes (bytes \"hello\\n\"))\n  then F.putStrLn \"terminal probe passed\" else exitFailure\n"

