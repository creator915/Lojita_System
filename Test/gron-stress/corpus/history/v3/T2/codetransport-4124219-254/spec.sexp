ch URL\n  5\tFailed to parse statements\n  6\tFailed to encode JSON\n\nExamples:\n  gron /tmp/apiresponse.json\n  gron http://jsonplaceholder.typicode.com/users/1 \n  curl -s http://jsonplaceholder.typicode.com/users/1 | gron\n  gron http://jsonplaceholder.typicode.com/users/1 | grep company | gron --ungron\n"))))) (sig (mods) "version" (app (app (def "Agda.Builtin.Equality._≡_") (arg vis _ (app (app (def "Gen.T2.GronCLI.plan") (arg vis _ (con (q "Gen.T0.Gron.StdoutAttachment.stdoutPipe" "Base.stdoutPipe")))) (arg vis _ (app (app (con "Agda.Builtin.List.List._∷_") (arg vis _ (lit (str "--version")))) (arg vis _ (con "Agda.Builtin.List.List.[]"))))))) (arg vis _ (app (con "Gen.T2.GronCLI.Invocation.completed") (arg vis _ (app (app (app (con "Gen.T2.GronCLI.result") (arg vis _ (lit (nat 0)))) (arg vis _ (lit (str "gron version dev\n")))) (arg vis _ (lit (str ""))))))))) (sig (mods) "longHelp" (app (app (def "Agda.Builtin.Equality._≡_") (arg vis _ (app (app (def "Gen.T2.GronCLI.plan") (arg vis _ (con (q "Gen.T0.Gron.StdoutAttachment.stdoutPipe" "Base.stdoutPipe")))) (arg vis _ (app (app (con "Agda.Builtin.List.List._∷_") (arg vis _ (lit (str "--help")))) (arg vis _ (con "Agda.Builtin.List.List.[]"))))))) (arg vis _ (app (con "Gen.T2.GronCLI.Invocation.completed") (arg vis _ (app (app (app (con "Gen.T2.GronCLI.result") (arg vis _ (lit (nat 0)))) (arg vis _ (lit (str "")))) (arg vis _ (def "Gen.T2.GronCLI.usage")))))))) (sig (mods) "shortHelp" (app (app (def "Agda.Builtin.Equality._≡_") (arg vis _ (app (app (def "Gen.T2.GronCLI.plan") (arg vis _ (con (q "Gen.T0.Gron.StdoutAttachment.stdoutPipe" "Base.stdoutPipe")))) (arg vis _ (app (app (con "Agda.Builtin.List.List._∷_") (arg vis _ (lit (str "-h")))) (arg vis _ (con "Agda.Builtin.List.List.[]"))))))) (arg vis _ (app (con "Gen.T2.GronCLI.Invocation.completed") (arg vis _ (app (app (app (con "Gen.T2.GronCLI.result") (arg vis _ (lit (nat 0)))) (arg vis _ (lit (str "")))) (arg vis _ (def "Gen.T2.GronCLI.usage")))))))) (sig (