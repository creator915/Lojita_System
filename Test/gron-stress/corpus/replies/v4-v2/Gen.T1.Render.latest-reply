(submission
  (kind add-moves)
  (why "当前提交仍受锁定规约阻塞。父节点需采用 @constructorRepair 中分别绑定元素与尾列表的三个构造子签名，并统一 16 个含 fromℕ 的签名的语法表示。")
  (main @main)
  (moves))
```agda constructorRepair
module RenderConstructorRepair where

open import Data.List using (List; []; _∷_)
open import Data.Empty using (⊥)
open import Relation.Binary.PropositionalEquality using (_≡_; _≢_; subst; sym)

data Comparison : Set where
  before : Comparison
  equal : Comparison
  after : Comparison

data Permutation {A : Set} : List A → List A → Set where
  permutation-refl : {xs : _} → Permutation xs xs
  permutation-keep : {x : _} → {xs : _} → {ys : _} → Permutation xs ys → Permutation (x ∷ xs) (x ∷ ys)
  permutation-swap : {x : _} → {y : _} → {xs : _} → Permutation (x ∷ (y ∷ xs)) (y ∷ (x ∷ xs))
  permutation-trans : {xs ys zs : _} → Permutation xs ys → Permutation ys zs → Permutation xs zs

data Ordered {A : Set} (compare : A → A → Comparison) : List A → Set where
  ordered-empty : Ordered compare []
  ordered-single : (x : _) → Ordered compare (x ∷ [])
  ordered-next : {x : _} → {y : _} → {ys : _} → (compare x y ≢ Comparison.after) → Ordered compare (y ∷ ys) → Ordered compare (x ∷ (y ∷ ys))

prefixPermutation : {A : Set} → (x : A) → {xs ys : List A} → Permutation xs ys → Permutation (x ∷ xs) (x ∷ ys)
prefixPermutation x proof = permutation-keep {x = x} proof

adjacentOrder : {A : Set} → (cmp : A → A → Comparison) → (x y : A) → (ys : List A) → cmp x y ≢ after → Ordered cmp (y ∷ ys) → Ordered cmp (x ∷ (y ∷ ys))
adjacentOrder cmp x y ys previous ordered = ordered-next {x = x} {y = y} {ys = ys} previous ordered

noSharedDomain : ((A : Set) → A ≡ List A) → ⊥
noSharedDomain shared = subst (λ A → A) (sym (shared ⊥)) []

```

```agda main
module Gen.T1.Render where

open import Agda.Builtin.Nat using (div-helper; mod-helper)
open import Agda.Builtin.String using (primShowNat)
open import Data.Bool using (Bool; false; true)
open import Data.Char using (Char; fromℕ; toℕ)
open import Data.Empty using (⊥; ⊥-elim)
open import Data.List using (List; []; _∷_; [_]; _++_; any; map)
open import Data.Maybe using (Maybe)
open import Data.Nat using (ℕ; zero; suc; _+_; _≤_; _<_; z≤n; s≤s)
open import Data.Nat.Properties using (_<?_; _≤?_; <-asym; <-irrefl; ≤-trans) renaming (_≟_ to _≟ℕ_)
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Data.String using (String; fromList; toList)
open import Data.String.Properties using (_≟_)
open import Data.Sum using (_⊎_; inj₁; inj₂)
open import Relation.Binary.PropositionalEquality using (_≡_; _≢_; refl; cong; cong₂; sym; trans)
open import Relation.Nullary using (Dec; yes; no)
open import Relation.Nullary.Decidable using (isYes)
import Gen.T0.Gron as Base

data Style : Set where
  plain : Style
  ansi : Style

styleBit : Style → Bool
styleBit plain = false
styleBit ansi = true

data Tone : Set where
  violet : Tone
  red : Tone
  yellow : Tone
  cyan : Tone
  blueBold : Tone
  bold : Tone
  green : Tone

data Quoting : Set where
  forwardQuote : Quoting
  reverseQuote : Quoting

data KeyForm : Set where
  dotted : KeyForm
  bracketed : KeyForm

data Comparison : Set where
  before : Comparison
  equal : Comparison
  after : Comparison

data Permutation {A : Set} : List A → List A → Set where
  permutation-refl : {xs : _} → Permutation xs xs
  permutation-keep : {x : _} → {xs : _} → {ys : _} → Permutation xs ys → Permutation (x ∷ xs) (x ∷ ys)
  permutation-swap : {x : _} → {y : _} → {xs : _} → Permutation (x ∷ (y ∷ xs)) (y ∷ (x ∷ xs))
  permutation-trans : {xs ys zs : _} → Permutation xs ys → Permutation ys zs → Permutation xs zs

data Ordered {A : Set} (compare : A → A → Comparison) : List A → Set where
  ordered-empty : Ordered compare []
  ordered-single : (x : _) → Ordered compare (x ∷ [])
  ordered-next : {x : _} → {y : _} → {ys : _} → (compare x y ≢ Comparison.after) → Ordered compare (y ∷ ys) → Ordered compare (x ∷ (y ∷ ys))

data RowFormat : Set where
  assignments : RowFormat
  jsonRows : RowFormat

private
  styleOfBit : Bool → Style
  styleOfBit false = plain
  styleOfBit true = ansi

  recoversBit : (b : Bool) → styleBit (styleOfBit b) ≡ b
  recoversBit false = refl
  recoversBit true = refl

resolveStyle : Bool → Bool → Bool → Style
resolveStyle tty forced mono = styleOfBit (Base.useColor tty forced mono)

style-square : (tty : _) → (forced : _) → (mono : _) → styleBit (resolveStyle tty forced mono) ≡ Base.useColor tty forced mono
style-square tty forced mono = recoversBit (Base.useColor tty forced mono)

paint : Style → Tone → List Char → List Char
paint plain tone body = body
paint ansi violet body = (fromℕ 27 ∷ toList "[35m") ++ (body ++ (fromℕ 27 ∷ toList "[0m"))
paint ansi red body = (fromℕ 27 ∷ toList "[31m") ++ (body ++ (fromℕ 27 ∷ toList "[0m"))
paint ansi yellow body = (fromℕ 27 ∷ toList "[33m") ++ (body ++ (fromℕ 27 ∷ toList "[0m"))
paint ansi cyan body = (fromℕ 27 ∷ toList "[36m") ++ (body ++ (fromℕ 27 ∷ toList "[0m"))
paint ansi blueBold body = (fromℕ 27 ∷ toList "[34;1m") ++ (body ++ (fromℕ 27 ∷ toList "[0;22m"))
paint ansi bold body = (fromℕ 27 ∷ toList "[1m") ++ (body ++ (fromℕ 27 ∷ toList "[22m"))
paint ansi green body = (fromℕ 27 ∷ toList "[32m") ++ (body ++ (fromℕ 27 ∷ toList "[0m"))

paint-plain : (tone : _) → (body : _) → paint Style.plain tone body ≡ body
paint-plain tone body = refl

paint-violet : (body : _) → paint Style.ansi Tone.violet body ≡ ((fromℕ 27 ∷ toList "[35m") ++ (body ++ (fromℕ 27 ∷ toList "[0m")))
paint-violet body = refl

paint-red : (body : _) → paint Style.ansi Tone.red body ≡ ((fromℕ 27 ∷ toList "[31m") ++ (body ++ (fromℕ 27 ∷ toList "[0m")))
paint-red body = refl

paint-yellow : (body : _) → paint Style.ansi Tone.yellow body ≡ ((fromℕ 27 ∷ toList "[33m") ++ (body ++ (fromℕ 27 ∷ toList "[0m")))
paint-yellow body = refl

paint-cyan : (body : _) → paint Style.ansi Tone.cyan body ≡ ((fromℕ 27 ∷ toList "[36m") ++ (body ++ (fromℕ 27 ∷ toList "[0m")))
paint-cyan body = refl

paint-blue : (body : _) → paint Style.ansi Tone.blueBold body ≡ ((fromℕ 27 ∷ toList "[34;1m") ++ (body ++ (fromℕ 27 ∷ toList "[0;22m")))
paint-blue body = refl

paint-bold : (body : _) → paint Style.ansi Tone.bold body ≡ ((fromℕ 27 ∷ toList "[1m") ++ (body ++ (fromℕ 27 ∷ toList "[22m")))
paint-bold body = refl

paint-green : (body : _) → paint Style.ansi Tone.green body ≡ ((fromℕ 27 ∷ toList "[32m") ++ (body ++ (fromℕ 27 ∷ toList "[0m")))
paint-green body = refl

private
  select : {A P : Set} → Dec P → A → A → A
  select (yes p) hit miss = hit
  select (no n) hit miss = miss

  onYes : {A P : Set} → (d : Dec P) → P → {hit miss result : A} → hit ≡ result → select d hit miss ≡ result
  onYes (yes p) witness eq = eq
  onYes (no n) witness eq = ⊥-elim (n witness)

  onNo : {A P : Set} → (d : Dec P) → (P → ⊥) → {hit miss result : A} → miss ≡ result → select d hit miss ≡ result
  onNo (yes p) witness eq = ⊥-elim (witness p)
  onNo (no n) witness eq = eq

  notBelow : {i j : ℕ} → j ≤ i → i < j → ⊥
  notBelow {i} {j} j≤i i<j = <-irrefl refl (≤-trans i<j j≤i)

  getYes : {P : Set} → (d : Dec P) → isYes d ≡ true → P
  getYes (yes p) eq = p
  getYes (no n) ()

  belowDistinct : {n limit k : ℕ} → n < limit → limit ≤ k → n ≢ k
  belowDistinct bound limit≤k refl = notBelow limit≤k bound

  aboveDistinct : {n limit k : ℕ} → limit ≤ n → k < limit → n ≢ k
  aboveDistinct limit≤n bound refl = notBelow limit≤n bound


  decimalPoint : (n : ℕ) → n < 10 → toℕ (fromℕ (n + 48)) ≡ n + 48
  decimalPoint 0 lt = refl
  decimalPoint 1 lt = refl
  decimalPoint 2 lt = refl
  decimalPoint 3 lt = refl
  decimalPoint 4 lt = refl
  decimalPoint 5 lt = refl
  decimalPoint 6 lt = refl
  decimalPoint 7 lt = refl
  decimalPoint 8 lt = refl
  decimalPoint 9 lt = refl
  decimalPoint (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (n))))))))))) lt = ⊥-elim (notBelow (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (z≤n))))))))))) lt)

  upperPoint : (n : ℕ) → n < 16 → toℕ (fromℕ (n + 55)) ≡ n + 55
  upperPoint 0 lt = refl
  upperPoint 1 lt = refl
  upperPoint 2 lt = refl
  upperPoint 3 lt = refl
  upperPoint 4 lt = refl
  upperPoint 5 lt = refl
  upperPoint 6 lt = refl
  upperPoint 7 lt = refl
  upperPoint 8 lt = refl
  upperPoint 9 lt = refl
  upperPoint 10 lt = refl
  upperPoint 11 lt = refl
  upperPoint 12 lt = refl
  upperPoint 13 lt = refl
  upperPoint 14 lt = refl
  upperPoint 15 lt = refl
  upperPoint (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (n))))))))))))))))) lt = ⊥-elim (notBelow (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (z≤n))))))))))))))))) lt)

  lowerPoint : (n : ℕ) → n < 16 → toℕ (fromℕ (n + 87)) ≡ n + 87
  lowerPoint 0 lt = refl
  lowerPoint 1 lt = refl
  lowerPoint 2 lt = refl
  lowerPoint 3 lt = refl
  lowerPoint 4 lt = refl
  lowerPoint 5 lt = refl
  lowerPoint 6 lt = refl
  lowerPoint 7 lt = refl
  lowerPoint 8 lt = refl
  lowerPoint 9 lt = refl
  lowerPoint 10 lt = refl
  lowerPoint 11 lt = refl
  lowerPoint 12 lt = refl
  lowerPoint 13 lt = refl
  lowerPoint 14 lt = refl
  lowerPoint 15 lt = refl
  lowerPoint (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (n))))))))))))))))) lt = ⊥-elim (notBelow (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (z≤n))))))))))))))))) lt)

hexDigit : Quoting → ℕ → Char
hexDigit forwardQuote n = select (n <? 10) (fromℕ (n + 48)) (fromℕ (n + 55))
hexDigit reverseQuote n = select (n <? 10) (fromℕ (n + 48)) (fromℕ (n + 87))

digit-decimal : (q : _) → (n : _) → (n < 10) → toℕ (hexDigit q n) ≡ (n + 48)
digit-decimal forwardQuote n lt = trans (cong toℕ (onYes (n <? 10) lt refl)) (decimalPoint n lt)
digit-decimal reverseQuote n lt = trans (cong toℕ (onYes (n <? 10) lt refl)) (decimalPoint n lt)

digit-uppercase : (n : _) → (10 ≤ n) → (n < 16) → toℕ (hexDigit Quoting.forwardQuote n) ≡ (n + 55)
digit-uppercase n ge lt = trans (cong toℕ (onNo (n <? 10) (notBelow ge) refl)) (upperPoint n lt)

digit-lowercase : (n : _) → (10 ≤ n) → (n < 16) → toℕ (hexDigit Quoting.reverseQuote n) ≡ (n + 87)
digit-lowercase n ge lt = trans (cong toℕ (onNo (n <? 10) (notBelow ge) refl)) (lowerPoint n lt)

escapeCode : Quoting → ℕ → List Char
escapeCode q n =
  '\\' ∷ 'u' ∷ hexDigit q (div-helper 0 4095 n 4095) ∷
  hexDigit q (mod-helper 0 15 (div-helper 0 255 n 255) 15) ∷
  hexDigit q (mod-helper 0 15 (div-helper 0 15 n 15) 15) ∷
  hexDigit q (mod-helper 0 15 n 15) ∷ []

unicode-escape : (q : _) → (n : _) → (n < 65536) → escapeCode q n ≡ ('\\' ∷ ('u' ∷ (hexDigit q (div-helper 0 4095 n 4095) ∷ (hexDigit q (mod-helper 0 15 (div-helper 0 255 n 255) 15) ∷ (hexDigit q (mod-helper 0 15 (div-helper 0 15 n 15) 15) ∷ (hexDigit q (mod-helper 0 15 n 15) ∷ []))))))
unicode-escape q n bound = refl

private
  escapeControl : Quoting → ℕ → List Char
  escapeControl q n =
    select (n ≟ℕ 8) (toList "\\b")
      (select (n ≟ℕ 9) (toList "\\t")
        (select (n ≟ℕ 10) (toList "\\n")
          (select (n ≟ℕ 12) (toList "\\f")
            (select (n ≟ℕ 13) (toList "\\r") (escapeCode q n)))))

  escapeC1 : Quoting → Char → ℕ → List Char
  escapeC1 forwardQuote c n = select (127 ≤? n) (select (n <? 160) (escapeCode forwardQuote n) [ c ]) [ c ]
  escapeC1 reverseQuote c n = [ c ]

  escapeGraphic : Quoting → Char → ℕ → List Char
  escapeGraphic q c n =
    select (n ≟ℕ 34) (toList "\\\"")
      (select (n ≟ℕ 92) (toList "\\\\")
        (select (n ≟ℕ 8232) (escapeCode q n)
          (select (n ≟ℕ 8233) (escapeCode q n) (escapeC1 q c n))))

  escapePoint : Quoting → Char → ℕ → List Char
  escapePoint q c n = select (n <? 32) (escapeControl q n) (escapeGraphic q c n)

  graphicOther : (q : Quoting) → (c : Char) → (n : ℕ) →
    32 ≤ n → n ≢ 34 → n ≢ 92 → n ≢ 8232 → n ≢ 8233 → escapePoint q c n ≡ escapeC1 q c n
  graphicOther q c n ge notQuote notSlash notLine notParagraph =
    onNo (n <? 32) (notBelow ge)
      (onNo (n ≟ℕ 34) notQuote (onNo (n ≟ℕ 92) notSlash
        (onNo (n ≟ℕ 8232) notLine (onNo (n ≟ℕ 8233) notParagraph refl))))

escapeChar : Quoting → Char → List Char
escapeChar q c = escapePoint q c (toℕ c)

escape-quote : (q : _) → escapeChar q '\"' ≡ toList "\\\""
escape-quote q = refl

escape-backslash : (q : _) → escapeChar q '\\' ≡ toList "\\\\"
escape-backslash q = refl

escape-backspace : (q : _) → escapeChar q (fromℕ 8) ≡ toList "\\b"
escape-backspace q = refl

escape-tab : (q : _) → escapeChar q (fromℕ 9) ≡ toList "\\t"
escape-tab q = refl

escape-newline : (q : _) → escapeChar q '\n' ≡ toList "\\n"
escape-newline q = refl

escape-formfeed : (q : _) → escapeChar q (fromℕ 12) ≡ toList "\\f"
escape-formfeed q = refl

escape-return : (q : _) → escapeChar q (fromℕ 13) ≡ toList "\\r"
escape-return q = refl

escape-c0 : (q : _) → (c : _) → (toℕ c < 32) → (toℕ c ≢ 8) → (toℕ c ≢ 9) → (toℕ c ≢ 10) → (toℕ c ≢ 12) → (toℕ c ≢ 13) → escapeChar q c ≡ escapeCode q (toℕ c)
escape-c0 q c lt notBS notTab notLF notFF notCR =
  onYes (toℕ c <? 32) lt
    (onNo (toℕ c ≟ℕ 8) notBS (onNo (toℕ c ≟ℕ 9) notTab
      (onNo (toℕ c ≟ℕ 10) notLF (onNo (toℕ c ≟ℕ 12) notFF (onNo (toℕ c ≟ℕ 13) notCR refl)))))

escape-forward-c1 : (c : _) → (127 ≤ toℕ c) → (toℕ c < 160) → escapeChar Quoting.forwardQuote c ≡ escapeCode Quoting.forwardQuote (toℕ c)
escape-forward-c1 c ge lt =
  trans
    (graphicOther forwardQuote c (toℕ c) (≤-trans (getYes (32 ≤? 127) refl) ge)
      (aboveDistinct ge (getYes (34 <? 127) refl)) (aboveDistinct ge (getYes (92 <? 127) refl))
      (belowDistinct lt (getYes (160 ≤? 8232) refl)) (belowDistinct lt (getYes (160 ≤? 8233) refl)))
    (onYes (127 ≤? toℕ c) ge (onYes (toℕ c <? 160) lt refl))

escape-line-separator : (q : _) → (c : _) → (toℕ c ≡ 8232) → escapeChar q c ≡ escapeCode q (toℕ c)
escape-line-separator q c eq =
  trans (cong (escapePoint q c) eq) (cong (escapeCode q) (sym eq))

escape-paragraph-separator : (q : _) → (c : _) → (toℕ c ≡ 8233) → escapeChar q c ≡ escapeCode q (toℕ c)
escape-paragraph-separator q c eq =
  trans (cong (escapePoint q c) eq) (cong (escapeCode q) (sym eq))

escape-forward-ascii : (c : _) → (32 ≤ toℕ c) → (toℕ c < 127) → (toℕ c ≢ 34) → (toℕ c ≢ 92) → escapeChar Quoting.forwardQuote c ≡ ([ c ])
escape-forward-ascii c ge lt notQuote notSlash =
  trans
    (graphicOther forwardQuote c (toℕ c) ge notQuote notSlash
      (belowDistinct lt (getYes (127 ≤? 8232) refl)) (belowDistinct lt (getYes (127 ≤? 8233) refl)))
    (onNo (127 ≤? toℕ c) (λ lower → notBelow lower lt) refl)

escape-forward-unicode : (c : _) → (160 ≤ toℕ c) → (toℕ c ≢ 8232) → (toℕ c ≢ 8233) → escapeChar Quoting.forwardQuote c ≡ ([ c ])
escape-forward-unicode c ge notLine notParagraph =
  trans
    (graphicOther forwardQuote c (toℕ c) (≤-trans (getYes (32 ≤? 160) refl) ge)
      (aboveDistinct ge (getYes (34 <? 160) refl)) (aboveDistinct ge (getYes (92 <? 160) refl))
      notLine notParagraph)
    (onYes (127 ≤? toℕ c) (≤-trans (getYes (127 ≤? 160) refl) ge) (onNo (toℕ c <? 160) (notBelow ge) refl))

escape-reverse-literal : (c : _) → (32 ≤ toℕ c) → (toℕ c ≢ 34) → (toℕ c ≢ 92) → (toℕ c ≢ 8232) → (toℕ c ≢ 8233) → escapeChar Quoting.reverseQuote c ≡ ([ c ])
escape-reverse-literal c ge notQuote notSlash notLine notParagraph =
  graphicOther reverseQuote c (toℕ c) ge notQuote notSlash notLine notParagraph

escapeBody : Quoting → List Char → List Char
escapeBody q [] = []
escapeBody q (c ∷ cs) = escapeChar q c ++ escapeBody q cs

quoted : Quoting → List Char → List Char
quoted q cs = '\"' ∷ (escapeBody q cs ++ [ '\"' ])

escape-empty : (q : _) → escapeBody q [] ≡ []
escape-empty q = refl

escape-cons : (q : _) → (c : _) → (cs : _) → escapeBody q (c ∷ cs) ≡ (escapeChar q c ++ escapeBody q cs)
escape-cons q c cs = refl

quote-body : (q : _) → (cs : _) → quoted q cs ≡ ('\"' ∷ (escapeBody q cs ++ ([ '\"' ])))
quote-body q cs = refl

private
  eitherFlag : Bool → Bool → Bool
  eitherFlag true b = true
  eitherFlag false b = b

  selectOrTrue : {P : Set} → (d : Dec P) → {b : Bool} → b ≡ true → select d true b ≡ true
  selectOrTrue (yes p) eq = refl
  selectOrTrue (no n) eq = eq

  eitherRight : (a b : Bool) → b ≡ true → eitherFlag a b ≡ true
  eitherRight true b eq = refl
  eitherRight false b eq = eq

  notTrue : {b : Bool} → b ≡ false → b ≢ true
  notTrue refl ()

  whenTrue : (b : Bool) → Dec (b ≡ true)
  whenTrue true = yes refl
  whenTrue false = no (notTrue refl)

  selectEither : {A P : Set} → (d : Dec P) → {hit miss result : A} → hit ≡ result → miss ≡ result → select d hit miss ≡ result
  selectEither (yes p) hit miss = hit
  selectEither (no n) hit miss = miss

  inRange : ℕ → ℕ → ℕ → Bool
  inRange n low high = select (low ≤? n) (select (n <? high) true false) false

  rangeHit : (n low high : ℕ) → low ≤ n → n < high → inRange n low high ≡ true
  rangeHit n low high ge lt = onYes (low ≤? n) ge (onYes (n <? high) lt refl)

  rangeUpperMiss : {P Q : Set} → (lo : Dec P) → (hi : Dec Q) → (Q → ⊥) → select lo (select hi true false) false ≡ false
  rangeUpperMiss (yes p) hi neg = onNo hi neg refl
  rangeUpperMiss (no n) hi neg = refl

  rangeMiss : (n low high : ℕ) → (n < low ⊎ high ≤ n) → inRange n low high ≡ false
  rangeMiss n low high (inj₁ lt) = onNo (low ≤? n) (λ ge → notBelow ge lt) refl
  rangeMiss n low high (inj₂ ge) = rangeUpperMiss (low ≤? n) (n <? high) (notBelow ge)

  -- The tables are ordered, inclusive endpoint pairs for non-ASCII Unicode
  -- general categories. The first covers L and Nl. The second adds ranges
  -- for Mn, Mc, Nd and Pc when checking characters after the first.
  inUnicodeTable : ℕ → List Char → Bool
  inUnicodeTable n [] = false
  inUnicodeTable n (lo ∷ []) = false
  inUnicodeTable n (lo ∷ hi ∷ ranges) =
    select (n <? toℕ lo) false (select (toℕ hi <? n) (inUnicodeTable n ranges) true)

  nonAsciiStart : ℕ → Bool
  nonAsciiStart n = select (n <? 128) false (inUnicodeTable n (
    toList "ªªµµººÀÖØöøˁˆˑˠˤˬˬˮˮͰʹͶͷͺͽͿͿΆΆΈΊΌΌΎΡΣϵϷҁҊԯԱՖՙՙՠֈאתׯײؠيٮٯ" ++
    toList "ٱۓەەۥۦۮۯۺۼۿۿܐܐܒܯݍޥޱޱߊߪߴߵߺߺࠀࠕࠚࠚࠤࠤࠨࠨࡀࡘࡠࡪࡰࢇࢉ࢏ࢠࣉऄहऽऽॐॐक़ॡॱঀঅঌ" ++
    toList "এঐওনপরললশহঽঽৎৎড়ঢ়য়ৡৰৱৼৼਅਊਏਐਓਨਪਰਲਲ਼ਵਸ਼ਸਹਖ਼ੜਫ਼ਫ਼ੲੴઅઍએઑઓનપરલળવહઽઽ" ++
    toList "ૐૐૠૡૹૹଅଌଏଐଓନପରଲଳଵହଽଽଡ଼ଢ଼ୟୡୱୱஃஃஅஊஎஐஒகஙசஜஜஞடணதநபமஹௐௐఅఌఎఐఒనపహ" ++
    toList "ఽఽౘౚ౜ౝౠౡಀಀಅಌಎಐಒನಪಳವಹಽಽ೜ೞೠೡೱೲഄഌഎഐഒഺഽഽൎൎൔൖൟൡൺൿඅඖකනඳරලලවෆกะ" ++
    toList "าำเๆກຂຄຄຆຊຌຣລລວະາຳຽຽເໄໆໆໜໟༀༀཀཇཉཬྈྌကဪဿဿၐၕၚၝၡၡၥၦၮၰၵႁႎႎႠჅჇჇ" ++
