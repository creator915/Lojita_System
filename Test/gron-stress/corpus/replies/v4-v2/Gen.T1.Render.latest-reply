  nonAsciiRest : ℕ → Bool
  nonAsciiRest n = select (n <? 128) false (inUnicodeTable n (
    toList "ׇׇֽֿֿׁׂًؚ֑ׅ̀ͯ҃҇ׄؐ٩ٰٰ۪ۭۖۜ۟ۤۧۨ۰۹ܑܑܰ݊ަް߀߉߽߽࡙࡛߫߳ࠖ࠙ࠛࠣࠥࠧࠩ࠭ࢗ࢟࣊࣡" ++
    toList "ࣣःऺ़ाॏ॑ॗॢॣ०९ঁঃ়়াৄেৈো্ৗৗৢৣ০৯৾৾ਁਃ਼਼ਾੂੇੈੋ੍ੑੑ੦ੱੵੵઁઃ઼઼ાૅેૉો્" ++
