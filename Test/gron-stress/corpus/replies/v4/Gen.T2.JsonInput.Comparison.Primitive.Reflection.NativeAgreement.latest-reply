(submission (kind plan)
  (why "子包负责证明原生比较的可靠性与完备性，本模块用同一个判定引理推出字符和字符串的布尔结果一致。")
  (main @main)
  (subspecs
    ("Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws" @native-laws))
  (moves
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.agree"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.char-sound"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.char-complete"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.string-sound"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.string-complete"))))
```agda main
module Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement where

open import Agda.Builtin.Char using (primCharEquality)
open import Agda.Builtin.String using (primStringEquality)
open import Data.Bool using (Bool; true; false)
open import Data.Char using (Char)
open import Data.Empty using (⊥-elim)
open import Data.String using (String)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Relation.Nullary using (Dec; does; yes; no)
import Data.Char as Char using (_≟_)
import Data.String as String using (_≟_)
import Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws as Native

private
  agree : {P : Set} (b : Bool) (d : Dec P) → (b ≡ true → P) → (P → b ≡ true) → b ≡ does d
  agree b (yes p) _ complete = complete p
  agree false (no _) _ _ = refl
  agree true (no reject) sound _ = ⊥-elim (reject (sound refl))

char-agrees : (c d : Char) → primCharEquality c d ≡ does (c Char.≟ d)
char-agrees c d = agree (primCharEquality c d) (c Char.≟ d) (Native.char-sound c d) (Native.char-complete c d)

string-agrees : (s t : String) → primStringEquality s t ≡ does (s String.≟ t)
string-agrees s t = agree (primStringEquality s t) (s String.≟ t) (Native.string-sound s t) (Native.string-complete s t)

```

```agda native-laws
module Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws where

open import Agda.Builtin.Char using (primCharEquality)
open import Agda.Builtin.String using (primStringEquality)
open import Data.Bool using (true)
open import Data.Char using (Char)
open import Data.String using (String)
open import Relation.Binary.PropositionalEquality using (_≡_)

postulate
  char-sound : (c d : Char) → primCharEquality c d ≡ true → c ≡ d
  char-complete : (c d : Char) → c ≡ d → primCharEquality c d ≡ true
  string-sound : (s t : String) → primStringEquality s t ≡ true → s ≡ t
  string-complete : (s t : String) → s ≡ t → primStringEquality s t ≡ true

```
