identifierHead : Char → Bool
identifierHead c = if toℕ c <ᵇ 128 then
  (((64 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 91)) ∨ (((96 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 123)) ∨ ((toℕ c ≡ᵇ 36) ∨ (toℕ c ≡ᵇ 95))))
  else inIdentifierRange false (toℕ c) ranges

asciiHead : ∀ c → (toℕ c <ᵇ 128) ≡ true → identifierHead c ≡
  (((64 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 91)) ∨ (((96 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 123)) ∨ ((toℕ c ≡ᵇ 36) ∨ (toℕ c ≡ᵇ 95))))
asciiHead c ascii rewrite ascii = refl

identifierTail : Char → Bool
identifierTail c = if toℕ c <ᵇ 128 then
  (identifierHead c ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58)))
  else inIdentifierRange true (toℕ c) ranges

asciiTail : ∀ c → (toℕ c <ᵇ 128) ≡ true → identifierTail c ≡ (identifierHead c ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58)))
asciiTail c ascii rewrite ascii = refl

tailLetters : List Char → Bool
tailLetters [] = true
tailLetters (c ∷ cs) = identifierTail c ∧ tailLetters cs

emptyTail : tailLetters [] ≡ true
emptyTail = refl

letterTail : ∀ c cs → tailLetters (c ∷ cs) ≡ (identifierTail c ∧ tailLetters cs)
letterTail c cs = refl

identifierLetters : List Char → Bool
identifierLetters [] = false
identifierLetters (c ∷ cs) = identifierHead c ∧ tailLetters cs

emptyName : identifierLetters [] ≡ false
emptyName = refl

nonemptyName : ∀ c cs → identifierLetters (c ∷ cs) ≡ (identifierHead c ∧ tailLetters cs)
nonemptyName c cs = refl

reservedWords : List String
reservedWords =
  "break" ∷ "case" ∷ "catch" ∷ "class" ∷ "const" ∷ "continue" ∷ "debugger" ∷
  "default" ∷ "delete" ∷ "do" ∷ "else" ∷ "export" ∷ "extends" ∷ "false" ∷
  "finally" ∷ "for" ∷ "function" ∷ "if" ∷ "import" ∷ "in" ∷ "instanceof" ∷
  "new" ∷ "null" ∷ "return" ∷ "super" ∷ "switch" ∷ "this" ∷ "throw" ∷
  "true" ∷ "try" ∷ "typeof" ∷ "var" ∷ "void" ∷ "while" ∷ "with" ∷ "yield" ∷ []

keywordVocabulary : reservedWords ≡
  ("break" ∷ "case" ∷ "catch" ∷ "class" ∷ "const" ∷ "continue" ∷ "debugger" ∷
   "default" ∷ "delete" ∷ "do" ∷ "else" ∷ "export" ∷ "extends" ∷ "false" ∷
   "finally" ∷ "for" ∷ "function" ∷ "if" ∷ "import" ∷ "in" ∷ "instanceof" ∷
   "new" ∷ "null" ∷ "return" ∷ "super" ∷ "switch" ∷ "this" ∷ "throw" ∷
   "true" ∷ "try" ∷ "typeof" ∷ "var" ∷ "void" ∷ "while" ∷ "with" ∷ "yield" ∷ [])
keywordVocabulary = refl

bareName : String → Bool
bareName s = identifierLetters (toList s) ∧ not (any (primStringEquality s) reservedWords)

unreservedName : ∀ s → bareName s ≡ (identifierLetters (toList s) ∧ not (any (primStringEquality s) reservedWords))
unreservedName s = refl

startFixture : map bareName ("Ǆ" ∷ "ǅ" ∷ "ǆ" ∷ "ʰ" ∷ "中" ∷ "Ⅻ" ∷ "²" ∷ "٢" ∷ "℘" ∷ []) ≡
  (true ∷ false ∷ true ∷ true ∷ true ∷ true ∷ false ∷ false ∷ false ∷ [])
startFixture = refl

tailFixture : map bareName ("á" ∷ "aः" ∷ "a٢" ∷ "a‿" ∷ "a＿" ∷ "a²" ∷ "a҈" ∷ "aǅ" ∷ "a‍" ∷ []) ≡
  (true ∷ true ∷ true ∷ true ∷ true ∷ false ∷ false ∷ false ∷ false ∷ [])
tailFixture = refl

access : Bool → B.Step → String
access c (B.fieldName k) =
  if bareName k then ("." ++ˢ B.tint c B.identifier k) else
    (B.tint c B.delimiter "[" ++ˢ (B.tint c B.stringToken (stringLiteral gronEscapes k) ++ˢ B.tint c B.delimiter "]"))
access c (B.index n) =
  B.tint c B.delimiter "[" ++ˢ (B.tint c B.numberToken (show n) ++ˢ B.tint c B.delimiter "]")

fieldAccess : ∀ c k → access c (B.fieldName k) ≡
  (if bareName k then ("." ++ˢ B.tint c B.identifier k) else
    (B.tint c B.delimiter "[" ++ˢ (B.tint c B.stringToken (stringLiteral gronEscapes k) ++ˢ B.tint c B.delimiter "]")))
fieldAccess c k = refl

indexAccess : ∀ c n → access c (B.index n) ≡
  (B.tint c B.delimiter "[" ++ˢ (B.tint c B.numberToken (show n) ++ˢ B.tint c B.delimiter "]"))
indexAccess c n = refl

accessSuffix : Bool → List B.Step → String
accessSuffix c [] = ""
accessSuffix c (x ∷ xs) = access c x ++ˢ accessSuffix c xs

emptySuffix : ∀ c → accessSuffix c [] ≡ ""
emptySuffix c = refl

extendSuffix : ∀ c x xs → accessSuffix c (x ∷ xs) ≡ (access c x ++ˢ accessSuffix c xs)
extendSuffix c x xs = refl

assignmentPath : Bool → List B.Step → String
assignmentPath c xs = B.tint c B.identifier "json" ++ˢ accessSuffix c xs

assignmentRoot : ∀ c xs → assignmentPath c xs ≡ (B.tint c B.identifier "json" ++ˢ accessSuffix c xs)
assignmentRoot c xs = refl

pairComponent : Bool → B.Step → String
pairComponent c (B.fieldName k) = B.tint c B.stringToken (stringLiteral gronEscapes k)
pairComponent c (B.index n) = B.tint c B.numberToken (show n)

pairField : ∀ c k → pairComponent c (B.fieldName k) ≡ B.tint c B.stringToken (stringLiteral gronEscapes k)
pairField c k = refl

pairIndex : ∀ c n → pairComponent c (B.index n) ≡ B.tint c B.numberToken (show n)
pairIndex c n = refl

pairComponents : Bool → List B.Step → String
pairComponents c [] = ""
pairComponents c (x ∷ []) = pairComponent c x
pairComponents c (x ∷ y ∷ ys) = pairComponent c x ++ˢ ("," ++ˢ pairComponents c (y ∷ ys))

emptyPairPath : ∀ c → pairComponents c [] ≡ ""
emptyPairPath c = refl

onePairStep : ∀ c x → pairComponents c [ x ] ≡ pairComponent c x
onePairStep c x = refl

addPairStep : ∀ c x y ys → pairComponents c (x ∷ y ∷ ys) ≡
  (pairComponent c x ++ˢ ("," ++ˢ pairComponents c (y ∷ ys)))
addPairStep c x y ys = refl

bindingValueText : Bool → B.BindingValue → String
bindingValueText c B.objectMarker = B.tint c B.delimiter "{}"
bindingValueText c B.arrayMarker = B.tint c B.delimiter "[]"
bindingValueText c (B.literal B.null) = B.tint c B.keyword "null"
bindingValueText c (B.literal (B.boolean true)) = B.tint c B.keyword "true"
bindingValueText c (B.literal (B.boolean false)) = B.tint c B.keyword "false"
bindingValueText c (B.literal (B.number s)) = B.tint c B.numberToken s
bindingValueText c (B.literal (B.text s)) = B.tint c B.stringToken (stringLiteral gronEscapes s)

objectText : ∀ c → bindingValueText c B.objectMarker ≡ B.tint c B.delimiter "{}"
objectText c = refl

arrayText : ∀ c → bindingValueText c B.arrayMarker ≡ B.tint c B.delimiter "[]"
arrayText c = refl

nullText : ∀ c → bindingValueText c (B.literal B.null) ≡ B.tint c B.keyword "null"
nullText c = refl

trueText : ∀ c → bindingValueText c (B.literal (B.boolean true)) ≡ B.tint c B.keyword "true"
trueText c = refl

falseText : ∀ c → bindingValueText c (B.literal (B.boolean false)) ≡ B.tint c B.keyword "false"
falseText c = refl

numericText : ∀ c s → bindingValueText c (B.literal (B.number s)) ≡ B.tint c B.numberToken s
numericText c s = refl

quotedText : ∀ c s → bindingValueText c (B.literal (B.text s)) ≡ B.tint c B.stringToken (stringLiteral gronEscapes s)
quotedText c s = refl

renderBinding : Style → B.Binding → String
renderBinding (styled assignments c) (B.binding p v) =
  assignmentPath c p ++ˢ (" = " ++ˢ (bindingValueText c v ++ˢ ";\n"))
renderBinding (styled pathPairs c) (B.binding p v) =
  B.tint c B.delimiter "[" ++ˢ (B.tint c B.delimiter "[" ++ˢ
    (pairComponents c p ++ˢ (B.tint c B.delimiter "]" ++ˢ
      ("," ++ˢ (bindingValueText c v ++ˢ (B.tint c B.delimiter "]" ++ˢ "\n"))))))

assignmentLine : ∀ c p v → renderBinding (styled assignments c) (B.binding p v) ≡
  (assignmentPath c p ++ˢ (" = " ++ˢ (bindingValueText c v ++ˢ ";\n")))
assignmentLine c p v = refl

pairLine : ∀ c p v → renderBinding (styled pathPairs c) (B.binding p v) ≡
  (B.tint c B.delimiter "[" ++ˢ (B.tint c B.delimiter "[" ++ˢ
    (pairComponents c p ++ˢ (B.tint c B.delimiter "]" ++ˢ
      ("," ++ˢ (bindingValueText c v ++ˢ (B.tint c B.delimiter "]" ++ˢ "\n")))))))
pairLine c p v = refl

renderBindings : Style → List B.Binding → String
renderBindings s [] = ""
renderBindings s (x ∷ xs) = renderBinding s x ++ˢ renderBindings s xs

noLines : ∀ s → renderBindings s [] ≡ ""
noLines s = refl

nextLine : ∀ s x xs → renderBindings s (x ∷ xs) ≡ (renderBinding s x ++ˢ renderBindings s xs)
nextLine s x xs = refl

traversal : Bool → B.Traversal
traversal true = B.enumerated
traversal false = B.byAccess (λ k → access false (B.fieldName k))

unsorted : traversal true ≡ B.enumerated
unsorted = refl

sorted : traversal false ≡ B.byAccess (λ k → access false (B.fieldName k))
sorted = refl

projectTraversal : ForwardOptions → B.Traversal
projectTraversal opts = traversal (ForwardOptions.noSort opts)

projectEmission : B.Reply Emission → B.Reply (List B.Binding)
projectEmission (B.reply n (emission bs _) err) = B.reply n bs err

optionsPort : PortLift B.Traversal ForwardOptions
optionsPort = portLift projectTraversal

emissionPort : PortLift (B.Reply (List B.Binding)) (B.Reply Emission)
emissionPort = portLift projectEmission

renderReply : Style → B.Reply (List B.Binding) → B.Reply Emission
renderReply s (B.reply n bs err) = B.reply n (emission bs (renderBindings s bs)) err

endingForward : ∀ s n bs err → renderReply s (B.reply n bs err) ≡ B.reply n (emission bs (renderBindings s bs)) err
endingForward s n bs err = refl

forwardWire : ForwardOptions → B.Parsed B.Value → B.Reply Emission
forwardWire o d = renderReply (ForwardOptions.style o) (B.forward (projectTraversal o) d)

streamWire : ForwardOptions → List B.Value → Maybe String → B.Reply Emission
streamWire o ds e = renderReply (ForwardOptions.style o) (B.forwardStream (projectTraversal o) ds e)

forwardWireLaw : ∀ o d → forwardWire o d ≡ renderReply (ForwardOptions.style o) (B.forward (projectTraversal o) d)
forwardWireLaw o d = refl

streamWireLaw : ∀ o ds e → streamWire o ds e ≡ renderReply (ForwardOptions.style o) (B.forwardStream (projectTraversal o) ds e)
streamWireLaw o ds e = refl

forwardSquare : Commutes₂ optionsPort (keepPort (B.Parsed B.Value)) emissionPort (λ _ _ → ⊤) _≡_ B.forward forwardWire
forwardSquare o (B.parsed v) _ = refl
forwardSquare o (B.rejected msg) _ = refl

escapedKeyOrderFixture : B.earlier (toList (access false (B.fieldName " ")))
  (toList (access false (B.fieldName (fromList (primNatToChar 11 ∷ []))))) ≡ true
escapedKeyOrderFixture = refl

assignmentBracketFixture : renderBinding (styled assignments false)
  (B.binding (B.fieldName "a-" ∷ []) B.arrayMarker) ≡ "json[\"a-\"] = [];\n"
assignmentBracketFixture = refl

pairBracketFixture : renderBinding (styled pathPairs false)
  (B.binding (B.fieldName "a-" ∷ []) B.arrayMarker) ≡ "[[\"a-\"],[]]\n"
pairBracketFixture = refl

partialOutputFixture : streamWire (forwardOptions (styled assignments false) false)
  (B.scalar (B.number "1") ∷ []) (just "unexpected EOF") ≡
  B.reply 3 (emission (B.binding [] B.arrayMarker ∷ B.binding (B.index 0 ∷ []) (B.literal (B.number "1")) ∷ [])
    "json = [];\njson[0] = 1;\n") "failed to form statements: unexpected EOF\n"
partialOutputFixture = refl

indentation : ℕ → String
indentation n = fromList (replicate (2 * n) ' ')

twoSpaceIndent : ∀ n → indentation n ≡ fromList (replicate (2 * n) ' ')
twoSpaceIndent n = refl

leadJSON : Bool → ℕ → String
leadJSON false n = indentation n
leadJSON true n = ""

plainLead : ∀ n → leadJSON false n ≡ indentation n
plainLead n = refl

colourLead : ∀ n → leadJSON true n ≡ ""
colourLead n = refl

joinJSON : Bool → List String → String
joinJSON c [] = ""
joinJSON c (x ∷ []) = x
joinJSON false (x ∷ y ∷ ys) = x ++ˢ (",\n" ++ˢ joinJSON false (y ∷ ys))
joinJSON true (x ∷ y ∷ ys) = x ++ˢ (B.tint true B.colon "," ++ˢ joinJSON true (y ∷ ys))

noJSONRows : ∀ c → joinJSON c [] ≡ ""
noJSONRows c = refl

oneJSONRow : ∀ c x → joinJSON c [ x ] ≡ x
oneJSONRow c x = refl

plainJSONRows : ∀ x y ys → joinJSON false (x ∷ y ∷ ys) ≡ (x ++ˢ (",\n" ++ˢ joinJSON false (y ∷ ys)))
plainJSONRows x y ys = refl

colourJSONRows : ∀ x y ys → joinJSON true (x ∷ y ∷ ys) ≡
  (x ++ˢ (B.tint true B.colon "," ++ˢ joinJSON true (y ∷ ys)))
colourJSONRows x y ys = refl

surroundJSON : Bool → ℕ → String → String → List String → String
surroundJSON false n left right [] = left ++ˢ right
surroundJSON false n left right (x ∷ xs) =
  left ++ˢ ("\n" ++ˢ (joinJSON false (x ∷ xs) ++ˢ ("\n" ++ˢ (indentation n ++ˢ right))))
surroundJSON true n left right xs =
  B.tint true B.delimiter left ++ˢ (joinJSON true xs ++ˢ B.tint true B.delimiter right)

plainEmptyJSON : ∀ n left right → surroundJSON false n left right [] ≡ (left ++ˢ right)
plainEmptyJSON n left right = refl

plainNestedJSON : ∀ n left right x xs → surroundJSON false n left right (x ∷ xs) ≡
  (left ++ˢ ("\n" ++ˢ (joinJSON false (x ∷ xs) ++ˢ ("\n" ++ˢ (indentation n ++ˢ right)))))
plainNestedJSON n left right x xs = refl

colourSurroundJSON : ∀ n left right xs → surroundJSON true n left right xs ≡
  (B.tint true B.delimiter left ++ˢ (joinJSON true xs ++ˢ B.tint true B.delimiter right))
colourSurroundJSON n left right xs = refl

jsonKey : Bool → String → String
jsonKey false k = stringLiteral jsonEscapes k
jsonKey true k = B.tint true B.identifier "\"" ++ˢ
  (B.tint true B.identifier (escapedChars jsonEscapes (toList k)) ++ˢ B.tint true B.identifier "\"")

plainKey : ∀ k → jsonKey false k ≡ stringLiteral jsonEscapes k
plainKey k = refl

colourKey : ∀ k → jsonKey true k ≡ (B.tint true B.identifier "\"" ++ˢ
  (B.tint true B.identifier (escapedChars jsonEscapes (toList k)) ++ˢ B.tint true B.identifier "\""))
colourKey k = refl

memberColon : Bool → String
memberColon false = ": "
memberColon true = B.tint true B.colon ":"

plainMemberColon : memberColon false ≡ ": "
plainMemberColon = refl

colourMemberColon : memberColon true ≡ B.tint true B.colon ":"
colourMemberColon = refl

valueQuote : String
valueQuote = B.ansiEscape ++ˢ ("[32m\"" ++ˢ (B.ansiEscape ++ˢ "[0m"))

greenQuote : valueQuote ≡ (B.ansiEscape ++ˢ ("[32m\"" ++ˢ (B.ansiEscape ++ˢ "[0m")))
greenQuote = refl

jsonAtom : Bool → B.Atom → String
jsonAtom c B.null = B.tint c B.keyword "null"
jsonAtom c (B.boolean true) = B.tint c B.keyword "true"
jsonAtom c (B.boolean false) = B.tint c B.keyword "false"
jsonAtom c (B.number s) = B.tint c B.numberToken s
jsonAtom false (B.text s) = stringLiteral jsonEscapes s
jsonAtom true (B.text s) = valueQuote ++ˢ (B.tint true B.stringToken (escapedChars jsonEscapes (toList s)) ++ˢ valueQuote)

plainJSONString : ∀ s → jsonAtom false (B.text s) ≡ stringLiteral jsonEscapes s
plainJSONString s = refl

colourJSONString : ∀ s → jsonAtom true (B.text s) ≡
  (valueQuote ++ˢ (B.tint true B.stringToken (escapedChars jsonEscapes (toList s)) ++ˢ valueQuote))
colourJSONString s = refl

jsonNull : ∀ c → jsonAtom c B.null ≡ B.tint c B.keyword "null"
jsonNull c = refl

jsonTrue : ∀ c → jsonAtom c (B.boolean true) ≡ B.tint c B.keyword "true"
jsonTrue c = refl

jsonFalse : ∀ c → jsonAtom c (B.boolean false) ≡ B.tint c B.keyword "false"
jsonFalse c = refl

jsonNumber : ∀ c s → jsonAtom c (B.number s) ≡ B.tint c B.numberToken s
jsonNumber c s = refl

renderJSONItems : Bool → ℕ → List B.Value → List String
renderJSONMembers : Bool → ℕ → List (String × B.Value) → List (String × String)
renderJSONAt : Bool → ℕ → B.Value → String

renderJSONItems c n [] = []
renderJSONItems c n (v ∷ vs) = (leadJSON c n ++ˢ renderJSONAt c n v) ∷ renderJSONItems c n vs

renderJSONMembers c n [] = []
renderJSONMembers c n ((k , v) ∷ fs) =
  (k , (leadJSON c n ++ˢ (jsonKey c k ++ˢ (memberColon c ++ˢ renderJSONAt c n v)))) ∷ renderJSONMembers c n fs

renderJSONAt c n (B.scalar a) = jsonAtom c a
renderJSONAt c n (B.array vs) = surroundJSON c n "[" "]" (renderJSONItems c (suc n) vs)
renderJSONAt c n (B.object fs) =
  surroundJSON c n "{" "}" (map proj₂ (B.orderMembers (B.byAccess (λ k → k)) (renderJSONMembers c (suc n) fs)))

scalarJSON : ∀ c n a → renderJSONAt c n (B.scalar a) ≡ jsonAtom c a
scalarJSON c n a = refl

arrayJSON : ∀ c n vs → renderJSONAt c n (B.array vs) ≡ surroundJSON c n "[" "]" (renderJSONItems c (suc n) vs)
arrayJSON c n vs = refl

objectJSON : ∀ c n fs → renderJSONAt c n (B.object fs) ≡
  surroundJSON c n "{" "}" (map proj₂ (B.orderMembers (B.byAccess (λ k → k)) (renderJSONMembers c (suc n) fs)))
objectJSON c n fs = refl

noJSONItems : ∀ c n → renderJSONItems c n [] ≡ []
noJSONItems c n = refl

nextJSONItem : ∀ c n v vs → renderJSONItems c n (v ∷ vs) ≡
  ((leadJSON c n ++ˢ renderJSONAt c n v) ∷ renderJSONItems c n vs)
nextJSONItem c n v vs = refl

noJSONMembers : ∀ c n → renderJSONMembers c n [] ≡ []
noJSONMembers c n = refl

nextJSONMember : ∀ c n k v fs → renderJSONMembers c n ((k , v) ∷ fs) ≡
  ((k , (leadJSON c n ++ˢ (jsonKey c k ++ˢ (memberColon c ++ˢ renderJSONAt c n v)))) ∷ renderJSONMembers c n fs)
nextJSONMember c n k v fs = refl

reverseWire : Bool → B.Reply (Maybe B.Value) → B.Reply String
reverseWire c (B.reply n (just v) e) = B.reply n (renderJSONAt c 0 v ++ˢ "\n") e
reverseWire c (B.reply n nothing e) = B.reply n "" e

reverseBody : ∀ c n v e → reverseWire c (B.reply n (just v) e) ≡ B.reply n (renderJSONAt c 0 v ++ˢ "\n") e
reverseBody c n v e = refl

reverseNoBody : ∀ c n e → reverseWire c (B.reply n nothing e) ≡ B.reply n "" e
reverseNoBody c n e = refl

sparseJSONFixture : reverseWire false
  (B.reply 0 (just (B.object (("a" , B.array (B.scalar B.null ∷ B.scalar B.null ∷ B.scalar (B.number "3") ∷ [])) ∷ []))) "") ≡
  B.reply 0 "{\n  \"a\": [\n    null,\n    null,\n    3\n  ]\n}\n" ""
sparseJSONFixture = refl

colouredEmptyFixture : reverseWire true (B.reply 0 (just (B.scalar (B.text ""))) "") ≡
  B.reply 0 (B.ansiEscape ++ˢ ("[32m\"" ++ˢ (B.ansiEscape ++ˢ ("[0m" ++ˢ (B.ansiEscape ++ˢ
    ("[33m" ++ˢ (B.ansiEscape ++ˢ ("[0m" ++ˢ (B.ansiEscape ++ˢ ("[32m\"" ++ˢ (B.ansiEscape ++ˢ "[0m\n"))))))))))) ""
colouredEmptyFixture = refl

```
