(submission (kind plan)
  (why "属性名判定采用沙箱的 Unicode 类别数据，正反向各按规约渲染，正向投影保留底层绑定、退出状态和诊断。")
  (main @main)
  (moves
    (move bot (unit "Gen.T1.Wire.shortEscapes"))
    (move bot (unit "Gen.T1.Wire.lookupShort"))
    (move bot (unit "Gen.T1.Wire.lookupShortAbsent"))
    (move bot (unit "Gen.T1.Wire.IdentifierRanges"))
    (move bot (unit "Gen.T1.Wire.inIdentifierRange"))
    (move bot (unit "Gen.T1.Wire.ranges"))))
```agda main
module Gen.T1.Wire where

open import Agda.Builtin.Char using (primCharEquality; primNatToChar)
open import Agda.Builtin.String using (primStringEquality)
open import Data.Bool using (Bool; false; true; _∧_; _∨_; not; if_then_else_)
open import Data.Char using (Char; toℕ)
open import Data.List using (List; []; _∷_; [_]; any; map; replicate)
open import Data.Maybe using (Maybe; just; nothing)
open import Data.Nat using (ℕ; suc; _+_; _∸_; _*_; _<ᵇ_; _≡ᵇ_)
open import Data.Nat.DivMod using (_/_; _%_)
open import Data.Nat.Show using (show)
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Data.String using (String; toList; fromList) renaming (_++_ to _++ˢ_)
open import Data.Unit using (⊤)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Context.Blueprint using (PortLift; portLift; keepPort; Commutes₂)
import Gen.T0.Gron as B

data Encoding : Set where
  assignments pathPairs : Encoding

data StringSyntax : Set where
  gronEscapes jsonEscapes : StringSyntax

record Style : Set where
  constructor styled
  field
    encoding : Encoding
    colour : Bool

record ForwardOptions : Set where
  constructor forwardOptions
  field
    style : Style
    noSort : Bool

record Emission : Set where
  constructor emission
  field
    bindings : List B.Binding
    body : String

hexDigit : StringSyntax → ℕ → Char
hexDigit gronEscapes n = if n <ᵇ 10 then primNatToChar (48 + n) else primNatToChar (65 + (n ∸ 10))
hexDigit jsonEscapes n = if n <ᵇ 10 then primNatToChar (48 + n) else primNatToChar (97 + (n ∸ 10))

hexNumeral : ∀ q n → (n <ᵇ 10) ≡ true → hexDigit q n ≡ primNatToChar (48 + n)
hexNumeral gronEscapes n small rewrite small = refl
hexNumeral jsonEscapes n small rewrite small = refl

hexUpper : ∀ n → (n <ᵇ 6) ≡ true → hexDigit gronEscapes (10 + n) ≡ primNatToChar (65 + n)
hexUpper n _ = refl

hexLower : ∀ n → (n <ᵇ 6) ≡ true → hexDigit jsonEscapes (10 + n) ≡ primNatToChar (97 + n)
hexLower n _ = refl

unicodeEscape : StringSyntax → ℕ → String
unicodeEscape q n = "\\u" ++ˢ fromList
  (hexDigit q ((n / 4096) % 16) ∷ hexDigit q ((n / 256) % 16) ∷
   hexDigit q ((n / 16) % 16) ∷ hexDigit q (n % 16) ∷ [])

unicodeSpelling : ∀ q n → unicodeEscape q n ≡
  ("\\u" ++ˢ fromList (hexDigit q ((n / 4096) % 16) ∷ hexDigit q ((n / 256) % 16) ∷
   hexDigit q ((n / 16) % 16) ∷ hexDigit q (n % 16) ∷ []))
unicodeSpelling q n = refl

numericEscape : StringSyntax → Char → Bool
numericEscape gronEscapes c =
  (toℕ c <ᵇ 32) ∨ (((126 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 160)) ∨ ((toℕ c ≡ᵇ 8232) ∨ (toℕ c ≡ᵇ 8233)))
numericEscape jsonEscapes c =
  (toℕ c <ᵇ 32) ∨ ((toℕ c ≡ᵇ 8232) ∨ (toℕ c ≡ᵇ 8233))

gronControl : ∀ c → numericEscape gronEscapes c ≡
  ((toℕ c <ᵇ 32) ∨ (((126 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 160)) ∨ ((toℕ c ≡ᵇ 8232) ∨ (toℕ c ≡ᵇ 8233))))
gronControl c = refl

jsonControl : ∀ c → numericEscape jsonEscapes c ≡
  ((toℕ c <ᵇ 32) ∨ ((toℕ c ≡ᵇ 8232) ∨ (toℕ c ≡ᵇ 8233)))
jsonControl c = refl

private
  shortEscapes : List (Char × String)
  shortEscapes = ('\"' , "\\\"") ∷ ('\\' , "\\\\") ∷ (primNatToChar 8 , "\\b") ∷
    (primNatToChar 12 , "\\f") ∷ (primNatToChar 10 , "\\n") ∷ (primNatToChar 13 , "\\r") ∷
    (primNatToChar 9 , "\\t") ∷ []

  lookupShort : Char → List (Char × String) → Maybe String
  lookupShort c [] = nothing
  lookupShort c ((k , s) ∷ xs) =
    if primCharEquality c k then just s else lookupShort c xs

  lookupShortAbsent : ∀ c xs → any (primCharEquality c) (map proj₁ xs) ≡ false → lookupShort c xs ≡ nothing
  lookupShortAbsent c [] _ = refl
  lookupShortAbsent c ((k , s) ∷ xs) eq with primCharEquality c k
  ... | false = lookupShortAbsent c xs eq
  lookupShortAbsent c ((k , s) ∷ xs) () | true

shortEscape : Char → Maybe String
shortEscape c = lookupShort c shortEscapes

escapedQuote : shortEscape '\"' ≡ just "\\\""
escapedQuote = refl

escapedBackslash : shortEscape '\\' ≡ just "\\\\"
escapedBackslash = refl

escapedBackspace : shortEscape (primNatToChar 8) ≡ just "\\b"
escapedBackspace = refl

escapedFormfeed : shortEscape (primNatToChar 12) ≡ just "\\f"
escapedFormfeed = refl

escapedNewline : shortEscape (primNatToChar 10) ≡ just "\\n"
escapedNewline = refl

escapedReturn : shortEscape (primNatToChar 13) ≡ just "\\r"
escapedReturn = refl

escapedTab : shortEscape (primNatToChar 9) ≡ just "\\t"
escapedTab = refl

noShortEscape : ∀ c → any (primCharEquality c)
  ('\"' ∷ '\\' ∷ primNatToChar 8 ∷ primNatToChar 12 ∷ primNatToChar 10 ∷
   primNatToChar 13 ∷ primNatToChar 9 ∷ []) ≡ false → shortEscape c ≡ nothing
noShortEscape c = lookupShortAbsent c shortEscapes

escapedChar : StringSyntax → Char → String
escapedChar q c with shortEscape c
... | just s = s
... | nothing = if numericEscape q c then unicodeEscape q (toℕ c) else fromList [ c ]

shortChar : ∀ q c s → shortEscape c ≡ just s → escapedChar q c ≡ s
shortChar q c s eq rewrite eq = refl

numericChar : ∀ q c → shortEscape c ≡ nothing → numericEscape q c ≡ true →
  escapedChar q c ≡ unicodeEscape q (toℕ c)
numericChar q c short control rewrite short | control = refl

unchangedChar : ∀ q c → shortEscape c ≡ nothing → numericEscape q c ≡ false → escapedChar q c ≡ fromList [ c ]
unchangedChar q c short control rewrite short | control = refl

escapedChars : StringSyntax → List Char → String
escapedChars q [] = ""
escapedChars q (c ∷ cs) = escapedChar q c ++ˢ escapedChars q cs

noChars : ∀ q → escapedChars q [] ≡ ""
noChars q = refl

nextChar : ∀ q c cs → escapedChars q (c ∷ cs) ≡ (escapedChar q c ++ˢ escapedChars q cs)
nextChar q c cs = refl

stringLiteral : StringSyntax → String → String
stringLiteral q s = "\"" ++ˢ (escapedChars q (toList s) ++ˢ "\"")

stringQuotes : ∀ q s → stringLiteral q s ≡ ("\"" ++ˢ (escapedChars q (toList s) ++ˢ "\""))
stringQuotes q s = refl

forwardControlFixture : stringLiteral gronEscapes (fromList (primNatToChar 31 ∷ [])) ≡ "\"\\u001F\""
forwardControlFixture = refl

reverseControlFixture : stringLiteral jsonEscapes (fromList (primNatToChar 11 ∷ [])) ≡ "\"\\u000b\""
reverseControlFixture = refl

reverseC1Fixture : stringLiteral jsonEscapes (fromList (primNatToChar 133 ∷ [])) ≡
  fromList ('\"' ∷ primNatToChar 133 ∷ '\"' ∷ [])
reverseC1Fixture = refl

private
  data IdentifierRanges : Set where
    startRange continueRange outsideRange : IdentifierRanges
    splitRange : ℕ → IdentifierRanges → IdentifierRanges → IdentifierRanges

  inIdentifierRange : Bool → ℕ → IdentifierRanges → Bool
  inIdentifierRange _ _ startRange = true
  inIdentifierRange allowContinuation _ continueRange = allowContinuation
  inIdentifierRange _ _ outsideRange = false
  inIdentifierRange allowContinuation n (splitRange boundary before after) =
    if n <ᵇ boundary
    then inIdentifierRange allowContinuation n before
    else inIdentifierRange allowContinuation n after

  -- For non-ASCII code points, starts are Lu, Ll, Lm, Lo, or Nl.
  -- The additional continuation categories are Mn, Mc, Nd, and Pc.
