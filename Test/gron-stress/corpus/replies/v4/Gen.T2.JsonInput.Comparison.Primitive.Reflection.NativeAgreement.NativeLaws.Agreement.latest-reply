(submission (kind plan)
  (why "子规约分别规定字符和字符串原语的可靠性与完备性，父模块据此由判定结果的唯一性推出两条标准库一致性定律。")
  (main @main)
  (subspecs
    ("Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeChar" @native-char)
    ("Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeString" @native-string))
  (moves
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.char-agrees"))
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.string-agrees"))
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.false≢true"))
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.agreement"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeChar.char-sound"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeChar.char-complete"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeString.string-sound"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeString.string-complete"))))
```agda main
module Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement where

open import Agda.Builtin.Char using (primCharEquality)
open import Agda.Builtin.String using (primStringEquality)
open import Data.Bool using (Bool; true; false)
open import Data.Empty using (⊥; ⊥-elim)
open import Data.Char using (Char)
open import Data.String using (String)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Relation.Nullary using (Dec; does; yes; no)
import Data.Char.Properties as CharProps
import Data.String.Properties as StringProps
import Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeChar as NativeChar
import Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeString as NativeString

private
  false≢true : false ≡ true → ⊥
  false≢true ()

  agreement : {P : Set} (b : Bool) (p? : Dec P) →
              (b ≡ true → P) → (P → b ≡ true) → b ≡ does p?
  agreement true  (yes p)   sound complete = refl
  agreement true  (no  notp) sound complete = ⊥-elim (notp (sound refl))
  agreement false (yes p)   sound complete = ⊥-elim (false≢true (complete p))
  agreement false (no  notp) sound complete = refl

char-agrees : (c d : Char) → primCharEquality c d ≡ does (c CharProps.≟ d)
char-agrees c d =
  agreement (primCharEquality c d) (c CharProps.≟ d)
    (NativeChar.char-sound c d) (NativeChar.char-complete c d)

string-agrees : (s t : String) → primStringEquality s t ≡ does (s StringProps.≟ t)
string-agrees s t =
  agreement (primStringEquality s t) (s StringProps.≟ t)
    (NativeString.string-sound s t) (NativeString.string-complete s t)

```

```agda native-char
module Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeChar where

open import Agda.Builtin.Char using (Char; primCharEquality)
open import Relation.Binary.PropositionalEquality using (_≡_)
open import Data.Bool using (true)

postulate
  char-sound : (c d : Char) → primCharEquality c d ≡ true → c ≡ d
  char-complete : (c d : Char) → c ≡ d → primCharEquality c d ≡ true

```

```agda native-string
module Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeString where

open import Agda.Builtin.String using (String; primStringEquality)
open import Relation.Binary.PropositionalEquality using (_≡_)
open import Data.Bool using (true)

postulate
  string-sound : (s t : String) → primStringEquality s t ≡ true → s ≡ t
  string-complete : (s t : String) → s ≡ t → primStringEquality s t ≡ true

```
