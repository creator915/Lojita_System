(submission (kind plan)
  (why "以前缀结果连接语法与文档读取，将原语等值反射和诊断字符作为显式端口，由本模块保证分帧、严格尾部校验与流式故障优先级。")
  (main @main)
  (subspecs
    ("Gen.T2.JsonInput.Comparison" @comparison)
    ("Gen.T2.JsonInput.Glyphs" @glyphs)
    ("Gen.T2.JsonInput.Grammar" @grammar))
  (moves
    (move bot (unit "Gen.T2.JsonInput.grammarComparison"))
    (move bot (unit "Gen.T2.JsonInput.grammarLayout"))
    (move bot (unit "Gen.T2.JsonInput.jsonConstructors"))
    (move bot (unit "Gen.T2.JsonInput.toExpectation"))
    (move bot (unit "Gen.T2.JsonInput.fromExpectation"))
