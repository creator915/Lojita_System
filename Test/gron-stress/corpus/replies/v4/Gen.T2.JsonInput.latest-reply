  objectTailClose : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (rest : _) → (Layout.trimSpace layout xs ≡ ('}' ∷ rest)) → objectTail {A} eqs layout build budget xs ≡ consumed [] rest
  objectTailComma : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (rest : _) → (Layout.trimSpace layout xs ≡ (',' ∷ rest)) → objectTail {A} eqs layout build budget xs ≡ objectItems {A} eqs layout build budget false rest
  objectTailUnexpected : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (c : _) → (rest : _) → (Layout.trimSpace layout xs ≡ (c ∷ rest)) → ((primCharEquality c '}' ∨ primCharEquality c ',') ≡ false) → objectTail {A} eqs layout build budget xs ≡ failed (unexpected c afterMember)
  memberEOF : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → memberPrefix {A} eqs layout build budget [] ≡ failed incompleteDocument
  memberBadStart : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (c : _) → (xs : _) → (primCharEquality c '\"' ≡ false) → memberPrefix {A} eqs layout build budget (c ∷ xs) ≡ failed (unexpected c objectKey)
  memberWithValue : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (k : _) → (mid : _) → (v : _) → (rest : _) → (stringBody eqs xs ≡ consumed k mid) → (memberValue {A} eqs layout build budget mid ≡ consumed v rest) → memberPrefix {A} eqs layout build budget ('\"' ∷ xs) ≡ consumed (k , v) rest
  memberKeyError : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (e : _) → (stringBody eqs xs ≡ failed e) → memberPrefix {A} eqs layout build budget ('\"' ∷ xs) ≡ failed e
  memberValueError : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (k : _) → (mid : _) → (e : _) → (stringBody eqs xs ≡ consumed k mid) → (memberValue {A} eqs layout build budget mid ≡ failed e) → memberPrefix {A} eqs layout build budget ('\"' ∷ xs) ≡ failed e
  valueAfterColon : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (rest : _) → (Layout.trimSpace layout xs ≡ (':' ∷ rest)) → (valueAtDepth {A} eqs layout build budget rest ≢ failed missingDocument) → memberValue {A} eqs layout build budget xs ≡ valueAtDepth {A} eqs layout build budget rest
  valueEOF : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (Layout.trimSpace layout xs ≡ []) → memberValue {A} eqs layout build budget xs ≡ failed incompleteDocument
  valueAfterColonEOF : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (rest : _) → (Layout.trimSpace layout xs ≡ (':' ∷ rest)) → (valueAtDepth {A} eqs layout build budget rest ≡ failed missingDocument) → memberValue {A} eqs layout build budget xs ≡ failed incompleteDocument
  memberMissingColon : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → (budget : _) → (xs : _) → (c : _) → (rest : _) → (Layout.trimSpace layout xs ≡ (c ∷ rest)) → (primCharEquality c ':' ≡ false) → memberValue {A} eqs layout build budget xs ≡ failed (unexpected c afterKey)

  leadingNumberExample : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → valueAtDepth eqs layout build 10000 (toList " 	\r\n1x") ≡ consumed (Constructors.numericValue build "1") ([ 'x' ])
  leadingZeroExample : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → valueAtDepth eqs layout build 10000 (toList "[01]") ≡ failed (unexpected '1' afterElement)
  exponentErrorExample : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → valueAtDepth eqs layout build 10000 (toList "[1e+]") ≡ failed (unexpected ']' exponentDigit)
  surrogateExample : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → valueAtDepth eqs layout build 10000 (toList "[\"\\uD83D\\uDE00\",\"\\uD800\",\"\\uDC00\",\"\\uD800\\u0041\",\"a\\/b\"]") ≡ consumed (Constructors.arrayValue build (Constructors.textValue build (fromList ([ primNatToChar 128512 ])) ∷ (Constructors.textValue build (fromList ([ primNatToChar 65533 ])) ∷ (Constructors.textValue build (fromList ([ primNatToChar 65533 ])) ∷ (Constructors.textValue build (fromList (primNatToChar 65533 ∷ ([ 'A' ]))) ∷ ([ Constructors.textValue build "a/b" ])))))) []
  nestedExample : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → valueAtDepth eqs layout build 10000 (toList "[[\"a\"],1][[\"b\"],2]") ≡ consumed (Constructors.arrayValue build (Constructors.arrayValue build ([ Constructors.textValue build "a" ]) ∷ ([ Constructors.numericValue build "1" ]))) (toList "[[\"b\"],2]")

record RepeatedKeys {A : Set} (eqs : Comparison) (layout : Layout) (build : Constructors A) : Set where
  constructor repeatedKeys
  field
    selectedFields : List (String × A)
    repeatedKeyPrefix : valueAtDepth eqs layout build 10000 (toList "{\"a\":{\"x\":1},\"a\":{\"y\":2},\"\\u0062\":0,\"b\":1}") ≡ consumed (Constructors.objectValue build selectedFields) []
    latestA : matchingValues eqs "a" selectedFields ≡ (Constructors.objectValue build (("y" , Constructors.numericValue build "2") ∷ []) ∷ [])
    latestB : matchingValues eqs "b" selectedFields ≡ (Constructors.numericValue build "1" ∷ [])

postulate
  repeatedKeyExample : {A : Set} → (eqs : Comparison) → (layout : Layout) → (build : Constructors A) → RepeatedKeys eqs layout build


```

```agda main
module Gen.T2.JsonInput where

open import Agda.Builtin.Char using (primCharEquality; primNatToChar)
open import Agda.Builtin.String using (primStringEquality)
open import Data.Bool using (Bool; false; true; _∧_; _∨_)
open import Data.Char using (Char; toℕ)
open import Data.List using (List; []; _∷_; [_]; _++_; any; take)
open import Data.Maybe using (Maybe; just; nothing)
open import Data.Nat using (ℕ; zero; suc; _+_; _*_; _∸_; _<ᵇ_; _≡ᵇ_)
open import Data.Nat.DivMod using (_/_; _%_)
open import Data.Product using (_×_; _,_)
open import Data.String using (String; fromList; toList) renaming (_++_ to _++ˢ_)
open import Data.Empty using (⊥; ⊥-elim)
open import Relation.Binary.PropositionalEquality using (_≡_; _≢_; refl; cong; sym; trans; subst)
import Gen.T2.JsonInput.Comparison as Comparison
import Gen.T2.JsonInput.Glyphs as Glyphs
import Gen.T2.JsonInput.Grammar as Grammar

data Json : Set where
  jsonNull : Json
  jsonBool : Bool → Json
  jsonNumber : String → Json
  jsonText : String → Json
  jsonObject : List (String × Json) → Json
  jsonArray : List Json → Json

data Document : Set where
  parsed : Json → Document
  rejected : String → Document

record StreamReply : Set where
  constructor streamReply
  field
    status : ℕ
    values : List Json
    diagnostic : String

data Expectation : Set where
  valueStart : Expectation
  inWord : String → Char → Expectation
  objectKey : Expectation
  afterKey : Expectation
  afterMember : Expectation
  afterElement : Expectation
  integerDigit : Expectation
  fractionalDigit : Expectation
  exponentDigit : Expectation
  insideString : Expectation
  afterEscape : Expectation
  unicodeDigit : Expectation
  afterDocument : Expectation
  exceededDepth : Expectation

data Fault : Set where
  missingDocument : Fault
  incompleteDocument : Fault
  unexpected : Char → Expectation → Fault

data Prefix (A : Set) : Set where
  consumed : A → List Char → Prefix A
  failed : Fault → Prefix A

whitespace : Char → Bool
whitespace c = primCharEquality c ' ' ∨ (primCharEquality c '\t' ∨ (primCharEquality c '\r' ∨ primCharEquality c '\n'))

jsonWhitespace : (c : _) → whitespace c ≡ (primCharEquality c ' ' ∨ (primCharEquality c '	' ∨ (primCharEquality c '\r' ∨ primCharEquality c '\n')))
jsonWhitespace c = refl

skipWhitespace : List Char → List Char
skipWhitespace [] = []
skipWhitespace (c ∷ xs) with whitespace c
... | true  = skipWhitespace xs
... | false = c ∷ xs

skipEmpty : skipWhitespace [] ≡ []
skipEmpty = refl

skipSpace : (c : _) → (xs : _) → (whitespace c ≡ true) → skipWhitespace (c ∷ xs) ≡ skipWhitespace xs
skipSpace c xs eq rewrite eq = refl

keepNonspace : (c : _) → (xs : _) → (whitespace c ≡ false) → skipWhitespace (c ∷ xs) ≡ (c ∷ xs)
keepNonspace c xs eq rewrite eq = refl

diagnosticGlyph : Char → String
diagnosticGlyph = Glyphs.diagnosticGlyph

printableAscii : (c : _) → (((31 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 127)) ≡ true) → (primCharEquality c '\'' ≡ false) → (primCharEquality c '\\' ≡ false) → diagnosticGlyph c ≡ fromList ([ c ])
printableAscii = Glyphs.printableAscii

apostropheGlyph : diagnosticGlyph '\'' ≡ "\\'"
apostropheGlyph = Glyphs.apostropheGlyph

backslashGlyph : diagnosticGlyph '\\' ≡ "\\\\"
backslashGlyph = Glyphs.backslashGlyph

bellGlyph : diagnosticGlyph (primNatToChar 7) ≡ "\\a"
bellGlyph = Glyphs.bellGlyph

verticalTabGlyph : diagnosticGlyph (primNatToChar 11) ≡ "\\v"
verticalTabGlyph = Glyphs.verticalTabGlyph

backspaceGlyph : diagnosticGlyph (primNatToChar 8) ≡ "\\b"
backspaceGlyph = Glyphs.backspaceGlyph

tabGlyph : diagnosticGlyph '	' ≡ "\\t"
tabGlyph = Glyphs.tabGlyph

newlineGlyph : diagnosticGlyph '\n' ≡ "\\n"
newlineGlyph = Glyphs.newlineGlyph

formfeedGlyph : diagnosticGlyph (primNatToChar 12) ≡ "\\f"
formfeedGlyph = Glyphs.formfeedGlyph

returnGlyph : diagnosticGlyph '\r' ≡ "\\r"
returnGlyph = Glyphs.returnGlyph

diagnosticNibble : ℕ → Char
diagnosticNibble = Glyphs.diagnosticNibble

decimalNibble : (n : _) → ((n <ᵇ 10) ≡ true) → diagnosticNibble n ≡ primNatToChar (48 + n)
decimalNibble = Glyphs.decimalNibble

alphabeticNibble : (n : _) → (((9 <ᵇ n) ∧ (n <ᵇ 16)) ≡ true) → diagnosticNibble n ≡ primNatToChar (87 + n)
alphabeticNibble = Glyphs.alphabeticNibble

hexControlGlyph : (c : _) → (((toℕ c <ᵇ 32) ∨ (toℕ c ≡ᵇ 127)) ≡ true) → (any (primCharEquality c) (primNatToChar 7 ∷ (primNatToChar 8 ∷ ('	' ∷ ('\n' ∷ (primNatToChar 11 ∷ (primNatToChar 12 ∷ ('\r' ∷ []))))))) ≡ false) → diagnosticGlyph c ≡ ("\\x" ++ˢ fromList (diagnosticNibble (toℕ c / 16) ∷ (diagnosticNibble (toℕ c % 16) ∷ [])))
hexControlGlyph = Glyphs.hexControlGlyph

glyphTwoBytes : (c : _) → (((127 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 2048)) ≡ true) → diagnosticGlyph c ≡ fromList ([ primNatToChar (192 + (toℕ c / 64)) ])
glyphTwoBytes = Glyphs.glyphTwoBytes

glyphThreeBytes : (c : _) → (((2047 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 65536)) ≡ true) → diagnosticGlyph c ≡ fromList ([ primNatToChar (224 + (toℕ c / 4096)) ])
glyphThreeBytes = Glyphs.glyphThreeBytes

glyphFourBytes : (c : _) → ((65535 <ᵇ toℕ c) ≡ true) → diagnosticGlyph c ≡ fromList ([ primNatToChar (240 + (toℕ c / 262144)) ])
glyphFourBytes = Glyphs.glyphFourBytes

contextText : Expectation → String
contextText valueStart = " looking for beginning of value"
contextText (inWord word c) = (" in literal " ++ˢ (word ++ˢ (" (expecting '" ++ˢ (fromList ([ c ]) ++ˢ "')"))))
contextText objectKey = " looking for beginning of object key string"
contextText afterKey = " after object key"
contextText afterMember = " after object key:value pair"
contextText afterElement = " after array element"
contextText integerDigit = " in numeric literal"
contextText fractionalDigit = " after decimal point in numeric literal"
contextText exponentDigit = " in exponent of numeric literal"
contextText insideString = " in string literal"
contextText afterEscape = " in string escape code"
contextText unicodeDigit = " in \\u hexadecimal character escape"
contextText afterDocument = " after top-level value"
contextText exceededDepth = " exceeded max depth"

startingValueMessage : contextText valueStart ≡ " looking for beginning of value"
startingValueMessage = refl

unfinishedWordMessage : (word : _) → (c : _) → contextText (inWord word c) ≡ (" in literal " ++ˢ (word ++ˢ (" (expecting '" ++ˢ (fromList ([ c ]) ++ˢ "')"))))
unfinishedWordMessage word c = refl

objectKeyMessage : contextText objectKey ≡ " looking for beginning of object key string"
objectKeyMessage = refl

colonMessage : contextText afterKey ≡ " after object key"
colonMessage = refl

memberMessage : contextText afterMember ≡ " after object key:value pair"
memberMessage = refl

elementMessage : contextText afterElement ≡ " after array element"
elementMessage = refl

integerMessage : contextText integerDigit ≡ " in numeric literal"
integerMessage = refl

fractionMessage : contextText fractionalDigit ≡ " after decimal point in numeric literal"
fractionMessage = refl

exponentMessage : contextText exponentDigit ≡ " in exponent of numeric literal"
exponentMessage = refl

stringMessage : contextText insideString ≡ " in string literal"
stringMessage = refl

escapeMessage : contextText afterEscape ≡ " in string escape code"
escapeMessage = refl

unicodeMessage : contextText unicodeDigit ≡ " in \\u hexadecimal character escape"
unicodeMessage = refl

trailingMessage : contextText afterDocument ≡ " after top-level value"
trailingMessage = refl

depthMessage : contextText exceededDepth ≡ " exceeded max depth"
depthMessage = refl

faultText : Fault → String
faultText missingDocument = "EOF"
faultText incompleteDocument = "unexpected EOF"
faultText (unexpected c site) = "invalid character '" ++ˢ (diagnosticGlyph c ++ˢ ("'" ++ˢ contextText site))

missingMessage : faultText missingDocument ≡ "EOF"
missingMessage = refl

incompleteMessage : faultText incompleteDocument ≡ "unexpected EOF"
incompleteMessage = refl

invalidMessage : (c : _) → (site : _) → faultText (unexpected c site) ≡ ("invalid character '" ++ˢ (diagnosticGlyph c ++ˢ ("'" ++ˢ contextText site)))
invalidMessage c site = refl

grammarComparison : Grammar.Comparison
grammarComparison = Grammar.comparison Comparison.charReflexive Comparison.charSound
                                       Comparison.stringReflexive Comparison.stringSound

grammarLayout : Grammar.Layout
grammarLayout = Grammar.layoutRules whitespace jsonWhitespace skipWhitespace skipEmpty skipSpace keepNonspace

jsonConstructors : Grammar.Constructors Json
jsonConstructors with Grammar.constructors jsonNull jsonBool jsonNumber jsonText jsonObject jsonArray
... | build = build

toExpectation : Expectation → Grammar.Expectation
toExpectation valueStart = Grammar.valueStart
toExpectation (inWord word c) = Grammar.inWord word c
toExpectation objectKey = Grammar.objectKey
toExpectation afterKey = Grammar.afterKey
toExpectation afterMember = Grammar.afterMember
toExpectation afterElement = Grammar.afterElement
toExpectation integerDigit = Grammar.integerDigit
toExpectation fractionalDigit = Grammar.fractionalDigit
toExpectation exponentDigit = Grammar.exponentDigit
toExpectation insideString = Grammar.insideString
toExpectation afterEscape = Grammar.afterEscape
toExpectation unicodeDigit = Grammar.unicodeDigit
toExpectation afterDocument = Grammar.afterDocument
toExpectation exceededDepth = Grammar.exceededDepth

fromExpectation : Grammar.Expectation → Expectation
fromExpectation Grammar.valueStart = valueStart
fromExpectation (Grammar.inWord word c) = inWord word c
fromExpectation Grammar.objectKey = objectKey
fromExpectation Grammar.afterKey = afterKey
fromExpectation Grammar.afterMember = afterMember
fromExpectation Grammar.afterElement = afterElement
fromExpectation Grammar.integerDigit = integerDigit
fromExpectation Grammar.fractionalDigit = fractionalDigit
fromExpectation Grammar.exponentDigit = exponentDigit
fromExpectation Grammar.insideString = insideString
fromExpectation Grammar.afterEscape = afterEscape
fromExpectation Grammar.unicodeDigit = unicodeDigit
fromExpectation Grammar.afterDocument = afterDocument
fromExpectation Grammar.exceededDepth = exceededDepth

expectationRoundTrip : (site : Expectation) → fromExpectation (toExpectation site) ≡ site
expectationRoundTrip valueStart = refl
expectationRoundTrip (inWord word c) = refl
expectationRoundTrip objectKey = refl
expectationRoundTrip afterKey = refl
expectationRoundTrip afterMember = refl
expectationRoundTrip afterElement = refl
expectationRoundTrip integerDigit = refl
expectationRoundTrip fractionalDigit = refl
expectationRoundTrip exponentDigit = refl
expectationRoundTrip insideString = refl
expectationRoundTrip afterEscape = refl
expectationRoundTrip unicodeDigit = refl
expectationRoundTrip afterDocument = refl
expectationRoundTrip exceededDepth = refl

grammarExpectationRoundTrip : (site : Grammar.Expectation) → toExpectation (fromExpectation site) ≡ site
grammarExpectationRoundTrip Grammar.valueStart = refl
grammarExpectationRoundTrip (Grammar.inWord word c) = refl
grammarExpectationRoundTrip Grammar.objectKey = refl
grammarExpectationRoundTrip Grammar.afterKey = refl
grammarExpectationRoundTrip Grammar.afterMember = refl
grammarExpectationRoundTrip Grammar.afterElement = refl
grammarExpectationRoundTrip Grammar.integerDigit = refl
grammarExpectationRoundTrip Grammar.fractionalDigit = refl
grammarExpectationRoundTrip Grammar.exponentDigit = refl
grammarExpectationRoundTrip Grammar.insideString = refl
grammarExpectationRoundTrip Grammar.afterEscape = refl
grammarExpectationRoundTrip Grammar.unicodeDigit = refl
grammarExpectationRoundTrip Grammar.afterDocument = refl
grammarExpectationRoundTrip Grammar.exceededDepth = refl

toFault : Fault → Grammar.Fault
toFault missingDocument = Grammar.missingDocument
toFault incompleteDocument = Grammar.incompleteDocument
toFault (unexpected c site) = Grammar.unexpected c (toExpectation site)

fromFault : Grammar.Fault → Fault
fromFault Grammar.missingDocument = missingDocument
fromFault Grammar.incompleteDocument = incompleteDocument
fromFault (Grammar.unexpected c site) = unexpected c (fromExpectation site)

faultRoundTrip : (err : Fault) → fromFault (toFault err) ≡ err
faultRoundTrip missingDocument = refl
faultRoundTrip incompleteDocument = refl
faultRoundTrip (unexpected c site) = cong (unexpected c) (expectationRoundTrip site)

grammarFaultRoundTrip : (err : Grammar.Fault) → toFault (fromFault err) ≡ err
grammarFaultRoundTrip Grammar.missingDocument = refl
grammarFaultRoundTrip Grammar.incompleteDocument = refl
grammarFaultRoundTrip (Grammar.unexpected c site) = cong (Grammar.unexpected c) (grammarExpectationRoundTrip site)

fromPrefix : {A : Set} → Grammar.Prefix A → Prefix A
fromPrefix (Grammar.consumed value rest) = consumed value rest
fromPrefix (Grammar.failed err) = failed (fromFault err)

toPrefix : {A : Set} → Prefix A → Grammar.Prefix A
toPrefix (consumed value rest) = Grammar.consumed value rest
toPrefix (failed err) = Grammar.failed (toFault err)

grammarPrefixRoundTrip : {A : Set} → (p : Grammar.Prefix A) → toPrefix (fromPrefix p) ≡ p
grammarPrefixRoundTrip (Grammar.consumed v rest) = refl
grammarPrefixRoundTrip (Grammar.failed err) = cong Grammar.failed (grammarFaultRoundTrip err)

toPrefixEquality : {A : Set} → (p : Grammar.Prefix A) → {q : Prefix A} → fromPrefix p ≡ q → p ≡ toPrefix q
toPrefixEquality p proof = trans (sym (grammarPrefixRoundTrip p)) (cong toPrefix proof)

returnedFault : {A : Set} → (err : Fault) → fromPrefix (Grammar.failed (toFault err)) ≡ failed {A} err
returnedFault err = cong failed (faultRoundTrip err)

decimalDigit : Char → Bool
decimalDigit c = Grammar.decimalDigit c

hexadecimalDigit : Char → Maybe ℕ
hexadecimalDigit c = Grammar.hexadecimalDigit c

hexPrefix : ℕ → ℕ → List Char → Prefix ℕ
hexPrefix n acc xs = fromPrefix (Grammar.hexPrefix n acc xs)

isHighSurrogate : ℕ → Bool
isHighSurrogate n = Grammar.isHighSurrogate n

isLowSurrogate : ℕ → Bool
isLowSurrogate n = Grammar.isLowSurrogate n

utf16Escape : ℕ → List Char → Prefix Char
utf16Escape n xs = fromPrefix (Grammar.utf16Escape grammarComparison n xs)

escapePrefix : List Char → Prefix Char
escapePrefix xs = fromPrefix (Grammar.escapePrefix grammarComparison xs)

stringBody : List Char → Prefix String
stringBody xs = fromPrefix (Grammar.stringBody grammarComparison xs)

decimalRange : (c : _) → decimalDigit c ≡ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58))
decimalRange c = Grammar.decimalRange c

hexDecimal : (c : _) → (decimalDigit c ≡ true) → hexadecimalDigit c ≡ just (toℕ c ∸ 48)
hexDecimal c eq1 = Grammar.hexDecimal c eq1

hexUppercase : (c : _) → (((64 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 71)) ≡ true) → hexadecimalDigit c ≡ just (toℕ c ∸ 55)
hexUppercase c eq1 = Grammar.hexUppercase c eq1

hexLowercase : (c : _) → (((96 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 103)) ≡ true) → hexadecimalDigit c ≡ just (toℕ c ∸ 87)
hexLowercase c eq1 = Grammar.hexLowercase c eq1

nonHex : (c : _) → ((decimalDigit c ∨ (((64 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 71)) ∨ ((96 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 103)))) ≡ false) → hexadecimalDigit c ≡ nothing
nonHex c eq1 = Grammar.nonHex c eq1

hexComplete : (acc : _) → (xs : _) → hexPrefix 0 acc xs ≡ consumed acc xs
hexComplete acc xs = cong fromPrefix (Grammar.hexComplete acc xs)

hexIncomplete : (n : _) → (acc : _) → hexPrefix (suc n) acc [] ≡ failed incompleteDocument
hexIncomplete n acc = cong fromPrefix (Grammar.hexIncomplete n acc)

hexUnexpected : (n : _) → (acc : _) → (c : _) → (xs : _) → (hexadecimalDigit c ≡ nothing) → hexPrefix (suc n) acc (c ∷ xs) ≡ failed (unexpected c unicodeDigit)
hexUnexpected n acc c xs eq1 = cong fromPrefix (Grammar.hexUnexpected n acc c xs eq1)

hexNext : (n : _) → (acc : _) → (c : _) → (xs : _) → (d : _) → (hexadecimalDigit c ≡ just d) → hexPrefix (suc n) acc (c ∷ xs) ≡ hexPrefix n ((16 * acc) + d) xs
hexNext n acc c xs d eq1 = cong fromPrefix (Grammar.hexNext n acc c xs d eq1)

highRange : (n : _) → isHighSurrogate n ≡ ((55295 <ᵇ n) ∧ (n <ᵇ 56320))
highRange n = Grammar.highRange n

lowRange : (n : _) → isLowSurrogate n ≡ ((56319 <ᵇ n) ∧ (n <ᵇ 57344))
lowRange n = Grammar.lowRange n

ordinaryUnit : (n : _) → (xs : _) → ((n <ᵇ 65536) ≡ true) → ((isHighSurrogate n ∨ isLowSurrogate n) ≡ false) → utf16Escape n xs ≡ consumed (primNatToChar n) xs
ordinaryUnit n xs eq1 eq2 = cong fromPrefix (Grammar.ordinaryUnit grammarComparison n xs eq1 eq2)

isolatedLow : (n : _) → (xs : _) → (isLowSurrogate n ≡ true) → utf16Escape n xs ≡ consumed (primNatToChar 65533) xs
isolatedLow n xs eq1 = cong fromPrefix (Grammar.isolatedLow grammarComparison n xs eq1)

noSecondUnit : (n : _) → (xs : _) → (isHighSurrogate n ≡ true) → (take 2 xs ≢ ('\\' ∷ ('u' ∷ []))) → utf16Escape n xs ≡ consumed (primNatToChar 65533) xs
noSecondUnit n xs eq1 eq2 = cong fromPrefix (Grammar.noSecondUnit grammarComparison n xs eq1 eq2)

malformedSecondUnit : (n : _) → (xs : _) → (fault : _) → (isHighSurrogate n ≡ true) → (hexPrefix 4 0 xs ≡ failed fault) → utf16Escape n ('\\' ∷ ('u' ∷ xs)) ≡ consumed (primNatToChar 65533) ('\\' ∷ ('u' ∷ xs))
malformedSecondUnit n xs fault eq1 eq2 = cong fromPrefix (Grammar.malformedSecondUnit grammarComparison n xs (toFault fault) eq1 (toPrefixEquality (Grammar.hexPrefix 4 0 xs) eq2))

unmatchedSecondUnit : (n : _) → (m : _) → (xs : _) → (rest : _) → (isHighSurrogate n ≡ true) → (hexPrefix 4 0 xs ≡ consumed m rest) → (isLowSurrogate m ≡ false) → utf16Escape n ('\\' ∷ ('u' ∷ xs)) ≡ consumed (primNatToChar 65533) ('\\' ∷ ('u' ∷ xs))
unmatchedSecondUnit n m xs rest eq1 eq2 eq3 = cong fromPrefix (Grammar.unmatchedSecondUnit grammarComparison n m xs rest eq1 (toPrefixEquality (Grammar.hexPrefix 4 0 xs) eq2) eq3)

