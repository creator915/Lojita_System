arrayItem budget empty xs c cs v mid vs rest eq1 eq2 eq3 eq4 = cong fromPrefix (Grammar.arrayItem {Json} grammarComparison grammarLayout jsonConstructors budget empty xs c cs v mid vs rest eq1 eq2 (toPrefixEquality (Grammar.valueAtDepth {Json} grammarComparison grammarLayout jsonConstructors budget (c ∷ cs)) eq3) (toPrefixEquality (Grammar.arrayTail {Json} grammarComparison grammarLayout jsonConstructors budget mid) eq4))

arrayItemError : (budget : _) → (empty : _) → (xs : _) → (c : _) → (cs : _) → (e : _) → (skipWhitespace xs ≡ (c ∷ cs)) → ((empty ∧ primCharEquality c ']') ≡ false) → (valueAtDepth budget (c ∷ cs) ≡ failed e) → arrayItems budget empty xs ≡ failed e
arrayItemError budget empty xs c cs e eq1 eq2 eq3 = trans (cong fromPrefix (Grammar.arrayItemError {Json} grammarComparison grammarLayout jsonConstructors budget empty xs c cs (toFault e) eq1 eq2 (toPrefixEquality (Grammar.valueAtDepth {Json} grammarComparison grammarLayout jsonConstructors budget (c ∷ cs)) eq3))) (returnedFault e)

arrayAfterItemError : (budget : _) → (empty : _) → (xs : _) → (c : _) → (cs : _) → (v : _) → (mid : _) → (e : _) → (skipWhitespace xs ≡ (c ∷ cs)) → ((empty ∧ primCharEquality c ']') ≡ false) → (valueAtDepth budget (c ∷ cs) ≡ consumed v mid) → (arrayTail budget mid ≡ failed e) → arrayItems budget empty xs ≡ failed e
arrayAfterItemError budget empty xs c cs v mid e eq1 eq2 eq3 eq4 = trans (cong fromPrefix (Grammar.arrayAfterItemError {Json} grammarComparison grammarLayout jsonConstructors budget empty xs c cs v mid (toFault e) eq1 eq2 (toPrefixEquality (Grammar.valueAtDepth {Json} grammarComparison grammarLayout jsonConstructors budget (c ∷ cs)) eq3) (toPrefixEquality (Grammar.arrayTail {Json} grammarComparison grammarLayout jsonConstructors budget mid) eq4))) (returnedFault e)

arrayTailEOF : (budget : _) → (xs : _) → (skipWhitespace xs ≡ []) → arrayTail budget xs ≡ failed incompleteDocument
arrayTailEOF budget xs eq1 = cong fromPrefix (Grammar.arrayTailEOF {Json} grammarComparison grammarLayout jsonConstructors budget xs eq1)

arrayTailClose : (budget : _) → (xs : _) → (rest : _) → (skipWhitespace xs ≡ (']' ∷ rest)) → arrayTail budget xs ≡ consumed [] rest
arrayTailClose budget xs rest eq1 = cong fromPrefix (Grammar.arrayTailClose {Json} grammarComparison grammarLayout jsonConstructors budget xs rest eq1)

arrayTailComma : (budget : _) → (xs : _) → (rest : _) → (skipWhitespace xs ≡ (',' ∷ rest)) → arrayTail budget xs ≡ arrayItems budget false rest
arrayTailComma budget xs rest eq1 = cong fromPrefix (Grammar.arrayTailComma {Json} grammarComparison grammarLayout jsonConstructors budget xs rest eq1)

arrayTailUnexpected : (budget : _) → (xs : _) → (c : _) → (rest : _) → (skipWhitespace xs ≡ (c ∷ rest)) → ((primCharEquality c ']' ∨ primCharEquality c ',') ≡ false) → arrayTail budget xs ≡ failed (unexpected c afterElement)
arrayTailUnexpected budget xs c rest eq1 eq2 = cong fromPrefix (Grammar.arrayTailUnexpected {Json} grammarComparison grammarLayout jsonConstructors budget xs c rest eq1 eq2)

objectItemsEOF : (budget : _) → (empty : _) → (xs : _) → (skipWhitespace xs ≡ []) → objectItems budget empty xs ≡ failed incompleteDocument
objectItemsEOF budget empty xs eq1 = cong fromPrefix (Grammar.objectItemsEOF {Json} grammarComparison grammarLayout jsonConstructors budget empty xs eq1)

objectEmpty : (budget : _) → (xs : _) → (rest : _) → (skipWhitespace xs ≡ ('}' ∷ rest)) → objectItems budget true xs ≡ consumed [] rest
objectEmpty budget xs rest eq1 = cong fromPrefix (Grammar.objectEmpty {Json} grammarComparison grammarLayout jsonConstructors budget xs rest eq1)

objectItem : (budget : _) → (empty : _) → (xs : _) → (c : _) → (cs : _) → (entry : _) → (mid : _) → (fields : _) → (rest : _) → (skipWhitespace xs ≡ (c ∷ cs)) → ((empty ∧ primCharEquality c '}') ≡ false) → (memberPrefix budget (c ∷ cs) ≡ consumed entry mid) → (objectTail budget mid ≡ consumed fields rest) → objectItems budget empty xs ≡ consumed (entry ∷ fields) rest
objectItem budget empty xs c cs entry mid fields rest eq1 eq2 eq3 eq4 = cong fromPrefix (Grammar.objectItem {Json} grammarComparison grammarLayout jsonConstructors budget empty xs c cs entry mid fields rest eq1 eq2 (toPrefixEquality (Grammar.memberPrefix {Json} grammarComparison grammarLayout jsonConstructors budget (c ∷ cs)) eq3) (toPrefixEquality (Grammar.objectTail {Json} grammarComparison grammarLayout jsonConstructors budget mid) eq4))

objectItemError : (budget : _) → (empty : _) → (xs : _) → (c : _) → (cs : _) → (e : _) → (skipWhitespace xs ≡ (c ∷ cs)) → ((empty ∧ primCharEquality c '}') ≡ false) → (memberPrefix budget (c ∷ cs) ≡ failed e) → objectItems budget empty xs ≡ failed e
objectItemError budget empty xs c cs e eq1 eq2 eq3 = trans (cong fromPrefix (Grammar.objectItemError {Json} grammarComparison grammarLayout jsonConstructors budget empty xs c cs (toFault e) eq1 eq2 (toPrefixEquality (Grammar.memberPrefix {Json} grammarComparison grammarLayout jsonConstructors budget (c ∷ cs)) eq3))) (returnedFault e)

objectAfterItemError : (budget : _) → (empty : _) → (xs : _) → (c : _) → (cs : _) → (entry : _) → (mid : _) → (e : _) → (skipWhitespace xs ≡ (c ∷ cs)) → ((empty ∧ primCharEquality c '}') ≡ false) → (memberPrefix budget (c ∷ cs) ≡ consumed entry mid) → (objectTail budget mid ≡ failed e) → objectItems budget empty xs ≡ failed e
objectAfterItemError budget empty xs c cs entry mid e eq1 eq2 eq3 eq4 = trans (cong fromPrefix (Grammar.objectAfterItemError {Json} grammarComparison grammarLayout jsonConstructors budget empty xs c cs entry mid (toFault e) eq1 eq2 (toPrefixEquality (Grammar.memberPrefix {Json} grammarComparison grammarLayout jsonConstructors budget (c ∷ cs)) eq3) (toPrefixEquality (Grammar.objectTail {Json} grammarComparison grammarLayout jsonConstructors budget mid) eq4))) (returnedFault e)

objectTailEOF : (budget : _) → (xs : _) → (skipWhitespace xs ≡ []) → objectTail budget xs ≡ failed incompleteDocument
objectTailEOF budget xs eq1 = cong fromPrefix (Grammar.objectTailEOF {Json} grammarComparison grammarLayout jsonConstructors budget xs eq1)

objectTailClose : (budget : _) → (xs : _) → (rest : _) → (skipWhitespace xs ≡ ('}' ∷ rest)) → objectTail budget xs ≡ consumed [] rest
objectTailClose budget xs rest eq1 = cong fromPrefix (Grammar.objectTailClose {Json} grammarComparison grammarLayout jsonConstructors budget xs rest eq1)

objectTailComma : (budget : _) → (xs : _) → (rest : _) → (skipWhitespace xs ≡ (',' ∷ rest)) → objectTail budget xs ≡ objectItems budget false rest
objectTailComma budget xs rest eq1 = cong fromPrefix (Grammar.objectTailComma {Json} grammarComparison grammarLayout jsonConstructors budget xs rest eq1)

objectTailUnexpected : (budget : _) → (xs : _) → (c : _) → (rest : _) → (skipWhitespace xs ≡ (c ∷ rest)) → ((primCharEquality c '}' ∨ primCharEquality c ',') ≡ false) → objectTail budget xs ≡ failed (unexpected c afterMember)
objectTailUnexpected budget xs c rest eq1 eq2 = cong fromPrefix (Grammar.objectTailUnexpected {Json} grammarComparison grammarLayout jsonConstructors budget xs c rest eq1 eq2)

memberEOF : (budget : _) → memberPrefix budget [] ≡ failed incompleteDocument
memberEOF budget = cong fromPrefix (Grammar.memberEOF {Json} grammarComparison grammarLayout jsonConstructors budget)

memberBadStart : (budget : _) → (c : _) → (xs : _) → (primCharEquality c '\"' ≡ false) → memberPrefix budget (c ∷ xs) ≡ failed (unexpected c objectKey)
memberBadStart budget c xs eq1 = cong fromPrefix (Grammar.memberBadStart {Json} grammarComparison grammarLayout jsonConstructors budget c xs eq1)

memberWithValue : (budget : _) → (xs : _) → (k : _) → (mid : _) → (v : _) → (rest : _) → (stringBody xs ≡ consumed k mid) → (memberValue budget mid ≡ consumed v rest) → memberPrefix budget ('\"' ∷ xs) ≡ consumed (k , v) rest
memberWithValue budget xs k mid v rest eq1 eq2 = cong fromPrefix (Grammar.memberWithValue {Json} grammarComparison grammarLayout jsonConstructors budget xs k mid v rest (toPrefixEquality (Grammar.stringBody grammarComparison xs) eq1) (toPrefixEquality (Grammar.memberValue {Json} grammarComparison grammarLayout jsonConstructors budget mid) eq2))

memberKeyError : (budget : _) → (xs : _) → (e : _) → (stringBody xs ≡ failed e) → memberPrefix budget ('\"' ∷ xs) ≡ failed e
memberKeyError budget xs e eq1 = trans (cong fromPrefix (Grammar.memberKeyError {Json} grammarComparison grammarLayout jsonConstructors budget xs (toFault e) (toPrefixEquality (Grammar.stringBody grammarComparison xs) eq1))) (returnedFault e)

memberValueError : (budget : _) → (xs : _) → (k : _) → (mid : _) → (e : _) → (stringBody xs ≡ consumed k mid) → (memberValue budget mid ≡ failed e) → memberPrefix budget ('\"' ∷ xs) ≡ failed e
memberValueError budget xs k mid e eq1 eq2 = trans (cong fromPrefix (Grammar.memberValueError {Json} grammarComparison grammarLayout jsonConstructors budget xs k mid (toFault e) (toPrefixEquality (Grammar.stringBody grammarComparison xs) eq1) (toPrefixEquality (Grammar.memberValue {Json} grammarComparison grammarLayout jsonConstructors budget mid) eq2))) (returnedFault e)

valueAfterColon : (budget : _) → (xs : _) → (rest : _) → (skipWhitespace xs ≡ (':' ∷ rest)) → (valueAtDepth budget rest ≢ failed missingDocument) → memberValue budget xs ≡ valueAtDepth budget rest
valueAfterColon budget xs rest eq1 eq2 = cong fromPrefix (Grammar.valueAfterColon {Json} grammarComparison grammarLayout jsonConstructors budget xs rest eq1 (λ mismatch → eq2 (cong fromPrefix mismatch)))

valueEOF : (budget : _) → (xs : _) → (skipWhitespace xs ≡ []) → memberValue budget xs ≡ failed incompleteDocument
valueEOF budget xs eq1 = cong fromPrefix (Grammar.valueEOF {Json} grammarComparison grammarLayout jsonConstructors budget xs eq1)

valueAfterColonEOF : (budget : _) → (xs : _) → (rest : _) → (skipWhitespace xs ≡ (':' ∷ rest)) → (valueAtDepth budget rest ≡ failed missingDocument) → memberValue budget xs ≡ failed incompleteDocument
valueAfterColonEOF budget xs rest eq1 eq2 = cong fromPrefix (Grammar.valueAfterColonEOF {Json} grammarComparison grammarLayout jsonConstructors budget xs rest eq1 (toPrefixEquality (Grammar.valueAtDepth {Json} grammarComparison grammarLayout jsonConstructors budget rest) eq2))

memberMissingColon : (budget : _) → (xs : _) → (c : _) → (rest : _) → (skipWhitespace xs ≡ (c ∷ rest)) → (primCharEquality c ':' ≡ false) → memberValue budget xs ≡ failed (unexpected c afterKey)
memberMissingColon budget xs c rest eq1 eq2 = cong fromPrefix (Grammar.memberMissingColon {Json} grammarComparison grammarLayout jsonConstructors budget xs c rest eq1 eq2)

maxNesting : ℕ
maxNesting = 10000

nestingCapacity : maxNesting ≡ 10000
nestingCapacity = refl

valuePrefix : List Char → Prefix Json
valuePrefix = valueAtDepth maxNesting

topLevelBudget : (xs : _) → valuePrefix xs ≡ valueAtDepth maxNesting xs
topLevelBudget xs = refl

firstDocument : List Char → Document
firstDocument xs with valuePrefix xs
... | consumed v rest = parsed v
... | failed e = rejected (faultText e)

firstDocumentFound : (xs : _) → (v : _) → (rest : _) → (valuePrefix xs ≡ consumed v rest) → firstDocument xs ≡ parsed v
firstDocumentFound xs v rest eq rewrite eq = refl

firstDocumentFault : (xs : _) → (e : _) → (valuePrefix xs ≡ failed e) → firstDocument xs ≡ rejected (faultText e)
firstDocumentFault xs e eq rewrite eq = refl

readDocument : String → Document
readDocument s = firstDocument (toList s)

readDocumentLaw : (s : _) → readDocument s ≡ firstDocument (toList s)
readDocumentLaw s = refl

strictRemainder : Json → List Char → Document
strictRemainder v rest with rest
... | [] = parsed v
... | c ∷ cs = rejected (faultText (unexpected c afterDocument))

strictFromPrefix : Prefix Json → Document
strictFromPrefix (consumed v rest) = strictRemainder v (skipWhitespace rest)
strictFromPrefix (failed missingDocument) = rejected "unexpected end of JSON input"
strictFromPrefix (failed incompleteDocument) = rejected "unexpected end of JSON input"
strictFromPrefix (failed (unexpected c site)) = rejected (faultText (unexpected c site))

strictDocument : List Char → Document
strictDocument xs = strictFromPrefix (valuePrefix xs)

strictDocumentFound : (xs : _) → (v : _) → (rest : _) → (valuePrefix xs ≡ consumed v rest) → (skipWhitespace rest ≡ []) → strictDocument xs ≡ parsed v
strictDocumentFound xs v rest eq tailEq = trans (cong strictFromPrefix eq) (cong (strictRemainder v) tailEq)

strictDocumentTrailing : (xs : _) → (v : _) → (rest : _) → (c : _) → (cs : _) → (valuePrefix xs ≡ consumed v rest) → (skipWhitespace rest ≡ (c ∷ cs)) → strictDocument xs ≡ rejected (faultText (unexpected c afterDocument))
strictDocumentTrailing xs v rest c cs eq tailEq = trans (cong strictFromPrefix eq) (cong (strictRemainder v) tailEq)

strictDocumentInvalid : (xs : _) → (c : _) → (site : _) → (valuePrefix xs ≡ failed (unexpected c site)) → strictDocument xs ≡ rejected (faultText (unexpected c site))
strictDocumentInvalid xs c site eq = cong strictFromPrefix eq

strictDocumentMissing : (xs : _) → (valuePrefix xs ≡ failed missingDocument) → strictDocument xs ≡ rejected "unexpected end of JSON input"
strictDocumentMissing xs eq = cong strictFromPrefix eq

strictDocumentIncomplete : (xs : _) → (valuePrefix xs ≡ failed incompleteDocument) → strictDocument xs ≡ rejected "unexpected end of JSON input"
strictDocumentIncomplete xs eq = cong strictFromPrefix eq

record FrameScan : Set where
  constructor frameScan
  field
    frames : List (List Char)
    tooLong : Bool

falseAtOne : (n : ℕ) → ((suc n) <ᵇ 1) ≡ false
falseAtOne n with n
... | zero = refl
... | suc k = refl

cutFor : (lower gap n : ℕ) → (((lower + gap) <ᵇ n) ≡ true) → (n <ᵇ suc lower) ≡ false
cutFor zero gap zero ()
cutFor (suc lower) gap zero ()
cutFor zero gap (suc n) eq = falseAtOne n
cutFor (suc lower) gap (suc n) eq = cutFor lower gap n eq

bothLeft : (a b : Bool) → ((a ∧ b) ≡ true) → a ≡ true
bothLeft true b eq = refl
bothLeft false b ()

bothRight : (a b : Bool) → ((a ∧ b) ≡ true) → b ≡ true
bothRight true b eq = eq
bothRight false b ()

widthOf : ℕ → ℕ
widthOf n with n <ᵇ 128
... | true = 1
... | false with n <ᵇ 2048
...   | true = 2
...   | false with n <ᵇ 65536
...     | true = 3
...     | false = 4

utf8Width : Char → ℕ
utf8Width c = widthOf (toℕ c)

asciiWidth : (c : _) → ((toℕ c <ᵇ 128) ≡ true) → utf8Width c ≡ 1
asciiWidth c p rewrite p = refl

twoByteWidth : (c : _) → (((127 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 2048)) ≡ true) → utf8Width c ≡ 2
twoByteWidth c p rewrite cutFor 127 0 (toℕ c) (bothLeft (127 <ᵇ toℕ c) (toℕ c <ᵇ 2048) p) | bothRight (127 <ᵇ toℕ c) (toℕ c <ᵇ 2048) p = refl

threeByteWidth : (c : _) → (((2047 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 65536)) ≡ true) → utf8Width c ≡ 3
threeByteWidth c p rewrite cutFor 127 1920 (toℕ c) (bothLeft (2047 <ᵇ toℕ c) (toℕ c <ᵇ 65536) p) | cutFor 2047 0 (toℕ c) (bothLeft (2047 <ᵇ toℕ c) (toℕ c <ᵇ 65536) p) | bothRight (2047 <ᵇ toℕ c) (toℕ c <ᵇ 65536) p = refl

fourByteWidth : (c : _) → ((65535 <ᵇ toℕ c) ≡ true) → utf8Width c ≡ 4
fourByteWidth c p rewrite cutFor 127 65408 (toℕ c) p | cutFor 2047 63488 (toℕ c) p | cutFor 65535 0 (toℕ c) p = refl

byteCount : List Char → ℕ
byteCount [] = zero
byteCount (c ∷ xs) = utf8Width c + byteCount xs

noBytes : byteCount [] ≡ 0
noBytes = refl

moreBytes : (c : _) → (xs : _) → byteCount (c ∷ xs) ≡ (utf8Width c + byteCount xs)
moreBytes c xs = refl

lineContent : List Char → List Char
lineContent [] = []
lineContent (c ∷ d ∷ xs) = c ∷ lineContent (d ∷ xs)
lineContent (c ∷ []) with primCharEquality c '\r'
... | true = []
... | false = [ c ]

noLineContent : lineContent [] ≡ []
noLineContent = refl

stripFinalCR : (xs : _) → lineContent (xs ++ ([ '\r' ])) ≡ xs
stripFinalCR [] = refl
stripFinalCR (c ∷ []) = refl
stripFinalCR (c ∷ d ∷ xs) = cong (λ ys → c ∷ ys) (stripFinalCR (d ∷ xs))

keepFinalChar : (xs : _) → (c : _) → (primCharEquality c '\r' ≡ false) → lineContent (xs ++ ([ c ])) ≡ (xs ++ ([ c ]))
keepFinalChar [] c eq rewrite eq = refl
keepFinalChar (d ∷ []) c eq = cong (λ ys → d ∷ ys) (keepFinalChar [] c eq)
keepFinalChar (d ∷ e ∷ xs) c eq = cong (λ ys → d ∷ ys) (keepFinalChar (e ∷ xs) c eq)

frameLimit : ℕ
frameLimit = 1048576

lineBufferCapacity : frameLimit ≡ 1048576
lineBufferCapacity = refl

data LineView : Set where
  end : LineView
  final : List Char → LineView
  terminated : List Char → FrameScan → LineView

keepFrame : List Char → FrameScan → FrameScan
keepFrame xs (frameScan ls capped) = frameScan (lineContent xs ∷ ls) capped

finishLine : Bool → List Char → FrameScan → FrameScan
finishLine true xs after = keepFrame xs after
finishLine false xs after = frameScan [] true

renderView : LineView → FrameScan
renderView end = frameScan [] false
renderView (final xs) = finishLine (byteCount xs <ᵇ frameLimit) xs (frameScan [] false)
renderView (terminated xs after) = finishLine (byteCount xs <ᵇ frameLimit) xs after

extendLine : Bool → Char → LineView → LineView
extendLine true c next = terminated [] (renderView next)
extendLine false c end = final [ c ]
extendLine false c (final xs) = final (c ∷ xs)
extendLine false c (terminated xs after) = terminated (c ∷ xs) after

lineView : List Char → LineView
lineView [] = end
lineView (c ∷ xs) = extendLine (primCharEquality '\n' c) c (lineView xs)

physicalLines : List Char → FrameScan
physicalLines xs = renderView (lineView xs)

noPhysicalLines : physicalLines [] ≡ frameScan [] false
noPhysicalLines = refl

viewTerminated : (xs ys : List Char) → any (primCharEquality '\n') xs ≡ false →
  lineView (xs ++ ('\n' ∷ ys)) ≡ terminated xs (physicalLines ys)
viewTerminated [] ys eq = refl
viewTerminated (c ∷ xs) ys eq with primCharEquality '\n' c
... | false = cong (extendLine false c) (viewTerminated xs ys eq)
... | true with eq
...   | ()

lastView : List Char → LineView
lastView [] = end
lastView (c ∷ xs) = final (c ∷ xs)

extendFinal : (c : Char) → (xs : List Char) →
  extendLine false c (lastView xs) ≡ final (c ∷ xs)
extendFinal c [] = refl
extendFinal c (d ∷ xs) = refl

viewFinal : (xs : List Char) → any (primCharEquality '\n') xs ≡ false → lineView xs ≡ lastView xs
viewFinal [] eq = refl
viewFinal (c ∷ xs) eq with primCharEquality '\n' c
... | false rewrite viewFinal xs eq = extendFinal c xs
... | true with eq
...   | ()

terminatedLine : (xs : _) → (ys : _) → (ls : _) → (capped : _) → (any (primCharEquality '\n') xs ≡ false) → ((byteCount xs <ᵇ frameLimit) ≡ true) → (physicalLines ys ≡ frameScan ls capped) → physicalLines (xs ++ ('\n' ∷ ys)) ≡ frameScan (lineContent xs ∷ ls) capped
terminatedLine xs ys ls capped noLF within tailEq rewrite viewTerminated xs ys noLF | within | tailEq = refl

finalLine : (c : _) → (xs : _) → (any (primCharEquality '\n') (c ∷ xs) ≡ false) → ((byteCount (c ∷ xs) <ᵇ frameLimit) ≡ true) → physicalLines (c ∷ xs) ≡ frameScan ([ lineContent (c ∷ xs) ]) false
finalLine c xs noLF within rewrite viewFinal (c ∷ xs) noLF | within = refl

oversizedLine : (xs : _) → (ys : _) → (any (primCharEquality '\n') xs ≡ false) → ((byteCount xs <ᵇ frameLimit) ≡ false) → physicalLines (xs ++ ('\n' ∷ ys)) ≡ frameScan [] true
oversizedLine xs ys noLF exceeds rewrite viewTerminated xs ys noLF | exceeds = refl

oversizedFinalLine : (c : _) → (xs : _) → (any (primCharEquality '\n') (c ∷ xs) ≡ false) → ((byteCount (c ∷ xs) <ᵇ frameLimit) ≡ false) → physicalLines (c ∷ xs) ≡ frameScan [] true
oversizedFinalLine c xs noLF exceeds rewrite viewFinal (c ∷ xs) noLF | exceeds = refl


record DocumentSequence : Set where
  constructor documentSequence
  field
    documents : List Json
    interruption : Maybe String

decodeStep : Document → DocumentSequence → DocumentSequence
decodeStep doc rest with doc
... | rejected e = documentSequence [] (just e)
... | parsed v = documentSequence (v ∷ DocumentSequence.documents rest) (DocumentSequence.interruption rest)

decodeLines : List (List Char) → DocumentSequence
decodeLines [] = documentSequence [] nothing
decodeLines (line ∷ more) = decodeStep (firstDocument line) (decodeLines more)

decodeWithoutLines : decodeLines [] ≡ documentSequence [] nothing
decodeWithoutLines = refl

decodeUntilFault : (line : _) → (more : _) → (e : _) → (firstDocument line ≡ rejected e) → decodeLines (line ∷ more) ≡ documentSequence [] (just e)
decodeUntilFault line more e eq = cong (λ d → decodeStep d (decodeLines more)) eq

decodeNextLine : (line : _) → (more : _) → (v : _) → (vs : _) → (e : _) → (firstDocument line ≡ parsed v) → (decodeLines more ≡ documentSequence vs e) → decodeLines (line ∷ more) ≡ documentSequence (v ∷ vs) e
decodeNextLine line more v vs e eq tailEq =
  trans (cong (λ d → decodeStep d (decodeLines more)) eq) (cong (decodeStep (parsed v)) tailEq)

streamStatus : Bool → DocumentSequence → StreamReply
streamStatus capped decoded with decoded
... | documentSequence vs (just e) = streamReply 3 vs ("failed to form statements: " ++ˢ (e ++ˢ "\n"))
... | documentSequence vs nothing with capped
...   | false = streamReply 0 vs ""
...   | true = streamReply 3 vs "error reading multiline input: bufio.Scanner: token too long: %!s(MISSING)\n"

streamFromScan : FrameScan → StreamReply
streamFromScan (frameScan ls capped) = streamStatus capped (decodeLines ls)

readStream : String → StreamReply
readStream s = streamFromScan (physicalLines (toList s))

streamReadComplete : (s : _) → (ls : _) → (vs : _) → (physicalLines (toList s) ≡ frameScan ls false) → (decodeLines ls ≡ documentSequence vs nothing) → readStream s ≡ streamReply 0 vs ""
streamReadComplete s ls vs eq tailEq = trans (cong streamFromScan eq) (cong (streamStatus false) tailEq)

streamReadMalformed : (s : _) → (ls : _) → (capped : _) → (vs : _) → (e : _) → (physicalLines (toList s) ≡ frameScan ls capped) → (decodeLines ls ≡ documentSequence vs (just e)) → readStream s ≡ streamReply 3 vs ("failed to form statements: " ++ˢ (e ++ˢ "\n"))
streamReadMalformed s ls capped vs e eq tailEq = trans (cong streamFromScan eq) (cong (streamStatus capped) tailEq)

streamReadCapped : (s : _) → (ls : _) → (vs : _) → (physicalLines (toList s) ≡ frameScan ls true) → (decodeLines ls ≡ documentSequence vs nothing) → readStream s ≡ streamReply 3 vs "error reading multiline input: bufio.Scanner: token too long: %!s(MISSING)\n"
streamReadCapped s ls vs eq tailEq = trans (cong streamFromScan eq) (cong (streamStatus true) tailEq)

rootDepth : (xs : List Char) → valuePrefix xs ≡ valueAtDepth 10000 xs
rootDepth xs = trans (topLevelBudget xs) (cong (λ budget → valueAtDepth budget xs) nestingCapacity)

printableFault : (c : Char) → (site : Expectation) → (message : String) →
  ((31 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 127)) ≡ true →
  primCharEquality c '\'' ≡ false → primCharEquality c '\\' ≡ false →
  contextText site ≡ message →
  faultText (unexpected c site) ≡ ("invalid character '" ++ˢ (fromList ([ c ]) ++ˢ ("'" ++ˢ message)))
printableFault c site message range noQuote noSlash context =
  trans (invalidMessage c site)
    (trans (cong (λ glyph → "invalid character '" ++ˢ (glyph ++ˢ ("'" ++ˢ contextText site)))
                 (printableAscii c range noQuote noSlash))
           (cong (λ suffix → "invalid character '" ++ˢ (fromList ([ c ]) ++ˢ ("'" ++ˢ suffix))) context))

numberPrefixFixture : readDocument " 	\r\n1x" ≡ parsed (jsonNumber "1")
numberPrefixFixture =
  firstDocumentFound (toList " 	\r\n1x") (jsonNumber "1") ([ 'x' ])
    (trans (rootDepth (toList " 	\r\n1x"))
           (cong fromPrefix (Grammar.leadingNumberExample grammarComparison grammarLayout jsonConstructors)))

leadingZeroFixture : readDocument "[01]" ≡ rejected "invalid character '1' after array element"
leadingZeroFixture =
  trans (firstDocumentFault (toList "[01]") (unexpected '1' afterElement)
           (trans (rootDepth (toList "[01]"))
                  (cong fromPrefix (Grammar.leadingZeroExample grammarComparison grammarLayout jsonConstructors))))
        (cong rejected (printableFault '1' afterElement " after array element" refl refl refl elementMessage))

failureAfterExponentFixture : readDocument "[1e+]" ≡ rejected "invalid character ']' in exponent of numeric literal"
failureAfterExponentFixture =
  trans (firstDocumentFault (toList "[1e+]") (unexpected ']' exponentDigit)
           (trans (rootDepth (toList "[1e+]"))
                  (cong fromPrefix (Grammar.exponentErrorExample grammarComparison grammarLayout jsonConstructors))))
        (cong rejected (printableFault ']' exponentDigit " in exponent of numeric literal" refl refl refl exponentMessage))

nulIsUnexpected : (whitespace (primNatToChar 0) ∨ (decimalDigit (primNatToChar 0) ∨ any (primCharEquality (primNatToChar 0)) (toList "-tfn\"[{"))) ≡ false
nulIsUnexpected =
  cong (λ digit → whitespace (primNatToChar 0) ∨ (digit ∨ any (primCharEquality (primNatToChar 0)) (toList "-tfn\"[{")))
       (decimalRange (primNatToChar 0))

nulGlyph : diagnosticGlyph (primNatToChar 0) ≡ "\\x00"
nulGlyph =
  trans (hexControlGlyph (primNatToChar 0) refl refl)
        (cong (λ nibble → "\\x" ++ˢ fromList (nibble ∷ (nibble ∷ []))) (decimalNibble 0 refl))

nulFixture : readDocument (fromList ([ primNatToChar 0 ])) ≡ rejected "invalid character '\\x00' looking for beginning of value"
nulFixture =
  trans (firstDocumentFault ([ primNatToChar 0 ]) (unexpected (primNatToChar 0) valueStart)
           (unexpectedStart maxNesting (primNatToChar 0) [] nulIsUnexpected))
        (cong rejected
          (trans (invalidMessage (primNatToChar 0) valueStart)
                 (trans (cong (λ glyph → "invalid character '" ++ˢ (glyph ++ˢ ("'" ++ˢ contextText valueStart))) nulGlyph)
                        (cong (λ suffix → "invalid character '\\x00'" ++ˢ suffix) startingValueMessage))))

documentFields : Document → List (String × Json)
documentFields doc with doc
... | parsed (jsonObject fields) = fields
... | _ = []

observedDuplicates : List (String × Json) → Set
observedDuplicates xs with xs
... | fs =
  (matchingValues "a" fs ≡ (jsonObject (("y" , jsonNumber "2") ∷ []) ∷ [])) ×
  (matchingValues "b" fs ≡ (jsonNumber "1" ∷ []))

decodedFromExample : (fs : List (String × Json)) →
  readDocument "{\"a\":{\"x\":1},\"a\":{\"y\":2},\"\\u0062\":0,\"b\":1}" ≡ parsed (jsonObject fs) →
  Grammar.RepeatedKeys grammarComparison grammarLayout jsonConstructors → observedDuplicates fs
decodedFromExample fs observed (Grammar.repeatedKeys chosen prefixProof latestA latestB) =
  subst observedDuplicates
    (cong documentFields
      (trans (sym (firstDocumentFound
                     (toList "{\"a\":{\"x\":1},\"a\":{\"y\":2},\"\\u0062\":0,\"b\":1}")
                     (jsonObject chosen) []
                     (trans (rootDepth (toList "{\"a\":{\"x\":1},\"a\":{\"y\":2},\"\\u0062\":0,\"b\":1}"))
                            (cong fromPrefix prefixProof))))
             observed))
    (latestA , latestB)

decodedDuplicateFixture : (fs : _) → (readDocument "{\"a\":{\"x\":1},\"a\":{\"y\":2},\"\\u0062\":0,\"b\":1}" ≡ parsed (jsonObject fs)) → (matchingValues "a" fs ≡ (jsonObject (("y" , jsonNumber "2") ∷ []) ∷ [])) × (matchingValues "b" fs ≡ (jsonNumber "1" ∷ []))
decodedDuplicateFixture fs observed =
  decodedFromExample fs observed (Grammar.repeatedKeyExample grammarComparison grammarLayout jsonConstructors)

surrogateFixture : readDocument "[\"\\uD83D\\uDE00\",\"\\uD800\",\"\\uDC00\",\"\\uD800\\u0041\",\"a\\/b\"]" ≡ parsed (jsonArray (jsonText (fromList ([ primNatToChar 128512 ])) ∷ (jsonText (fromList ([ primNatToChar 65533 ])) ∷ (jsonText (fromList ([ primNatToChar 65533 ])) ∷ (jsonText (fromList (primNatToChar 65533 ∷ ([ 'A' ]))) ∷ ([ jsonText "a/b" ]))))))
surrogateFixture =
  firstDocumentFound (toList "[\"\\uD83D\\uDE00\",\"\\uD800\",\"\\uDC00\",\"\\uD800\\u0041\",\"a\\/b\"]")
    (jsonArray (jsonText (fromList ([ primNatToChar 128512 ])) ∷
     (jsonText (fromList ([ primNatToChar 65533 ])) ∷ (jsonText (fromList ([ primNatToChar 65533 ])) ∷
      (jsonText (fromList (primNatToChar 65533 ∷ ([ 'A' ]))) ∷ ([ jsonText "a/b" ]))))))
    [] (trans (rootDepth (toList "[\"\\uD83D\\uDE00\",\"\\uD800\",\"\\uDC00\",\"\\uD800\\u0041\",\"a\\/b\"]"))
              (cong fromPrefix (Grammar.surrogateExample grammarComparison grammarLayout jsonConstructors)))

strictTailFixture : strictDocument (toList "[[\"a\"],1][[\"b\"],2]") ≡ rejected "invalid character '[' after top-level value"
strictTailFixture =
  trans (strictDocumentTrailing
           (toList "[[\"a\"],1][[\"b\"],2]") (jsonArray (jsonArray ([ jsonText "a" ]) ∷ ([ jsonNumber "1" ])))
           (toList "[[\"b\"],2]") '[' (toList "[\"b\"],2]")
           (trans (rootDepth (toList "[[\"a\"],1][[\"b\"],2]"))
                  (cong fromPrefix (Grammar.nestedExample grammarComparison grammarLayout jsonConstructors)))
           (keepNonspace '[' (toList "[\"b\"],2]") refl))
        (cong rejected (printableFault '[' afterDocument " after top-level value" refl refl refl trailingMessage))

strictBlankFixture : strictDocument (toList " \r	") ≡ rejected "unexpected end of JSON input"
strictBlankFixture =
  strictDocumentMissing (toList " \r	")
    (trans (leadingSpace maxNesting ' ' ('\r' ∷ ([ '	' ])) refl)
      (trans (leadingSpace maxNesting '\r' ([ '	' ]) refl)
        (trans (leadingSpace maxNesting '	' [] refl) (emptyPrefix maxNesting))))

trueDocument : (xs : List Char) → firstDocument ('t' ∷ ('r' ∷ ('u' ∷ ('e' ∷ xs)))) ≡ parsed (jsonBool true)
trueDocument xs =
  firstDocumentFound ('t' ∷ ('r' ∷ ('u' ∷ ('e' ∷ xs)))) (jsonBool true) xs
    (trans (truePrefix maxNesting ('r' ∷ ('u' ∷ ('e' ∷ xs))))
      (trans (wordMatched (jsonBool true) "true" 'r' ('u' ∷ ([ 'e' ])) ('u' ∷ ('e' ∷ xs)))
        (trans (wordMatched (jsonBool true) "true" 'u' ([ 'e' ]) ('e' ∷ xs))
          (trans (wordMatched (jsonBool true) "true" 'e' [] xs)
                 (wordComplete (jsonBool true) "true" xs)))))

quotedLineFits : (byteCount (toList "\"a\r") <ᵇ frameLimit) ≡ true
quotedLineFits rewrite lineBufferCapacity = refl

trueLineFits : (byteCount (toList "true") <ᵇ frameLimit) ≡ true
trueLineFits rewrite lineBufferCapacity = refl

nullLineFits : (byteCount (toList "null") <ᵇ frameLimit) ≡ true
nullLineFits rewrite lineBufferCapacity = refl

blankLineFits : (byteCount [] <ᵇ frameLimit) ≡ true
blankLineFits rewrite lineBufferCapacity = refl

twoValuesFit : (byteCount (toList "true null") <ᵇ frameLimit) ≡ true
twoValuesFit rewrite lineBufferCapacity = refl

quotedCRLFFixture : readStream "\"a\r\n" ≡ streamReply 3 [] "failed to form statements: unexpected EOF\n"
quotedCRLFFixture =
  streamReadMalformed "\"a\r\n" ([ toList "\"a" ]) false [] "unexpected EOF"
    (terminatedLine (toList "\"a\r") [] [] false refl quotedLineFits noPhysicalLines)
    (decodeUntilFault (toList "\"a") [] "unexpected EOF"
      (trans (firstDocumentFault (toList "\"a") incompleteDocument
                (stringValueError maxNesting ([ 'a' ]) incompleteDocument
                  (bodyAfterCharacterError 'a' [] incompleteDocument refl refl bodyUnclosed)))
             (cong rejected incompleteMessage)))

oneValueOnLineFixture : readStream "true null\n" ≡ streamReply 0 (jsonBool true ∷ []) ""
oneValueOnLineFixture =
  streamReadComplete "true null\n" ([ toList "true null" ]) ([ jsonBool true ])
    (terminatedLine (toList "true null") [] [] false refl twoValuesFit noPhysicalLines)
    (decodeNextLine (toList "true null") [] (jsonBool true) [] nothing
      (trueDocument (toList " null")) decodeWithoutLines)

blankLineStopsFixture : readStream "true\n\nnull\n" ≡ streamReply 3 (jsonBool true ∷ []) "failed to form statements: EOF\n"
blankLineStopsFixture =
  streamReadMalformed "true\n\nnull\n" (toList "true" ∷ ([] ∷ ([ toList "null" ])))
    false ([ jsonBool true ]) "EOF"
    (terminatedLine (toList "true") (toList "\nnull\n") ([] ∷ ([ toList "null" ]))
      false refl trueLineFits
      (terminatedLine [] (toList "null\n") ([ toList "null" ]) false refl blankLineFits
        (terminatedLine (toList "null") [] [] false refl nullLineFits noPhysicalLines)))
    (decodeNextLine (toList "true") ([] ∷ ([ toList "null" ])) (jsonBool true) [] (just "EOF")
      (trueDocument [])
      (decodeUntilFault [] ([ toList "null" ]) "EOF"
        (trans (firstDocumentFault [] missingDocument (emptyPrefix maxNesting))
               (cong rejected missingMessage))))


```
