(submission (kind plan)
  (why "把字符和字符串原语与标准库判定的一致性列为待证子接口，并从这两条等式导出四条锁定定律")
  (main @main)
  (subspecs ("Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement" @agreement))
  (moves
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.answer"))
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.answer-sound"))
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.answer-complete"))
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.char-native"))
    (move bot (unit "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.string-native"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.char-agrees"))
    (move bot (ext "Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.string-agrees"))))
