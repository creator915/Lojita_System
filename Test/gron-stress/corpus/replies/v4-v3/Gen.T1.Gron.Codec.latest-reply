     "⁔⁔⃥゙゚⵿⵿〪〯⃐⃜⃡⃡⃰⳯⳱ⷠⷿ꘠꘩꙯꙯ꙴ꙽ꚞꚟ꛰꛱ꠂꠂ꠆꠆ꠋꠋꠣꠧ꠬꠬ꢀꢁꢴꣅ꣐꣙꣠꣱ꣿ꤉ꤦ꤭" ++ˢ
     "ꥇ꥓ꦀꦃ꦳꧀꧐꧙ꧥꧥ꧰꧹ꨩꨶꩃꩃꩌꩍ꩐꩙ꩻꩽꪴꪰꪰꪲꪷꪸꪾ꪿꫁꫁ꫫꫯꫵ꫶ꯣꯪ꯬꯭꯰꯹ﬞﬞ︀️︠︯︳︴" ++ˢ
     "﹍﹏０９＿＿𐇽𐇽𐋠𐋠𐍶𐍺𐒠𐒩𐨁𐨃𐨅𐨆𐨌𐨿𐨿𐨺𐫦𐨏𐨸𐫥𐴤𐴧𐴰𐴹𐵀𐵉𐵩𐵭𐺫𐺬𐻺𐻿𐽆𐽐𐾅𐾂𑀀𑀂𑀸𑁆𑁦𑁰𑁳𑁴" ++ˢ
     "𑁿𑂂𑂰𑂺𑃂𑃂𑃰𑃹𑄀𑄂𑄧𑄴𑄶𑄿𑅅𑅆𑅳𑅳𑆀𑆂𑆳𑇀𑇉𑇌𑇎𑇙𑈬𑈷𑈾𑈾𑉁𑉁𑋟𑋪𑋰𑋹𑌀𑌃𑌻𑌼𑌾𑍄𑍇𑍈𑍋𑍍𑍗𑍗𑍢𑍣" ++ˢ
     "𑍦𑍬𑍰𑍴𑎸𑏀𑏅𑏅𑏅𑏇𑏊𑏌𑏐𑏒𑏒𑏡𑏢𑐵𑑆𑑐𑑙𑑞𑑞𑒰𑓃𑓐𑓙𑖯𑖵𑖸𑗀𑗜𑗝𑘰𑙀𑙐𑙙𑚫𑚷𑛀𑛉𑛐𑛣𑜝𑜫𑜰𑜹𑠬𑠺" ++ˢ
     "𑣠𑣩𑤰𑤵𑤷𑤸𑤻𑤾𑥀𑥀𑥂𑥃𑥐𑥙𑧑𑧗𑧚𑧠𑧤𑧤𑨁𑨊𑨳𑨹𑨻𑨾𑩇𑩇𑩑𑩛𑪊𑪙𑭠𑭧𑯰𑯹𑰯𑰶𑰸𑰿𑱐𑱙𑲒𑲧𑲩𑲶𑴱𑴶𑴺𑴺" ++ˢ
     "𑴼𑴽𑴿𑵅𑵇𑵇𑵐𑵙𑶊𑶎𑶐𑶑𑶓𑶗𑶠𑶩𑷠𑷩𑻳𑻶𑼀𑼁𑼃𑼃𑼴𑼺𑼾𑽂𑽐𑽚𓑀𓑀𓑇𓑕𖄞𖄹𖩠𖩩𖫀𖫉𖫰𖫴𖬰𖬶𖭐𖭙𖵰𖵹𖽏𖽏" ++ˢ
     "𖽑𖾇𖾏𖾒𖿤𖿤𖿰𖿱𛲝𛲞𜳰𜳹𜼀𜼭𜼰𜽆𝅩𝅥𝅲𝅻𝆂𝆋𝅭𝆅𝆪𝆭𝉂𝉄𝟎𝟿𝨀𝨶𝨻𝩬𝩵𝩵𝪄𝪄𝪛𝪟𝪡𝪯𞀀𞀆𞀈𞀘𞀛𞀡𞀣𞀤" ++ˢ
     "𞀦𞀪𞂏𞂏𞄰𞄶𞅀𞅉𞊮𞊮𞋬𞋹𞓬𞓹𞗯𞗮𞗱𞗺𞛣𞛣𞛦𞛦𞛮𞛯𞛵𞛵𞥊𞣐𞣖𞥄𞥐𞥙🯰🯹󠄀󠇯")

  inRanges : ℕ → List Char → Bool
  inRanges n [] = false
  inRanges n (lo ∷ []) = false
  inRanges n (lo ∷ hi ∷ more) =
    if n <ᵇ toℕ lo then false else
    if toℕ hi <ᵇ n then inRanges n more else true

  asciiHead : ℕ → Bool
  asciiHead n =
    (n ≡ᵇ 36) ∨ (n ≡ᵇ 95) ∨ ((64 <ᵇ n) ∧ (n <ᵇ 91)) ∨ ((96 <ᵇ n) ∧ (n <ᵇ 123))

canStart : Char → Bool
canStart c =
  if toℕ c <ᵇ 128 then asciiHead (toℕ c) else inRanges (toℕ c) letterRanges

canContinue : Char → Bool
canContinue c =
  canStart c ∨ (if toℕ c <ᵇ 128 then digitCode (toℕ c) else inRanges (toℕ c) continuationRanges)

reservedWords : List (List Char)
reservedWords = map toList
  ("break" ∷ "case" ∷ "catch" ∷ "class" ∷ "const" ∷ "continue" ∷ "debugger" ∷
   "default" ∷ "delete" ∷ "do" ∷ "else" ∷ "export" ∷ "extends" ∷ "false" ∷
   "finally" ∷ "for" ∷ "function" ∷ "if" ∷ "import" ∷ "in" ∷ "instanceof" ∷
   "new" ∷ "null" ∷ "return" ∷ "super" ∷ "switch" ∷ "this" ∷ "throw" ∷
   "true" ∷ "try" ∷ "typeof" ∷ "var" ∷ "void" ∷ "while" ∷ "with" ∷ "yield" ∷ [])

private
  sameChars : List Char → List Char → Bool
  sameChars [] [] = true
  sameChars [] (d ∷ ds) = false
  sameChars (c ∷ cs) [] = false
  sameChars (c ∷ cs) (d ∷ ds) = decision (c Ch.≟ d) ∧ sameChars cs ds

  containsWord : List Char → List (List Char) → Bool
  containsWord w [] = false
  containsWord w (t ∷ ts) = sameChars w t ∨ containsWord w ts

  selfChars : ∀ cs → sameChars cs cs ≡ true
  selfChars [] = refl
  selfChars (c ∷ cs) =
    trans (cong (λ b → b ∧ sameChars cs cs) (decisionYes (c Ch.≟ c) refl)) (selfChars cs)

  decisionSound : {A : Set} → (d : Dec A) → decision d ≡ true → A
  decisionSound (yes v) p = v
  decisionSound (no _) ()

  andLeft : ∀ a b → a ∧ b ≡ true → a ≡ true
  andLeft true b p = refl
  andLeft false b ()

  andRight : ∀ a b → a ∧ b ≡ true → b ≡ true
  andRight true b p = p
  andRight false b ()

  charsSound : ∀ cs ds → sameChars cs ds ≡ true → cs ≡ ds
  charsSound [] [] ok = refl
  charsSound [] (d ∷ ds) ()
  charsSound (c ∷ cs) [] ()
  charsSound (c ∷ cs) (d ∷ ds) ok =
    let head = c Ch.≟ d
        tail = sameChars cs ds in
    trans (cong (λ x → x ∷ cs) (decisionSound head (andLeft (decision head) tail ok)))
          (cong (λ xs → d ∷ xs) (charsSound cs ds (andRight (decision head) tail ok)))

  orRight : ∀ b → b ∨ true ≡ true
  orRight true = refl
  orRight false = refl

  includesWord : ∀ {w ws} → Listed w ws → containsWord w ws ≡ true
  includesWord {w} (first {words}) =
    cong (λ b → b ∨ containsWord w words) (selfChars w)
  includesWord {w} (later {other} present) =
    trans (cong (λ b → sameChars w other ∨ b) (includesWord present))
          (orRight (sameChars w other))

  falseUnless : ∀ b → (b ≡ true → ⊥) → b ≡ false
  falseUnless false absent = refl
  falseUnless true absent = ⊥-elim (absent refl)

  firstIfSame : ∀ {w t ts} → w ≡ t → Listed w (t ∷ ts)
  firstIfSame refl = first

  excludesWord : ∀ w ws → (Listed w ws → ⊥) → containsWord w ws ≡ false
  excludesWord w [] absent = refl
  excludesWord w (t ∷ ts) absent =
    trans (cong (λ b → b ∨ containsWord w ts)
              (falseUnless (sameChars w t) (λ ok → absent (firstIfSame (charsSound w t ok)))))
          (excludesWord w ts (λ hit → absent (later hit)))

reserved : List Char → Bool
reserved w = containsWord w reservedWords

identifier : List Char → Bool
identifier [] = false
identifier (c ∷ cs) = canStart c ∧ all canContinue cs ∧ not (reserved (c ∷ cs))

asciiStart : ∀ c → (toℕ c <ᵇ 128) ≡ true → canStart c ≡
  ((toℕ c ≡ᵇ 36) ∨ (toℕ c ≡ᵇ 95) ∨
   ((64 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 91)) ∨ ((96 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 123)))
asciiStart c isAscii =
  cong (λ b → if b then asciiHead (toℕ c) else inRanges (toℕ c) letterRanges) isAscii

asciiContinue : ∀ c → (toℕ c <ᵇ 128) ≡ true → canContinue c ≡
  (canStart c ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58)))
asciiContinue c isAscii =
  cong (λ b → canStart c ∨ (if b then digitCode (toℕ c) else inRanges (toℕ c) continuationRanges)) isAscii

reservedIncluded : ∀ w → Listed w reservedWords → reserved w ≡ true
reservedIncluded w = includesWord

reservedExcluded : ∀ w → (Listed w reservedWords → ⊥) → reserved w ≡ false
reservedExcluded w = excludesWord w reservedWords

emptyIdentifier : identifier [] ≡ false
emptyIdentifier = refl

identifierForm : ∀ c cs → identifier (c ∷ cs) ≡ (canStart c ∧ all canContinue cs ∧ not (reserved (c ∷ cs)))
identifierForm c cs = refl

observedReservedWords : reservedWords ≡ map toList
  ("break" ∷ "case" ∷ "catch" ∷ "class" ∷ "const" ∷ "continue" ∷ "debugger" ∷
   "default" ∷ "delete" ∷ "do" ∷ "else" ∷ "export" ∷ "extends" ∷ "false" ∷
   "finally" ∷ "for" ∷ "function" ∷ "if" ∷ "import" ∷ "in" ∷ "instanceof" ∷
   "new" ∷ "null" ∷ "return" ∷ "super" ∷ "switch" ∷ "this" ∷ "throw" ∷
   "true" ∷ "try" ∷ "typeof" ∷ "var" ∷ "void" ∷ "while" ∷ "with" ∷ "yield" ∷ [])
observedReservedWords = refl

private
  upperHex : ℕ → Char
  upperHex n = fromℕ (if n <ᵇ 10 then 48 + n else 55 + n)

  hexByte : ℕ → List Char
  hexByte n = upperHex (n / 16) ∷ upperHex (n % 16) ∷ []

  unicodeEscape : Char → List Char
  unicodeEscape c =
    let n = toℕ c in '\\' ∷ 'u' ∷ (hexByte (n / 256) ++ hexByte (n % 256))

  controlEscape : Char → List Char
  controlEscape '\t' = '\\' ∷ 't' ∷ []
  controlEscape '\n' = '\\' ∷ 'n' ∷ []
  controlEscape '\r' = '\\' ∷ 'r' ∷ []
  controlEscape c =
    if toℕ c ≡ᵇ 8 then '\\' ∷ 'b' ∷ [] else
    if toℕ c ≡ᵇ 12 then '\\' ∷ 'f' ∷ [] else unicodeEscape c

  specialEscape : Char → List Char
  specialEscape '"' = '\\' ∷ '"' ∷ []
  specialEscape '\\' = '\\' ∷ '\\' ∷ []
  specialEscape c = unicodeEscape c

  specialCode : ℕ → Bool
  specialCode n = (n ≡ᵇ 34) ∨ (n ≡ᵇ 92) ∨ (n ≡ᵇ 8232) ∨ (n ≡ᵇ 8233)

  escapeByClass : Char → Bool → Bool → Bool → List Char
  escapeByClass c false outside special = controlEscape c
  escapeByClass c true false special = unicodeEscape c
  escapeByClass c true true true = specialEscape c
  escapeByClass c true true false = c ∷ []

escapeChar : Char → List Char
escapeChar c =
  let n = toℕ c in
  escapeByClass c (31 <ᵇ n) ((n <ᵇ 127) ∨ (159 <ᵇ n)) (specialCode n)

escapeBody : List Char → List Char
escapeBody [] = []
escapeBody (c ∷ cs) = escapeChar c ++ escapeBody cs

quoteForward : String → String
quoteForward s = fromList ('"' ∷ (escapeBody (toList s) ++ ('"' ∷ [])))

escapeBodyEmpty : escapeBody [] ≡ []
escapeBodyEmpty = refl

escapeBodyNext : ∀ c cs → escapeBody (c ∷ cs) ≡ escapeChar c ++ escapeBody cs
escapeBodyNext c cs = refl

private
  literalCase : ∀ c {above outside special} → above ≡ true → outside ≡ true → special ≡ false →
    escapeByClass c above outside special ≡ c ∷ []
  literalCase c {above} {outside} {special} aboveOK outsideOK specialOK =
    trans (cong (λ b → escapeByClass c b outside special) aboveOK)
      (trans (cong (λ b → escapeByClass c true b special) outsideOK)
             (cong (escapeByClass c true true) specialOK))

literalChar : ∀ c → (31 <ᵇ toℕ c) ≡ true →
  ((toℕ c <ᵇ 127) ∨ (159 <ᵇ toℕ c)) ≡ true →
  ((toℕ c ≡ᵇ 34) ∨ (toℕ c ≡ᵇ 92) ∨ (toℕ c ≡ᵇ 8232) ∨ (toℕ c ≡ᵇ 8233)) ≡ false →
  escapeChar c ≡ c ∷ []
literalChar c = literalCase c

quoteShape : ∀ s → quoteForward s ≡ fromList ('"' ∷ (escapeBody (toList s) ++ ('"' ∷ [])))
quoteShape s = refl

csi : String
csi = fromList (fromℕ 27 ∷ '[' ∷ [])

csiPrefix : csi ≡ fromList (fromℕ 27 ∷ '[' ∷ [])
csiPrefix = refl

paint : Bool → Shade → String → String
paint false hue s = s
paint true name s = csi ++ˢ "34;1m" ++ˢ s ++ˢ csi ++ˢ "0;22m"
paint true container s = csi ++ˢ "35m" ++ˢ s ++ˢ csi ++ˢ "0m"
paint true numeral s = csi ++ˢ "31m" ++ˢ s ++ˢ csi ++ˢ "0m"
paint true quoted s = csi ++ˢ "33m" ++ˢ s ++ˢ csi ++ˢ "0m"
paint true constant s = csi ++ˢ "36m" ++ˢ s ++ˢ csi ++ˢ "0m"

paintPlain : ∀ hue s → paint false hue s ≡ s
paintPlain hue s = refl

paintName : ∀ s → paint true name s ≡ csi ++ˢ "34;1m" ++ˢ s ++ˢ csi ++ˢ "0;22m"
paintName s = refl

paintContainer : ∀ s → paint true container s ≡ csi ++ˢ "35m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintContainer s = refl

paintNumeral : ∀ s → paint true numeral s ≡ csi ++ˢ "31m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintNumeral s = refl

paintQuoted : ∀ s → paint true quoted s ≡ csi ++ˢ "33m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintQuoted s = refl

paintConstant : ∀ s → paint true constant s ≡ csi ++ˢ "36m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintConstant s = refl

renderPayload : Bool → Payload → String
renderPayload c (atom null) = paint c constant "null"
renderPayload c (atom (boolean true)) = paint c constant "true"
renderPayload c (atom (boolean false)) = paint c constant "false"
renderPayload c (atom (number n)) = paint c numeral n
renderPayload c (atom (text s)) = paint c quoted (quoteForward s)
renderPayload c arrayMark = paint c container "[]"
renderPayload c objectMark = paint c container "{}"

payloadNull : ∀ c → renderPayload c (atom null) ≡ paint c constant "null"
payloadNull c = refl

payloadTrue : ∀ c → renderPayload c (atom (boolean true)) ≡ paint c constant "true"
payloadTrue c = refl

payloadFalse : ∀ c → renderPayload c (atom (boolean false)) ≡ paint c constant "false"
payloadFalse c = refl

payloadNumber : ∀ c n → renderPayload c (atom (number n)) ≡ paint c numeral n
payloadNumber c n = refl

payloadText : ∀ c s → renderPayload c (atom (text s)) ≡ paint c quoted (quoteForward s)
payloadText c s = refl

payloadArray : ∀ c → renderPayload c arrayMark ≡ paint c container "[]"
payloadArray c = refl

payloadObject : ∀ c → renderPayload c objectMark ≡ paint c container "{}"
payloadObject c = refl

private
  renderProperty : Bool → String → Bool → String
  renderProperty c k true = "." ++ˢ paint c name k
  renderProperty c k false =
    paint c container "[" ++ˢ paint c quoted (quoteForward k) ++ˢ paint c container "]"

assignmentPart : Bool → Segment → String
assignmentPart c (property k) = renderProperty c k (identifier (toList k))
assignmentPart c (index i) =
  paint c container "[" ++ˢ paint c numeral (Nat.show i) ++ˢ paint c container "]"

assignmentSuffix : Bool → List Segment → String
assignmentSuffix c [] = ""
assignmentSuffix c (p ∷ ps) = assignmentPart c p ++ˢ assignmentSuffix c ps

assignmentDotted : ∀ c k → identifier (toList k) ≡ true →
  assignmentPart c (property k) ≡ "." ++ˢ paint c name k
assignmentDotted c k allowed = cong (renderProperty c k) allowed

assignmentBracketed : ∀ c k → identifier (toList k) ≡ false →
  assignmentPart c (property k) ≡ paint c container "[" ++ˢ paint c quoted (quoteForward k) ++ˢ paint c container "]"
assignmentBracketed c k quotedKey = cong (renderProperty c k) quotedKey

assignmentIndex : ∀ c i →
  assignmentPart c (index i) ≡ paint c container "[" ++ˢ paint c numeral (Nat.show i) ++ˢ paint c container "]"
assignmentIndex c i = refl

assignmentSuffixEmpty : ∀ c → assignmentSuffix c [] ≡ ""
assignmentSuffixEmpty c = refl

assignmentSuffixNext : ∀ c p ps → assignmentSuffix c (p ∷ ps) ≡ assignmentPart c p ++ˢ assignmentSuffix c ps
assignmentSuffixNext c p ps = refl

pairPart : Bool → Segment → String
pairPart c (property k) = paint c quoted (quoteForward k)
pairPart c (index i) = paint c numeral (Nat.show i)

private
  joinParts : String → List Segment → String → String
  joinParts front [] tail = front
  joinParts front (p ∷ ps) tail = front ++ˢ "," ++ˢ tail

pairParts : Bool → List Segment → String
pairParts c [] = ""
pairParts c (p ∷ ps) = joinParts (pairPart c p) ps (pairParts c ps)

pairProperty : ∀ c k → pairPart c (property k) ≡ paint c quoted (quoteForward k)
pairProperty c k = refl

pairIndex : ∀ c i → pairPart c (index i) ≡ paint c numeral (Nat.show i)
pairIndex c i = refl

pairPartsEmpty : ∀ c → pairParts c [] ≡ ""
pairPartsEmpty c = refl

pairPartsSingle : ∀ c p → pairParts c (p ∷ []) ≡ pairPart c p
pairPartsSingle c p = refl

pairPartsNext : ∀ c p q ps → pairParts c (p ∷ q ∷ ps) ≡ pairPart c p ++ˢ "," ++ˢ pairParts c (q ∷ ps)
pairPartsNext c p q ps = refl

renderLine : Notation → Bool → Statement → String
renderLine assignments c (assignment ps r) =
  paint c name "json" ++ˢ assignmentSuffix c ps ++ˢ " = " ++ˢ renderPayload c r ++ˢ ";\n"
renderLine pairs c (assignment ps r) =
  paint c container "[" ++ˢ paint c container "[" ++ˢ pairParts c ps ++ˢ paint c container "]" ++ˢ
  "," ++ˢ renderPayload c r ++ˢ paint c container "]" ++ˢ "\n"

renderAssignment : ∀ c ps r → renderLine assignments c (assignment ps r) ≡
  paint c name "json" ++ˢ assignmentSuffix c ps ++ˢ " = " ++ˢ renderPayload c r ++ˢ ";\n"
renderAssignment c ps r = refl

renderPair : ∀ c ps r → renderLine pairs c (assignment ps r) ≡
  paint c container "[" ++ˢ paint c container "[" ++ˢ pairParts c ps ++ˢ paint c container "]" ++ˢ
  "," ++ˢ renderPayload c r ++ˢ paint c container "]" ++ˢ "\n"
renderPair c ps r = refl

observedColor : renderLine pairs true (assignment [] (atom (boolean true))) ≡
  csi ++ˢ "35m[" ++ˢ csi ++ˢ "0m" ++ˢ csi ++ˢ "35m[" ++ˢ csi ++ˢ "0m" ++ˢ
  csi ++ˢ "35m]" ++ˢ csi ++ˢ "0m," ++ˢ csi ++ˢ "36mtrue" ++ˢ csi ++ˢ "0m" ++ˢ
  csi ++ˢ "35m]" ++ˢ csi ++ˢ "0m\n"
observedColor = refl

compareText : List Char → List Char → Ordering
compareText [] [] = equal
compareText [] (c ∷ cs) = before
compareText (c ∷ cs) [] = after
compareText (c ∷ cs) (d ∷ ds) =
  if toℕ c <ᵇ toℕ d then before else if toℕ d <ᵇ toℕ c then after else compareText cs ds

compareEmpty : compareText [] [] ≡ equal
compareEmpty = refl

compareLeftEmpty : ∀ c cs → compareText [] (c ∷ cs) ≡ before
compareLeftEmpty c cs = refl

compareRightEmpty : ∀ c cs → compareText (c ∷ cs) [] ≡ after
compareRightEmpty c cs = refl

compareNext : ∀ c cs d ds → compareText (c ∷ cs) (d ∷ ds) ≡
  (if toℕ c <ᵇ toℕ d then before else if toℕ d <ᵇ toℕ c then after else compareText cs ds)
compareNext c cs d ds = refl

private
  placeKey : {V : Set} → (String × V) → (String × V) → List (String × V) →
    List (String × V) → Ordering → List (String × V)
  placeKey kv jw xs added before = kv ∷ jw ∷ xs
  placeKey kv jw xs added equal = kv ∷ jw ∷ xs
  placeKey kv jw xs added after = jw ∷ added

insertKey : {V : Set} → (String → List Char) → (String × V) → List (String × V) → List (String × V)
insertKey rank kv [] = kv ∷ []
insertKey rank kv (jw ∷ xs) =
  placeKey kv jw xs (insertKey rank kv xs) (compareText (rank (proj₁ kv)) (rank (proj₁ jw)))

orderKeys : {V : Set} → (String → List Char) → List (String × V) → List (String × V)
orderKeys rank [] = []
orderKeys rank (kv ∷ xs) = insertKey rank kv (orderKeys rank xs)

insertEmpty : {V : Set} → ∀ rank kv → insertKey {V} rank kv [] ≡ kv ∷ []
insertEmpty rank kv = refl

insertBefore : {V : Set} → ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ before →
  insertKey {V} rank (k , v) ((j , w) ∷ xs) ≡ (k , v) ∷ (j , w) ∷ xs
insertBefore rank k v j w xs ordered =
  cong (placeKey (k , v) (j , w) xs (insertKey rank (k , v) xs)) ordered

insertEqual : {V : Set} → ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ equal →
  insertKey {V} rank (k , v) ((j , w) ∷ xs) ≡ (k , v) ∷ (j , w) ∷ xs
insertEqual rank k v j w xs ordered =
  cong (placeKey (k , v) (j , w) xs (insertKey rank (k , v) xs)) ordered

insertAfter : {V : Set} → ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ after →
  insertKey {V} rank (k , v) ((j , w) ∷ xs) ≡ (j , w) ∷ insertKey rank (k , v) xs
insertAfter rank k v j w xs ordered =
  cong (placeKey (k , v) (j , w) xs (insertKey rank (k , v) xs)) ordered

orderKeysEmpty : {V : Set} → ∀ rank → orderKeys {V} rank [] ≡ []
orderKeysEmpty rank = refl

orderKeysNext : {V : Set} → ∀ rank kv xs → orderKeys {V} rank (kv ∷ xs) ≡ insertKey rank kv (orderKeys rank xs)
orderKeysNext rank kv xs = refl

private
  assignmentRank : String → List Char
  assignmentRank key = toList (assignmentPart false (property key))

  sortedNames : {V : Set} → (dollar nested upper : V) →
    orderKeys assignmentRank (("a$" , dollar) ∷ ("a" , nested) ∷ ("A" , upper) ∷ []) ≡
    (("A" , upper) ∷ ("a" , nested) ∷ ("a$" , dollar) ∷ [])
  sortedNames dollar nested upper = refl

  sortedThroughDash : {V : Set} → (dash dollar nested upper : V) →
    orderKeys assignmentRank (("-" , dash) ∷ ("a$" , dollar) ∷ ("a" , nested) ∷ ("A" , upper) ∷ []) ≡
    (("A" , upper) ∷ ("a" , nested) ∷ ("a$" , dollar) ∷ ("-" , dash) ∷ [])
  sortedThroughDash dash dollar nested upper =
    trans (cong (insertKey assignmentRank ("-" , dash)) (sortedNames dollar nested upper)) refl

  sortedThroughBang : {V : Set} → (bang dash dollar nested upper : V) →
    orderKeys assignmentRank (("-!" , bang) ∷ ("-" , dash) ∷ ("a$" , dollar) ∷ ("a" , nested) ∷ ("A" , upper) ∷ []) ≡
    (("A" , upper) ∷ ("a" , nested) ∷ ("a$" , dollar) ∷ ("-!" , bang) ∷ ("-" , dash) ∷ [])
  sortedThroughBang bang dash dollar nested upper =
    trans (cong (insertKey assignmentRank ("-!" , bang)) (sortedThroughDash dash dollar nested upper)) refl

  sortedThroughSpace : {V : Set} → (space bang dash dollar nested upper : V) →
    orderKeys assignmentRank (("- " , space) ∷ ("-!" , bang) ∷ ("-" , dash) ∷ ("a$" , dollar) ∷ ("a" , nested) ∷ ("A" , upper) ∷ []) ≡
    (("A" , upper) ∷ ("a" , nested) ∷ ("a$" , dollar) ∷ ("- " , space) ∷ ("-!" , bang) ∷ ("-" , dash) ∷ [])
  sortedThroughSpace space bang dash dollar nested upper =
    trans (cong (insertKey assignmentRank ("- " , space)) (sortedThroughBang bang dash dollar nested upper)) refl

sortedKeyOrder : {V : Set} → (question space bang dash dollar nested upper : V) →
  orderKeys (λ key → toList (assignmentPart false (property key)))
    (("-?" , question) ∷ ("- " , space) ∷ ("-!" , bang) ∷ ("-" , dash) ∷ ("a$" , dollar) ∷ ("a" , nested) ∷ ("A" , upper) ∷ []) ≡
  (("A" , upper) ∷ ("a" , nested) ∷ ("a$" , dollar) ∷ ("- " , space) ∷ ("-!" , bang) ∷ ("-" , dash) ∷ ("-?" , question) ∷ [])
sortedKeyOrder question space bang dash dollar nested upper =
  trans (cong (insertKey assignmentRank ("-?" , question)) (sortedThroughSpace space bang dash dollar nested upper)) refl

duplicateKeyOrder : {V : Set} → (a b : V) →
  orderKeys (λ key → toList (assignmentPart false (property key))) (("a" , a) ∷ ("b" , b) ∷ []) ≡
  (("a" , a) ∷ ("b" , b) ∷ [])
duplicateKeyOrder a b = refl

