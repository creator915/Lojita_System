  report "json = [];\njson[0] = \"λ<&>\\u2028\";\njson[1] = {};\n" nothing
observedSeed =
  forwardShows (config assignments false sorted) _ _ [] _ decodedSeed
    (renderAt (config assignments false sorted) [] _ _ _ seedArrangement drawnSeed)

observedNumber : forward (config assignments false sorted) (toList "-94.00e+2") ≡
  report "json = -94.00e+2;\n" nothing
observedNumber =
  forwardShows (config assignments false sorted) _ _ [] _ decodedNumber
    (renderAt (config assignments false sorted) [] _ _ _ (arrangedScalar (B.number "-94.00e+2")) drawnNumber)

observedStreamPrefix : forwardStream (config pairs false sorted) (toList " 12xyz" ∷ toList "true false" ∷ []) ≡
  report "[[],[]]\n[[0],12]\n[[1],true]\n" nothing
observedStreamPrefix =
  streamShowsRoot (config pairs false sorted) (toList " 12xyz" ∷ toList "true false" ∷ [])
    "[[0],12]\n[[1],true]\n" nothing "[[],[]]\n" pairOpening
    (streamShowsNext (config pairs false sorted) 0 (toList " 12xyz") (toList "true false" ∷ [])
      (B.scalar (B.number "12")) (toList "xyz") "[[1],true]\n" "[[0],12]\n" nothing decodedStreamTwelve
      (renderAt (config pairs false sorted) (B.index 0 ∷ []) _ _ _ (arrangedScalar (B.number "12")) drawnStreamTwelve)
      (streamShowsNext (config pairs false sorted) 1 (toList "true false") []
        (B.scalar (B.boolean true)) (toList " false") "" "[[1],true]\n" nothing decodedStreamTrue
        (renderAt (config pairs false sorted) (B.index 1 ∷ []) _ _ _ (arrangedScalar (B.boolean true)) drawnStreamTrue)
        (streamDone (config pairs false sorted) 2)))

observedStreamBlank : forwardStream (config assignments false sorted) (toList "true" ∷ [] ∷ toList "false" ∷ []) ≡
  report "json = [];\njson[0] = true;\n" (just "EOF")
observedStreamBlank =
  streamShowsRoot (config assignments false sorted) (toList "true" ∷ [] ∷ toList "false" ∷ [])
    "json[0] = true;\n" (just "EOF") "json = [];\n" assignmentOpening
    (streamShowsNext (config assignments false sorted) 0 (toList "true") ([] ∷ toList "false" ∷ [])
      (B.scalar (B.boolean true)) [] "" "json[0] = true;\n" (just "EOF") decodedOnlyTrue
      (renderAt (config assignments false sorted) (B.index 0 ∷ []) _ _ _ (arrangedScalar (B.boolean true)) drawnOnlyTrue)
      (streamBad (config assignments false sorted) 1 [] (toList "false" ∷ []) "EOF" endOfInput))

