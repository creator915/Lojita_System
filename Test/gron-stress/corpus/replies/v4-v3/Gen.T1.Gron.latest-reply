```agda codec
module Gen.T1.Gron.Codec where

open import Data.Bool using (Bool; true; false; not; _∧_; _∨_; if_then_else_)
open import Data.Char using (Char; toℕ; fromℕ)
open import Data.List using (List; []; _∷_; _++_; all; map; foldr)
open import Data.Empty using (⊥)
open import Data.Nat using (ℕ; _<ᵇ_; _≡ᵇ_)
import Data.Nat.Show as Nat
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Data.String using (String; toList; fromList) renaming (_++_ to _++ˢ_)
open import Data.Sum using (_⊎_; inj₁; inj₂)
open import Relation.Binary.PropositionalEquality using (_≡_; _≢_)

data Notation : Set where
  assignments pairs : Notation

data Ordering : Set where
  before equal after : Ordering

data Shade : Set where
  name container numeral quoted constant : Shade

data Listed (word : List Char) : List (List Char) → Set where
  first : ∀ {words} → Listed word (word ∷ words)
  later : ∀ {other words} → Listed word words → Listed word (other ∷ words)

record Parsed (A : Set) : Set where
  constructor parsed
  field
    value : A
    rest : List Char

data Atom : Set where
  null : Atom
  boolean : Bool → Atom
  number text : String → Atom

data Value : Set where
  scalar : Atom → Value
  array : List Value → Value
  object : List (String × Value) → Value

data Segment : Set where
  property : String → Segment
  index : ℕ → Segment

data Payload : Set where
  atom : Atom → Payload
  arrayMark objectMark : Payload

record Statement : Set where
  constructor assignment
  field
    path : List Segment
    rhs : Payload

-- Decode one JSON value prefix with its suffix and original numeric spelling.
-- Decode UTF-16 escape pairs and replace lone surrogates with U+FFFD.
-- Validate every object member before keeping the last value for a decoded key.
postulate
  hasKey : {V : Set} → String → List (String × V) → Bool

  keepLatest : {V : Set} → List (String × V) → List (String × V)

  hasKeyEmpty : {V : Set} → ∀ k → hasKey {V} k [] ≡ false

  hasKeySame : {V : Set} → ∀ k v xs → hasKey {V} k ((k , v) ∷ xs) ≡ true

  hasKeyOther : {V : Set} → ∀ k j v xs → k ≢ j → hasKey {V} k ((j , v) ∷ xs) ≡ hasKey k xs

  keepLatestEmpty : {V : Set} → keepLatest {V} [] ≡ []

  keepLatestNext : {V : Set} → ∀ k v xs → keepLatest {V} ((k , v) ∷ xs) ≡
    (if hasKey k (keepLatest xs) then keepLatest xs else (k , v) ∷ keepLatest xs)

  keepLatestMap : {A D : Set} → (f : A → D) → (xs : List (String × A)) →
    map (λ kv → proj₁ kv , f (proj₂ kv)) (keepLatest xs) ≡
    keepLatest (map (λ kv → proj₁ kv , f (proj₂ kv)) xs)

  decodePrefix : List Char → String ⊎ Parsed Value

  decodeNumber : List Char → String ⊎ Parsed String

  decodeQuoted : List Char → String ⊎ Parsed String

  decodeElements : List Char → String ⊎ Parsed (List Value)

  decodeMembers : List Char → String ⊎ Parsed (List (String × Value))

  endOfInput : decodePrefix [] ≡ inj₁ "EOF"

  leadingSpace : ∀ xs → decodePrefix (' ' ∷ xs) ≡ decodePrefix xs

  leadingTab : ∀ xs → decodePrefix ('\t' ∷ xs) ≡ decodePrefix xs

  leadingCR : ∀ xs → decodePrefix ('\r' ∷ xs) ≡ decodePrefix xs

  leadingLF : ∀ xs → decodePrefix ('\n' ∷ xs) ≡ decodePrefix xs

  truePrefix : ∀ xs → decodePrefix ('t' ∷ 'r' ∷ 'u' ∷ 'e' ∷ xs) ≡ inj₂ (parsed (scalar (boolean true)) xs)

  falsePrefix : ∀ xs → decodePrefix ('f' ∷ 'a' ∷ 'l' ∷ 's' ∷ 'e' ∷ xs) ≡ inj₂ (parsed (scalar (boolean false)) xs)

  nullPrefix : ∀ xs → decodePrefix ('n' ∷ 'u' ∷ 'l' ∷ 'l' ∷ xs) ≡ inj₂ (parsed (scalar null) xs)

  closeQuote : ∀ xs → decodeQuoted ('"' ∷ xs) ≡ inj₂ (parsed "" xs)

  closeArray : ∀ xs → decodeElements (']' ∷ xs) ≡ inj₂ (parsed [] xs)

  closeObject : ∀ xs → decodeMembers ('}' ∷ xs) ≡ inj₂ (parsed [] xs)

  quotedPrefix : ∀ xs s rest → decodeQuoted xs ≡ inj₂ (parsed s rest) →
    decodePrefix ('"' ∷ xs) ≡ inj₂ (parsed (scalar (text s)) rest)

  quotedError : ∀ xs e → decodeQuoted xs ≡ inj₁ e → decodePrefix ('"' ∷ xs) ≡ inj₁ e

  numericPrefix : ∀ c xs s rest →
    ((toℕ c ≡ᵇ 45) ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58))) ≡ true →
    decodeNumber (c ∷ xs) ≡ inj₂ (parsed s rest) →
    decodePrefix (c ∷ xs) ≡ inj₂ (parsed (scalar (number s)) rest)

  numericError : ∀ c xs e →
    ((toℕ c ≡ᵇ 45) ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58))) ≡ true →
    decodeNumber (c ∷ xs) ≡ inj₁ e → decodePrefix (c ∷ xs) ≡ inj₁ e

  arrayPrefix : ∀ xs vs rest → decodeElements xs ≡ inj₂ (parsed vs rest) →
    decodePrefix ('[' ∷ xs) ≡ inj₂ (parsed (array vs) rest)

  arrayError : ∀ xs e → decodeElements xs ≡ inj₁ e → decodePrefix ('[' ∷ xs) ≡ inj₁ e

  objectPrefix : ∀ xs kvs rest → decodeMembers xs ≡ inj₂ (parsed kvs rest) →
    decodePrefix ('{' ∷ xs) ≡ inj₂ (parsed (object (keepLatest kvs)) rest)

  objectError : ∀ xs e → decodeMembers xs ≡ inj₁ e → decodePrefix ('{' ∷ xs) ≡ inj₁ e

-- Allow $, _, L and Nl at the start of an identifier, and Mn, Mc, Nd and Pc in continuations.
-- Escape C0, C1, DEL, U+2028 and U+2029 with uppercase hexadecimal digits where no short escape applies.
-- Keep slash and HTML characters literal.
postulate
  canStart : Char → Bool

  canContinue : Char → Bool

  reservedWords : List (List Char)

  reserved : List Char → Bool

  identifier : List Char → Bool

  asciiStart : ∀ c → (toℕ c <ᵇ 128) ≡ true → canStart c ≡
    ((toℕ c ≡ᵇ 36) ∨ (toℕ c ≡ᵇ 95) ∨
     ((64 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 91)) ∨ ((96 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 123)))

  asciiContinue : ∀ c → (toℕ c <ᵇ 128) ≡ true → canContinue c ≡
    (canStart c ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58)))

  reservedIncluded : ∀ w → Listed w reservedWords → reserved w ≡ true

  reservedExcluded : ∀ w → (Listed w reservedWords → ⊥) → reserved w ≡ false

  emptyIdentifier : identifier [] ≡ false

  identifierForm : ∀ c cs → identifier (c ∷ cs) ≡ (canStart c ∧ all canContinue cs ∧ not (reserved (c ∷ cs)))

  observedReservedWords : reservedWords ≡ map toList
    ("break" ∷ "case" ∷ "catch" ∷ "class" ∷ "const" ∷ "continue" ∷ "debugger" ∷
     "default" ∷ "delete" ∷ "do" ∷ "else" ∷ "export" ∷ "extends" ∷ "false" ∷
     "finally" ∷ "for" ∷ "function" ∷ "if" ∷ "import" ∷ "in" ∷ "instanceof" ∷
     "new" ∷ "null" ∷ "return" ∷ "super" ∷ "switch" ∷ "this" ∷ "throw" ∷
     "true" ∷ "try" ∷ "typeof" ∷ "var" ∷ "void" ∷ "while" ∷ "with" ∷ "yield" ∷ [])

  escapeChar : Char → List Char

  escapeBody : List Char → List Char

  quoteForward : String → String

  escapeBodyEmpty : escapeBody [] ≡ []

  escapeBodyNext : ∀ c cs → escapeBody (c ∷ cs) ≡ escapeChar c ++ escapeBody cs

  literalChar : ∀ c → (31 <ᵇ toℕ c) ≡ true →
    ((toℕ c <ᵇ 127) ∨ (159 <ᵇ toℕ c)) ≡ true →
    ((toℕ c ≡ᵇ 34) ∨ (toℕ c ≡ᵇ 92) ∨ (toℕ c ≡ᵇ 8232) ∨ (toℕ c ≡ᵇ 8233)) ≡ false →
    escapeChar c ≡ c ∷ []

  quoteShape : ∀ s → quoteForward s ≡ fromList ('"' ∷ (escapeBody (toList s) ++ ('"' ∷ [])))

  csi : String

  csiPrefix : csi ≡ fromList (fromℕ 27 ∷ '[' ∷ [])

  paint : Bool → Shade → String → String

  paintPlain : ∀ hue s → paint false hue s ≡ s

  paintName : ∀ s → paint true name s ≡ csi ++ˢ "34;1m" ++ˢ s ++ˢ csi ++ˢ "0;22m"

  paintContainer : ∀ s → paint true container s ≡ csi ++ˢ "35m" ++ˢ s ++ˢ csi ++ˢ "0m"

  paintNumeral : ∀ s → paint true numeral s ≡ csi ++ˢ "31m" ++ˢ s ++ˢ csi ++ˢ "0m"

  paintQuoted : ∀ s → paint true quoted s ≡ csi ++ˢ "33m" ++ˢ s ++ˢ csi ++ˢ "0m"

  paintConstant : ∀ s → paint true constant s ≡ csi ++ˢ "36m" ++ˢ s ++ˢ csi ++ˢ "0m"

  renderPayload : Bool → Payload → String

  payloadNull : ∀ c → renderPayload c (atom null) ≡ paint c constant "null"

  payloadTrue : ∀ c → renderPayload c (atom (boolean true)) ≡ paint c constant "true"

  payloadFalse : ∀ c → renderPayload c (atom (boolean false)) ≡ paint c constant "false"

  payloadNumber : ∀ c n → renderPayload c (atom (number n)) ≡ paint c numeral n

  payloadText : ∀ c s → renderPayload c (atom (text s)) ≡ paint c quoted (quoteForward s)

  payloadArray : ∀ c → renderPayload c arrayMark ≡ paint c container "[]"

  payloadObject : ∀ c → renderPayload c objectMark ≡ paint c container "{}"

  assignmentPart : Bool → Segment → String

  assignmentSuffix : Bool → List Segment → String

  assignmentDotted : ∀ c k → identifier (toList k) ≡ true →
    assignmentPart c (property k) ≡ "." ++ˢ paint c name k

  assignmentBracketed : ∀ c k → identifier (toList k) ≡ false →
    assignmentPart c (property k) ≡ paint c container "[" ++ˢ paint c quoted (quoteForward k) ++ˢ paint c container "]"

  assignmentIndex : ∀ c i →
    assignmentPart c (index i) ≡ paint c container "[" ++ˢ paint c numeral (Nat.show i) ++ˢ paint c container "]"

  assignmentSuffixEmpty : ∀ c → assignmentSuffix c [] ≡ ""

  assignmentSuffixNext : ∀ c p ps → assignmentSuffix c (p ∷ ps) ≡ assignmentPart c p ++ˢ assignmentSuffix c ps

  pairPart : Bool → Segment → String

  pairParts : Bool → List Segment → String

  pairProperty : ∀ c k → pairPart c (property k) ≡ paint c quoted (quoteForward k)

  pairIndex : ∀ c i → pairPart c (index i) ≡ paint c numeral (Nat.show i)

  pairPartsEmpty : ∀ c → pairParts c [] ≡ ""

  pairPartsSingle : ∀ c p → pairParts c (p ∷ []) ≡ pairPart c p

  pairPartsNext : ∀ c p q ps → pairParts c (p ∷ q ∷ ps) ≡ pairPart c p ++ˢ "," ++ˢ pairParts c (q ∷ ps)

  renderLine : Notation → Bool → Statement → String

  renderAssignment : ∀ c ps r → renderLine assignments c (assignment ps r) ≡
    paint c name "json" ++ˢ assignmentSuffix c ps ++ˢ " = " ++ˢ renderPayload c r ++ˢ ";\n"

  renderPair : ∀ c ps r → renderLine pairs c (assignment ps r) ≡
    paint c container "[" ++ˢ paint c container "[" ++ˢ pairParts c ps ++ˢ paint c container "]" ++ˢ
    "," ++ˢ renderPayload c r ++ˢ paint c container "]" ++ˢ "\n"

  observedColor : renderLine pairs true (assignment [] (atom (boolean true))) ≡
    csi ++ˢ "35m[" ++ˢ csi ++ˢ "0m" ++ˢ csi ++ˢ "35m[" ++ˢ csi ++ˢ "0m" ++ˢ
    csi ++ˢ "35m]" ++ˢ csi ++ˢ "0m," ++ˢ csi ++ˢ "36mtrue" ++ˢ csi ++ˢ "0m" ++ˢ
    csi ++ˢ "35m]" ++ˢ csi ++ˢ "0m\n"

  compareText : List Char → List Char → Ordering

  compareEmpty : compareText [] [] ≡ equal

  compareLeftEmpty : ∀ c cs → compareText [] (c ∷ cs) ≡ before

  compareRightEmpty : ∀ c cs → compareText (c ∷ cs) [] ≡ after

  compareNext : ∀ c cs d ds → compareText (c ∷ cs) (d ∷ ds) ≡
    (if toℕ c <ᵇ toℕ d then before else if toℕ d <ᵇ toℕ c then after else compareText cs ds)

  insertKey : {V : Set} → (String → List Char) → (String × V) → List (String × V) → List (String × V)

  orderKeys : {V : Set} → (String → List Char) → List (String × V) → List (String × V)

  insertEmpty : {V : Set} → ∀ rank kv → insertKey {V} rank kv [] ≡ kv ∷ []

  insertBefore : {V : Set} → ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ before →
    insertKey {V} rank (k , v) ((j , w) ∷ xs) ≡ (k , v) ∷ (j , w) ∷ xs

  insertEqual : {V : Set} → ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ equal →
    insertKey {V} rank (k , v) ((j , w) ∷ xs) ≡ (k , v) ∷ (j , w) ∷ xs

  insertAfter : {V : Set} → ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ after →
    insertKey {V} rank (k , v) ((j , w) ∷ xs) ≡ (j , w) ∷ insertKey rank (k , v) xs

  orderKeysEmpty : {V : Set} → ∀ rank → orderKeys {V} rank [] ≡ []

  orderKeysNext : {V : Set} → ∀ rank kv xs → orderKeys {V} rank (kv ∷ xs) ≡ insertKey rank kv (orderKeys rank xs)

-- The decoder observations cover nested objects, escaped keys, diagnostics, numeric spelling, and suffixes.
postulate
  decodedSorted : decodePrefix (toList "{\"-?\":4,\"- \":2,\"-!\":3,\"-\":1,\"a$\":5,\"a\":{\"-?\":6},\"A\":7}") ≡ inj₂ (parsed (object (("-?" , (scalar (number "4"))) ∷ ("- " , (scalar (number "2"))) ∷ ("-!" , (scalar (number "3"))) ∷ ("-" , (scalar (number "1"))) ∷ ("a$" , (scalar (number "5"))) ∷ ("a" , (object (("-?" , (scalar (number "6"))) ∷ []))) ∷ ("A" , (scalar (number "7"))) ∷ [])) [])

  decodedEscaping : decodePrefix (toList "{\"x\\u000b\\u2028\\u0085\":\"\\u000b\\u001f\\u007f\\u0085\\u2028\\u2029<&>/\"}") ≡ inj₂ (parsed (object (((fromList ('x' ∷ fromℕ 11 ∷ fromℕ 8232 ∷ fromℕ 133 ∷ [])) , (scalar (text (fromList (fromℕ 11 ∷ fromℕ 31 ∷ fromℕ 127 ∷ fromℕ 133 ∷ fromℕ 8232 ∷ fromℕ 8233 ∷ toList "<&>/"))))) ∷ [])) [])

  decodedDuplicate : decodePrefix (toList "{\"a\":1,\"\\u0061\":{\"z\":3},\"b\":2}") ≡ inj₂ (parsed (object (("a" , (object (("z" , (scalar (number "3"))) ∷ []))) ∷ ("b" , (scalar (number "2"))) ∷ [])) [])

  decodedMalformed : decodePrefix (toList "{\"a\":1,\"\\u0061\":nulx}") ≡ inj₁ "invalid character 'x' in literal null (expecting 'l')"

  decodedSeed : decodePrefix (toList "[\"λ<&>\\u2028\",{}]") ≡ inj₂ (parsed (array ((scalar (text (fromList (toList "λ<&>" ++ (fromℕ 8232 ∷ []))))) ∷ (object []) ∷ [])) [])

  decodedNumber : decodePrefix (toList "-94.00e+2") ≡ inj₂ (parsed (scalar (number "-94.00e+2")) [])

  decodedStreamTwelve : decodePrefix (toList " 12xyz") ≡ inj₂ (parsed (scalar (number "12")) (toList "xyz"))

  decodedStreamTrue : decodePrefix (toList "true false") ≡ inj₂ (parsed (scalar (boolean true)) (toList " false"))

  decodedOnlyTrue : decodePrefix (toList "true") ≡ inj₂ (parsed (scalar (boolean true)) [])

-- The rendering observations give the text of known statement lists and the ordering of object path components.
postulate
  sortedKeyOrder : {V : Set} → (question space bang dash dollar nested upper : V) →
    orderKeys (λ key → toList (assignmentPart false (property key)))
      (("-?" , question) ∷ ("- " , space) ∷ ("-!" , bang) ∷ ("-" , dash) ∷ ("a$" , dollar) ∷ ("a" , nested) ∷ ("A" , upper) ∷ []) ≡
    (("A" , upper) ∷ ("a" , nested) ∷ ("a$" , dollar) ∷ ("- " , space) ∷ ("-!" , bang) ∷ ("-" , dash) ∷ ("-?" , question) ∷ [])

  duplicateKeyOrder : {V : Set} → (a b : V) →
    orderKeys (λ key → toList (assignmentPart false (property key))) (("a" , a) ∷ ("b" , b) ∷ []) ≡
    (("a" , a) ∷ ("b" , b) ∷ [])

  shownSortedRows : foldr _++ˢ_ "" (map (renderLine assignments false) ((assignment [] objectMark) ∷ (assignment ((property "A") ∷ []) (atom (number "7"))) ∷ (assignment ((property "a") ∷ []) objectMark) ∷ (assignment ((property "a") ∷ (property "-?") ∷ []) (atom (number "6"))) ∷ (assignment ((property "a$") ∷ []) (atom (number "5"))) ∷ (assignment ((property "- ") ∷ []) (atom (number "2"))) ∷ (assignment ((property "-!") ∷ []) (atom (number "3"))) ∷ (assignment ((property "-") ∷ []) (atom (number "1"))) ∷ (assignment ((property "-?") ∷ []) (atom (number "4"))) ∷ [])) ≡ "json = {};\njson.A = 7;\njson.a = {};\njson.a[\"-?\"] = 6;\njson.a$ = 5;\njson[\"- \"] = 2;\njson[\"-!\"] = 3;\njson[\"-\"] = 1;\njson[\"-?\"] = 4;\n"

  shownEscapingRows : foldr _++ˢ_ "" (map (renderLine pairs false) ((assignment [] objectMark) ∷ (assignment ((property (fromList ('x' ∷ fromℕ 11 ∷ fromℕ 8232 ∷ fromℕ 133 ∷ []))) ∷ []) (atom (text (fromList (fromℕ 11 ∷ fromℕ 31 ∷ fromℕ 127 ∷ fromℕ 133 ∷ fromℕ 8232 ∷ fromℕ 8233 ∷ toList "<&>/"))))) ∷ [])) ≡ "[[],{}]\n[[\"x\\u000B\\u2028\\u0085\"],\"\\u000B\\u001F\\u007F\\u0085\\u2028\\u2029<&>/\"]\n"

  shownDuplicateRows : foldr _++ˢ_ "" (map (renderLine assignments false) ((assignment [] objectMark) ∷ (assignment ((property "a") ∷ []) objectMark) ∷ (assignment ((property "a") ∷ (property "z") ∷ []) (atom (number "3"))) ∷ (assignment ((property "b") ∷ []) (atom (number "2"))) ∷ [])) ≡ "json = {};\njson.a = {};\njson.a.z = 3;\njson.b = 2;\n"

  shownSeedRows : foldr _++ˢ_ "" (map (renderLine assignments false) ((assignment [] arrayMark) ∷ (assignment ((index 0) ∷ []) (atom (text (fromList (toList "λ<&>" ++ (fromℕ 8232 ∷ [])))))) ∷ (assignment ((index 1) ∷ []) objectMark) ∷ [])) ≡ "json = [];\njson[0] = \"λ<&>\\u2028\";\njson[1] = {};\n"

  shownNumberRows : foldr _++ˢ_ "" (map (renderLine assignments false) ((assignment [] (atom (number "-94.00e+2"))) ∷ [])) ≡ "json = -94.00e+2;\n"

  shownStreamTwelveRows : foldr _++ˢ_ "" (map (renderLine pairs false) ((assignment ((index 0) ∷ []) (atom (number "12"))) ∷ [])) ≡ "[[0],12]\n"

  shownStreamTrueRows : foldr _++ˢ_ "" (map (renderLine pairs false) ((assignment ((index 1) ∷ []) (atom (boolean true))) ∷ [])) ≡ "[[1],true]\n"

  shownOnlyTrueRows : foldr _++ˢ_ "" (map (renderLine assignments false) ((assignment ((index 0) ∷ []) (atom (boolean true))) ∷ [])) ≡ "json[0] = true;\n"

  pairOpening : renderLine pairs false (assignment [] arrayMark) ≡ "[[],[]]\n"

  assignmentOpening : renderLine assignments false (assignment [] arrayMark) ≡ "json = [];\n"

```

```agda glue
module Gen.T1.Gron where

open import Data.Bool using (Bool; true; false; not; _∧_; _∨_; if_then_else_)
open import Data.Char using (Char; toℕ; fromℕ)
open import Data.List using (List; []; _∷_; _++_; all; map; foldr)
open import Data.Empty using (⊥)
open import Data.Maybe using (Maybe; just; nothing)
open import Data.Nat using (ℕ; suc; _<ᵇ_; _≡ᵇ_)
import Data.Nat.Show as Nat
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Data.String using (String; toList; fromList) renaming (_++_ to _++ˢ_)
open import Data.Sum using (_⊎_; inj₁; inj₂)
open import Relation.Binary.PropositionalEquality using (_≡_; _≢_; refl; cong; sym; trans)
import Gen.T0.Gron as B
import Gen.T1.Gron.Codec as C

data Notation : Set where
  assignments pairs : Notation

data Ordering : Set where
  before equal after : Ordering

data SortMode : Set where
  sorted given : SortMode

data Shade : Set where
  name container numeral quoted constant : Shade

data Listed (word : List Char) : List (List Char) → Set where
  first : ∀ {words} → Listed word (word ∷ words)
  later : ∀ {other words} → Listed word words → Listed word (other ∷ words)

record Parsed (A : Set) : Set where
  constructor parsed
  field
    value : A
    rest : List Char

record Display : Set where
  constructor display
  field
    notation : Notation
    color : Bool
    tree : B.Value

record Row : Set where
  constructor row
  field
    statement : B.Statement
    output : String

record Config : Set where
  constructor config
  field
    notation : Notation
    color : Bool
    sorting : SortMode

record Report : Set where
  constructor report
  field
    output : String
    issue : Maybe String

fromValue : C.Value → B.Value
fromValues : List C.Value → List B.Value
fromMembers : List (String × C.Value) → List (String × B.Value)
fromValue (C.scalar C.null) = B.scalar B.null
fromValue (C.scalar (C.boolean b)) = B.scalar (B.boolean b)
fromValue (C.scalar (C.number n)) = B.scalar (B.number n)
fromValue (C.scalar (C.text s)) = B.scalar (B.text s)
fromValue (C.array values) = B.array (fromValues values)
fromValue (C.object fields) = B.object (fromMembers fields)
fromValues [] = []
fromValues (v ∷ vs) = fromValue v ∷ fromValues vs
fromMembers [] = []
fromMembers ((k , v) ∷ fields) = (k , fromValue v) ∷ fromMembers fields

private
  Decode : Set → Set
  Decode A = String ⊎ Parsed A

  fromDecoded : {A D : Set} → (A → D) → (String ⊎ C.Parsed A) → Decode D
  fromDecoded f (inj₁ e) = inj₁ e
  fromDecoded f (inj₂ (C.parsed result rest)) = inj₂ (parsed (f result) rest)

  intoDecoded : {A : Set} → Decode A → String ⊎ C.Parsed A
  intoDecoded (inj₁ e) = inj₁ e
  intoDecoded (inj₂ (parsed result rest)) = inj₂ (C.parsed result rest)

  decodedRoundTrip : {A : Set} → (r : String ⊎ C.Parsed A) → intoDecoded (fromDecoded (λ result → result) r) ≡ r
  decodedRoundTrip (inj₁ e) = refl
  decodedRoundTrip (inj₂ (C.parsed result rest)) = refl

  decodedAs : {A : Set} → (r : String ⊎ C.Parsed A) → (seen : Decode A) →
    fromDecoded (λ result → result) r ≡ seen → r ≡ intoDecoded seen
  decodedAs r seen h =
    trans (sym (decodedRoundTrip r)) (cong intoDecoded {y = seen} h)

  tagDecoded : {A : Set} → (A → B.Value) → Decode A → Decode B.Value
  tagDecoded tag (inj₁ e) = inj₁ e
  tagDecoded tag (inj₂ (parsed result rest)) = inj₂ (parsed (tag result) rest)

hasKey : String → List (String × B.Value) → Bool
hasKey = C.hasKey {B.Value}

keepLatest : List (String × B.Value) → List (String × B.Value)
keepLatest = C.keepLatest {B.Value}

hasKeyEmpty : ∀ k → hasKey k [] ≡ false
hasKeyEmpty = C.hasKeyEmpty {B.Value}

hasKeySame : ∀ k v xs → hasKey k ((k , v) ∷ xs) ≡ true
hasKeySame = C.hasKeySame {B.Value}

hasKeyOther : ∀ k j v xs → k ≢ j → hasKey k ((j , v) ∷ xs) ≡ hasKey k xs
hasKeyOther = C.hasKeyOther {B.Value}

keepLatestEmpty : keepLatest [] ≡ []
keepLatestEmpty = C.keepLatestEmpty {B.Value}

keepLatestNext : ∀ k v xs → keepLatest ((k , v) ∷ xs) ≡
  (if hasKey k (keepLatest xs) then keepLatest xs else (k , v) ∷ keepLatest xs)
keepLatestNext = C.keepLatestNext {B.Value}

private
  fromMembersMap : ∀ fields → fromMembers fields ≡ map (λ kv → proj₁ kv , fromValue (proj₂ kv)) fields
  fromMembersMap [] = refl
  fromMembersMap ((k , v) ∷ fields) =
    cong (λ members → (k , fromValue v) ∷ members) (fromMembersMap fields)

  keepLatestFrom : ∀ fields → fromMembers (C.keepLatest fields) ≡ keepLatest (fromMembers fields)
  keepLatestFrom fields =
    trans (fromMembersMap (C.keepLatest fields))
      (trans (C.keepLatestMap fromValue fields)
        (cong keepLatest {y = fromMembers fields} (sym (fromMembersMap fields))))

decodePrefix : List Char → String ⊎ Parsed B.Value
decodePrefix xs = fromDecoded fromValue (C.decodePrefix xs)

decodeNumber : List Char → String ⊎ Parsed String
decodeNumber xs = fromDecoded (λ s → s) (C.decodeNumber xs)

decodeQuoted : List Char → String ⊎ Parsed String
decodeQuoted xs = fromDecoded (λ s → s) (C.decodeQuoted xs)

decodeElements : List Char → String ⊎ Parsed (List B.Value)
decodeElements xs = fromDecoded fromValues (C.decodeElements xs)

decodeMembers : List Char → String ⊎ Parsed (List (String × B.Value))
decodeMembers xs = fromDecoded fromMembers (C.decodeMembers xs)

endOfInput : decodePrefix [] ≡ inj₁ "EOF"
endOfInput = cong (fromDecoded fromValue) C.endOfInput

leadingSpace : ∀ xs → decodePrefix (' ' ∷ xs) ≡ decodePrefix xs
leadingSpace xs = cong (fromDecoded fromValue) (C.leadingSpace xs)

leadingTab : ∀ xs → decodePrefix ('\t' ∷ xs) ≡ decodePrefix xs
leadingTab xs = cong (fromDecoded fromValue) (C.leadingTab xs)

leadingCR : ∀ xs → decodePrefix ('\r' ∷ xs) ≡ decodePrefix xs
leadingCR xs = cong (fromDecoded fromValue) (C.leadingCR xs)

leadingLF : ∀ xs → decodePrefix ('\n' ∷ xs) ≡ decodePrefix xs
leadingLF xs = cong (fromDecoded fromValue) (C.leadingLF xs)

truePrefix : ∀ xs → decodePrefix ('t' ∷ 'r' ∷ 'u' ∷ 'e' ∷ xs) ≡ inj₂ (parsed (B.scalar (B.boolean true)) xs)
truePrefix xs = cong (fromDecoded fromValue) (C.truePrefix xs)

falsePrefix : ∀ xs → decodePrefix ('f' ∷ 'a' ∷ 'l' ∷ 's' ∷ 'e' ∷ xs) ≡ inj₂ (parsed (B.scalar (B.boolean false)) xs)
falsePrefix xs = cong (fromDecoded fromValue) (C.falsePrefix xs)

nullPrefix : ∀ xs → decodePrefix ('n' ∷ 'u' ∷ 'l' ∷ 'l' ∷ xs) ≡ inj₂ (parsed (B.scalar B.null) xs)
nullPrefix xs = cong (fromDecoded fromValue) (C.nullPrefix xs)

closeQuote : ∀ xs → decodeQuoted ('"' ∷ xs) ≡ inj₂ (parsed "" xs)
closeQuote xs = cong (fromDecoded (λ s → s)) (C.closeQuote xs)

closeArray : ∀ xs → decodeElements (']' ∷ xs) ≡ inj₂ (parsed [] xs)
closeArray xs = cong (fromDecoded fromValues) (C.closeArray xs)

closeObject : ∀ xs → decodeMembers ('}' ∷ xs) ≡ inj₂ (parsed [] xs)
closeObject xs = cong (fromDecoded fromMembers) (C.closeObject xs)

quotedPrefix : ∀ xs s rest → decodeQuoted xs ≡ inj₂ (parsed s rest) →
  decodePrefix ('"' ∷ xs) ≡ inj₂ (parsed (B.scalar (B.text s)) rest)
quotedPrefix xs s rest h =
  cong (fromDecoded fromValue) (C.quotedPrefix xs s rest (decodedAs (C.decodeQuoted xs) (inj₂ (parsed s rest)) h))

quotedError : ∀ xs e → decodeQuoted xs ≡ inj₁ e → decodePrefix ('"' ∷ xs) ≡ inj₁ e
quotedError xs e h =
  cong (fromDecoded fromValue) (C.quotedError xs e (decodedAs (C.decodeQuoted xs) (inj₁ e) h))

numericPrefix : ∀ c xs s rest →
  ((toℕ c ≡ᵇ 45) ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58))) ≡ true →
  decodeNumber (c ∷ xs) ≡ inj₂ (parsed s rest) →
  decodePrefix (c ∷ xs) ≡ inj₂ (parsed (B.scalar (B.number s)) rest)
numericPrefix c xs s rest start h =
  cong (fromDecoded fromValue) (C.numericPrefix c xs s rest start (decodedAs (C.decodeNumber (c ∷ xs)) (inj₂ (parsed s rest)) h))

numericError : ∀ c xs e →
  ((toℕ c ≡ᵇ 45) ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58))) ≡ true →
  decodeNumber (c ∷ xs) ≡ inj₁ e → decodePrefix (c ∷ xs) ≡ inj₁ e
numericError c xs e start h =
  cong (fromDecoded fromValue) (C.numericError c xs e start (decodedAs (C.decodeNumber (c ∷ xs)) (inj₁ e) h))

private
  arrayFrom : ∀ xs r → C.decodeElements xs ≡ r →
    decodePrefix ('[' ∷ xs) ≡ tagDecoded B.array (fromDecoded fromValues r)
  arrayFrom xs (inj₁ e) h = cong (fromDecoded fromValue) (C.arrayError xs e h)
  arrayFrom xs (inj₂ (C.parsed values rest)) h =
    cong (fromDecoded fromValue) (C.arrayPrefix xs values rest h)

  objectFrom : ∀ xs r → C.decodeMembers xs ≡ r →
    decodePrefix ('{' ∷ xs) ≡ tagDecoded (λ fields → B.object (keepLatest fields)) (fromDecoded fromMembers r)
  objectFrom xs (inj₁ e) h = cong (fromDecoded fromValue) (C.objectError xs e h)
  objectFrom xs (inj₂ (C.parsed fields rest)) h =
    trans (cong (fromDecoded fromValue) (C.objectPrefix xs fields rest h))
      (cong (λ members → inj₂ (parsed (B.object members) rest)) (keepLatestFrom fields))

arrayPrefix : ∀ xs vs rest → decodeElements xs ≡ inj₂ (parsed vs rest) →
  decodePrefix ('[' ∷ xs) ≡ inj₂ (parsed (B.array vs) rest)
arrayPrefix xs values rest h =
  trans (arrayFrom xs (C.decodeElements xs) refl)
    (cong (tagDecoded B.array) {y = inj₂ (parsed values rest)} h)

arrayError : ∀ xs e → decodeElements xs ≡ inj₁ e → decodePrefix ('[' ∷ xs) ≡ inj₁ e
arrayError xs e h =
  trans (arrayFrom xs (C.decodeElements xs) refl)
    (cong (tagDecoded B.array) {y = inj₁ e} h)

objectPrefix : ∀ xs kvs rest → decodeMembers xs ≡ inj₂ (parsed kvs rest) →
  decodePrefix ('{' ∷ xs) ≡ inj₂ (parsed (B.object (keepLatest kvs)) rest)
objectPrefix xs values rest h =
  trans (objectFrom xs (C.decodeMembers xs) refl)
    (cong (tagDecoded (λ fields → B.object (keepLatest fields))) {y = inj₂ (parsed values rest)} h)

objectError : ∀ xs e → decodeMembers xs ≡ inj₁ e → decodePrefix ('{' ∷ xs) ≡ inj₁ e
objectError xs e h =
  trans (objectFrom xs (C.decodeMembers xs) refl)
    (cong (tagDecoded (λ fields → B.object (keepLatest fields))) {y = inj₁ e} h)

private
  toSegment : B.Segment → C.Segment
  toSegment segment with segment
  ... | B.property key = C.property key
  ... | B.index i = C.index i

  toPayload : B.Payload → C.Payload
  toPayload payload with payload
  ... | B.atom B.null = C.atom C.null
  ... | B.atom (B.boolean b) = C.atom (C.boolean b)
  ... | B.atom (B.number n) = C.atom (C.number n)
  ... | B.atom (B.text s) = C.atom (C.text s)
  ... | B.arrayMark = C.arrayMark
  ... | B.objectMark = C.objectMark

  codecShade : Shade → C.Shade
  codecShade hue with hue
  ... | name = C.name
  ... | container = C.container
  ... | numeral = C.numeral
  ... | quoted = C.quoted
  ... | constant = C.constant

  intoListed : ∀ {w ws} → Listed w ws → C.Listed w ws
  intoListed first = C.first
  intoListed (later found) = C.later (intoListed found)

  fromListed : ∀ {w ws} → C.Listed w ws → Listed w ws
  fromListed C.first = first
  fromListed (C.later found) = later (fromListed found)

  fromOrder : C.Ordering → Ordering
  fromOrder C.before = before
  fromOrder C.equal = equal
  fromOrder C.after = after

  intoOrder : Ordering → C.Ordering
  intoOrder before = C.before
  intoOrder equal = C.equal
  intoOrder after = C.after

  orderRoundTrip : ∀ order → intoOrder (fromOrder order) ≡ order
  orderRoundTrip C.before = refl
  orderRoundTrip C.equal = refl
  orderRoundTrip C.after = refl

  orderChoice : ∀ less more tie →
    fromOrder (if less then C.before else if more then C.after else tie) ≡
    (if less then before else if more then after else fromOrder tie)
  orderChoice true more tie = refl
  orderChoice false true tie = refl
  orderChoice false false tie = refl

canStart : Char → Bool
canStart = C.canStart

canContinue : Char → Bool
canContinue = C.canContinue

reservedWords : List (List Char)
reservedWords = C.reservedWords

reserved : List Char → Bool
reserved = C.reserved

identifier : List Char → Bool
identifier = C.identifier

asciiStart : ∀ c → (toℕ c <ᵇ 128) ≡ true → canStart c ≡
  ((toℕ c ≡ᵇ 36) ∨ (toℕ c ≡ᵇ 95) ∨
   ((64 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 91)) ∨ ((96 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 123)))
asciiStart = C.asciiStart

asciiContinue : ∀ c → (toℕ c <ᵇ 128) ≡ true → canContinue c ≡
  (canStart c ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58)))
asciiContinue = C.asciiContinue

reservedIncluded : ∀ w → Listed w reservedWords → reserved w ≡ true
reservedIncluded w found = C.reservedIncluded w (intoListed found)

reservedExcluded : ∀ w → (Listed w reservedWords → ⊥) → reserved w ≡ false
reservedExcluded w missing = C.reservedExcluded w (λ found → missing (fromListed found))

emptyIdentifier : identifier [] ≡ false
emptyIdentifier = C.emptyIdentifier

identifierForm : ∀ c cs → identifier (c ∷ cs) ≡ (canStart c ∧ all canContinue cs ∧ not (reserved (c ∷ cs)))
identifierForm = C.identifierForm

observedReservedWords : reservedWords ≡ map toList
  ("break" ∷ "case" ∷ "catch" ∷ "class" ∷ "const" ∷ "continue" ∷ "debugger" ∷
   "default" ∷ "delete" ∷ "do" ∷ "else" ∷ "export" ∷ "extends" ∷ "false" ∷
   "finally" ∷ "for" ∷ "function" ∷ "if" ∷ "import" ∷ "in" ∷ "instanceof" ∷
   "new" ∷ "null" ∷ "return" ∷ "super" ∷ "switch" ∷ "this" ∷ "throw" ∷
   "true" ∷ "try" ∷ "typeof" ∷ "var" ∷ "void" ∷ "while" ∷ "with" ∷ "yield" ∷ [])
observedReservedWords = C.observedReservedWords

escapeChar : Char → List Char
escapeChar = C.escapeChar

escapeBody : List Char → List Char
escapeBody = C.escapeBody

quoteForward : String → String
quoteForward = C.quoteForward

escapeBodyEmpty : escapeBody [] ≡ []
escapeBodyEmpty = C.escapeBodyEmpty

escapeBodyNext : ∀ c cs → escapeBody (c ∷ cs) ≡ escapeChar c ++ escapeBody cs
escapeBodyNext = C.escapeBodyNext

literalChar : ∀ c → (31 <ᵇ toℕ c) ≡ true →
  ((toℕ c <ᵇ 127) ∨ (159 <ᵇ toℕ c)) ≡ true →
  ((toℕ c ≡ᵇ 34) ∨ (toℕ c ≡ᵇ 92) ∨ (toℕ c ≡ᵇ 8232) ∨ (toℕ c ≡ᵇ 8233)) ≡ false →
  escapeChar c ≡ c ∷ []
literalChar = C.literalChar

quoteShape : ∀ s → quoteForward s ≡ fromList ('"' ∷ (escapeBody (toList s) ++ ('"' ∷ [])))
quoteShape = C.quoteShape

csi : String
csi = C.csi

csiPrefix : csi ≡ fromList (fromℕ 27 ∷ '[' ∷ [])
csiPrefix = C.csiPrefix

paint : Bool → Shade → String → String
paint c hue s = C.paint c (codecShade hue) s

paintPlain : ∀ hue s → paint false hue s ≡ s
paintPlain hue s = C.paintPlain (codecShade hue) s

paintName : ∀ s → paint true name s ≡ csi ++ˢ "34;1m" ++ˢ s ++ˢ csi ++ˢ "0;22m"
paintName = C.paintName

paintContainer : ∀ s → paint true container s ≡ csi ++ˢ "35m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintContainer = C.paintContainer

paintNumeral : ∀ s → paint true numeral s ≡ csi ++ˢ "31m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintNumeral = C.paintNumeral

paintQuoted : ∀ s → paint true quoted s ≡ csi ++ˢ "33m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintQuoted = C.paintQuoted

paintConstant : ∀ s → paint true constant s ≡ csi ++ˢ "36m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintConstant = C.paintConstant

renderPayload : Bool → B.Payload → String
renderPayload c r = C.renderPayload c (toPayload r)

payloadNull : ∀ c → renderPayload c (B.atom B.null) ≡ paint c constant "null"
payloadNull = C.payloadNull

payloadTrue : ∀ c → renderPayload c (B.atom (B.boolean true)) ≡ paint c constant "true"
payloadTrue = C.payloadTrue

payloadFalse : ∀ c → renderPayload c (B.atom (B.boolean false)) ≡ paint c constant "false"
payloadFalse = C.payloadFalse

payloadNumber : ∀ c n → renderPayload c (B.atom (B.number n)) ≡ paint c numeral n
payloadNumber = C.payloadNumber

payloadText : ∀ c s → renderPayload c (B.atom (B.text s)) ≡ paint c quoted (quoteForward s)
payloadText = C.payloadText

payloadArray : ∀ c → renderPayload c B.arrayMark ≡ paint c container "[]"
payloadArray = C.payloadArray

payloadObject : ∀ c → renderPayload c B.objectMark ≡ paint c container "{}"
payloadObject = C.payloadObject

assignmentPart : Bool → B.Segment → String
assignmentPart c p = C.assignmentPart c (toSegment p)

assignmentSuffix : Bool → List B.Segment → String
assignmentSuffix c ps = C.assignmentSuffix c (map toSegment ps)

assignmentDotted : ∀ c k → identifier (toList k) ≡ true →
  assignmentPart c (B.property k) ≡ "." ++ˢ paint c name k
assignmentDotted = C.assignmentDotted

assignmentBracketed : ∀ c k → identifier (toList k) ≡ false →
  assignmentPart c (B.property k) ≡ paint c container "[" ++ˢ paint c quoted (quoteForward k) ++ˢ paint c container "]"
assignmentBracketed = C.assignmentBracketed

assignmentIndex : ∀ c i →
  assignmentPart c (B.index i) ≡ paint c container "[" ++ˢ paint c numeral (Nat.show i) ++ˢ paint c container "]"
assignmentIndex = C.assignmentIndex

assignmentSuffixEmpty : ∀ c → assignmentSuffix c [] ≡ ""
assignmentSuffixEmpty = C.assignmentSuffixEmpty

assignmentSuffixNext : ∀ c p ps → assignmentSuffix c (p ∷ ps) ≡ assignmentPart c p ++ˢ assignmentSuffix c ps
assignmentSuffixNext c p ps = C.assignmentSuffixNext c (toSegment p) (map toSegment ps)

pairPart : Bool → B.Segment → String
pairPart c p = C.pairPart c (toSegment p)

pairParts : Bool → List B.Segment → String
pairParts c ps = C.pairParts c (map toSegment ps)

pairProperty : ∀ c k → pairPart c (B.property k) ≡ paint c quoted (quoteForward k)
pairProperty = C.pairProperty

pairIndex : ∀ c i → pairPart c (B.index i) ≡ paint c numeral (Nat.show i)
pairIndex = C.pairIndex

pairPartsEmpty : ∀ c → pairParts c [] ≡ ""
pairPartsEmpty = C.pairPartsEmpty

pairPartsSingle : ∀ c p → pairParts c (p ∷ []) ≡ pairPart c p
pairPartsSingle c p = C.pairPartsSingle c (toSegment p)

pairPartsNext : ∀ c p q ps → pairParts c (p ∷ q ∷ ps) ≡ pairPart c p ++ˢ "," ++ˢ pairParts c (q ∷ ps)
pairPartsNext c p q ps = C.pairPartsNext c (toSegment p) (toSegment q) (map toSegment ps)

renderLine : Notation → Bool → B.Statement → String
renderLine assignments c (B.assignment ps r) =
  C.renderLine C.assignments c (C.assignment (map toSegment ps) (toPayload r))
renderLine pairs c (B.assignment ps r) =
  C.renderLine C.pairs c (C.assignment (map toSegment ps) (toPayload r))

renderAssignment : ∀ c ps r → renderLine assignments c (B.assignment ps r) ≡
  paint c name "json" ++ˢ assignmentSuffix c ps ++ˢ " = " ++ˢ renderPayload c r ++ˢ ";\n"
renderAssignment c ps r = C.renderAssignment c (map toSegment ps) (toPayload r)

renderPair : ∀ c ps r → renderLine pairs c (B.assignment ps r) ≡
  paint c container "[" ++ˢ paint c container "[" ++ˢ pairParts c ps ++ˢ paint c container "]" ++ˢ
  "," ++ˢ renderPayload c r ++ˢ paint c container "]" ++ˢ "\n"
renderPair c ps r = C.renderPair c (map toSegment ps) (toPayload r)

observedColor : renderLine pairs true (B.assignment [] (B.atom (B.boolean true))) ≡
  csi ++ˢ "35m[" ++ˢ csi ++ˢ "0m" ++ˢ csi ++ˢ "35m[" ++ˢ csi ++ˢ "0m" ++ˢ
  csi ++ˢ "35m]" ++ˢ csi ++ˢ "0m," ++ˢ csi ++ˢ "36mtrue" ++ˢ csi ++ˢ "0m" ++ˢ
  csi ++ˢ "35m]" ++ˢ csi ++ˢ "0m\n"
observedColor = C.observedColor

compareText : List Char → List Char → Ordering
compareText l r = fromOrder (C.compareText l r)

private
  comparisonAs : (l r : List Char) → (order : C.Ordering) →
    compareText l r ≡ fromOrder order → C.compareText l r ≡ order
  comparisonAs l r order h =
    trans (sym (orderRoundTrip (C.compareText l r))) (trans (cong intoOrder h) (orderRoundTrip order))

compareEmpty : compareText [] [] ≡ equal
compareEmpty = cong fromOrder C.compareEmpty

compareLeftEmpty : ∀ c cs → compareText [] (c ∷ cs) ≡ before
compareLeftEmpty c cs = cong fromOrder (C.compareLeftEmpty c cs)

compareRightEmpty : ∀ c cs → compareText (c ∷ cs) [] ≡ after
compareRightEmpty c cs = cong fromOrder (C.compareRightEmpty c cs)

compareNext : ∀ c cs d ds → compareText (c ∷ cs) (d ∷ ds) ≡
  (if toℕ c <ᵇ toℕ d then before else if toℕ d <ᵇ toℕ c then after else compareText cs ds)
compareNext c cs d ds =
  trans (cong fromOrder (C.compareNext c cs d ds))
    (orderChoice (toℕ c <ᵇ toℕ d) (toℕ d <ᵇ toℕ c) (C.compareText cs ds))

insertKey : (String → List Char) → (String × B.Value) → List (String × B.Value) → List (String × B.Value)
insertKey = C.insertKey {B.Value}

orderKeys : (String → List Char) → List (String × B.Value) → List (String × B.Value)
orderKeys = C.orderKeys {B.Value}

insertEmpty : ∀ rank kv → insertKey rank kv [] ≡ kv ∷ []
insertEmpty = C.insertEmpty {B.Value}

insertBefore : ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ before →
  insertKey rank (k , v) ((j , w) ∷ xs) ≡ (k , v) ∷ (j , w) ∷ xs
insertBefore rank k v j w xs h =
  C.insertBefore {B.Value} rank k v j w xs (comparisonAs (rank k) (rank j) C.before h)

insertEqual : ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ equal →
  insertKey rank (k , v) ((j , w) ∷ xs) ≡ (k , v) ∷ (j , w) ∷ xs
insertEqual rank k v j w xs h =
  C.insertEqual {B.Value} rank k v j w xs (comparisonAs (rank k) (rank j) C.equal h)

insertAfter : ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ after →
  insertKey rank (k , v) ((j , w) ∷ xs) ≡ (j , w) ∷ insertKey rank (k , v) xs
insertAfter rank k v j w xs h =
  C.insertAfter {B.Value} rank k v j w xs (comparisonAs (rank k) (rank j) C.after h)

orderKeysEmpty : ∀ rank → orderKeys rank [] ≡ []
orderKeysEmpty = C.orderKeysEmpty {B.Value}

orderKeysNext : ∀ rank kv xs → orderKeys rank (kv ∷ xs) ≡ insertKey rank kv (orderKeys rank xs)
orderKeysNext = C.orderKeysNext {B.Value}

arrangeSorted : B.Value → B.Value
arrangeValues : List B.Value → List B.Value
arrangeMembers : List (String × B.Value) → List (String × B.Value)
arrangeSorted (B.scalar a) = B.scalar a
arrangeSorted (B.array vs) = B.array (arrangeValues vs)
arrangeSorted (B.object kvs) = B.object (orderKeys (λ k → toList (assignmentPart false (B.property k))) (arrangeMembers kvs))
arrangeValues [] = []
arrangeValues (v ∷ vs) = arrangeSorted v ∷ arrangeValues vs
arrangeMembers [] = []
arrangeMembers ((k , v) ∷ kvs) = (k , arrangeSorted v) ∷ arrangeMembers kvs

arrange : SortMode → B.Value → B.Value
arrange given v = v
arrange sorted v = arrangeSorted v

private
  arrangeValuesLaw : ∀ vs → arrangeValues vs ≡ map (arrange sorted) vs
  arrangeValuesLaw [] = refl
  arrangeValuesLaw (v ∷ vs) = cong (λ rs → arrange sorted v ∷ rs) (arrangeValuesLaw vs)

  arrangeMembersLaw : ∀ kvs →
    arrangeMembers kvs ≡ map (λ kv → proj₁ kv , arrange sorted (proj₂ kv)) kvs
  arrangeMembersLaw [] = refl
  arrangeMembersLaw ((k , v) ∷ kvs) =
    cong (λ rs → (k , arrange sorted v) ∷ rs) (arrangeMembersLaw kvs)

givenOrder : ∀ v → arrange given v ≡ v
givenOrder v = refl

arrangedScalar : ∀ a → arrange sorted (B.scalar a) ≡ B.scalar a
arrangedScalar a = refl

arrangedArray : ∀ vs → arrange sorted (B.array vs) ≡ B.array (map (arrange sorted) vs)
arrangedArray vs = cong B.array (arrangeValuesLaw vs)

arrangedObject : ∀ kvs → arrange sorted (B.object kvs) ≡
  B.object (orderKeys (λ k → toList (assignmentPart false (B.property k)))
    (map (λ kv → proj₁ kv , arrange sorted (proj₂ kv)) kvs))
arrangedObject kvs = cong (λ rs → B.object (orderKeys (λ k → toList (assignmentPart false (B.property k))) rs)) (arrangeMembersLaw kvs)

draw : List B.Segment → Display → List Row
draw p (display n c v) = map (λ s → row s (renderLine n c s)) (B.flatten p v)

private
  rowStatements : ∀ n c ss → map Row.statement (map (λ s → row s (renderLine n c s)) ss) ≡ ss
  rowStatements n c [] = refl
  rowStatements n c (s ∷ ss) = cong (λ rest → s ∷ rest) (rowStatements n c ss)

drawLines : ∀ p n c v → draw p (display n c v) ≡
  map (λ s → row s (renderLine n c s)) (map Row.statement (draw p (display n c v)))
drawLines p n c v =
  cong (map (λ s → row s (renderLine n c s))) (sym (rowStatements n c (B.flatten p v)))

drawSquare : ∀ p d → map Row.statement (draw p d) ≡ B.flatten p (Display.tree d)
drawSquare p (display n c v) = rowStatements n c (B.flatten p v)

private
  drawString : List B.Segment → Display → String
  drawString p d = foldr _++ˢ_ "" (map Row.output (draw p d))

  drawStringShape : ∀ p d → drawString p d ≡ foldr _++ˢ_ "" (map Row.output (draw p d))
  drawStringShape p d = refl

renderTree : Config → List B.Segment → B.Value → String
renderTree cfg p v =
  drawString p (display (Config.notation cfg) (Config.color cfg) (arrange (Config.sorting cfg) v))

renderTreeLaw : ∀ cfg p v → renderTree cfg p v ≡
  foldr _++ˢ_ "" (map Row.output
    (draw p (display (Config.notation cfg) (Config.color cfg) (arrange (Config.sorting cfg) v))))
renderTreeLaw cfg p v =
  drawStringShape p (display (Config.notation cfg) (Config.color cfg) (arrange (Config.sorting cfg) v))

private
  forwardResult : Config → Decode B.Value → Report
  forwardResult cfg (inj₁ e) = report "" (just e)
  forwardResult cfg (inj₂ (parsed v rest)) = report (renderTree cfg [] v) nothing

  prependOutput : String → Report → Report
  prependOutput prefix (report out issue) = report (prefix ++ˢ out) issue

  prependResult : ∀ prefix r out issue → r ≡ report out issue →
    prependOutput prefix r ≡ report (prefix ++ˢ out) issue
  prependResult prefix r out issue h =
    cong (prependOutput prefix) {x = r} {y = report out issue} h

  streamHead : Config → ℕ → Report → Decode B.Value → Report
  streamHead cfg i tail (inj₁ e) = report "" (just e)
  streamHead cfg i tail (inj₂ (parsed v rest)) = prependOutput (renderTree cfg (B.index i ∷ []) v) tail

forward : Config → List Char → Report
forward cfg xs = forwardResult cfg (decodePrefix xs)

streamFrom : Config → ℕ → List (List Char) → Report
streamFrom cfg i [] = report "" nothing
streamFrom cfg i (xs ∷ xss) = streamHead cfg i (streamFrom cfg (suc i) xss) (decodePrefix xs)

forwardStream : Config → List (List Char) → Report
forwardStream cfg xss =
  prependOutput (renderLine (Config.notation cfg) (Config.color cfg) (B.assignment [] B.arrayMark)) (streamFrom cfg 0 xss)

forwardGood : ∀ cfg xs v rest → decodePrefix xs ≡ inj₂ (parsed v rest) →
  forward cfg xs ≡ report (renderTree cfg [] v) nothing
forwardGood cfg xs v rest h = cong (forwardResult cfg) h

forwardBad : ∀ cfg xs e → decodePrefix xs ≡ inj₁ e → forward cfg xs ≡ report "" (just e)
forwardBad cfg xs e h = cong (forwardResult cfg) h

streamDone : ∀ cfg i → streamFrom cfg i [] ≡ report "" nothing
streamDone cfg i = refl

streamBad : ∀ cfg i xs xss e → decodePrefix xs ≡ inj₁ e →
  streamFrom cfg i (xs ∷ xss) ≡ report "" (just e)
streamBad cfg i xs xss e h = cong (streamHead cfg i (streamFrom cfg (suc i) xss)) h

streamNext : ∀ cfg i xs xss v rest out issue → decodePrefix xs ≡ inj₂ (parsed v rest) →
  streamFrom cfg (suc i) xss ≡ report out issue →
  streamFrom cfg i (xs ∷ xss) ≡ report (renderTree cfg (B.index i ∷ []) v ++ˢ out) issue
streamNext cfg i xs xss v rest out issue h laterResult =
  trans (cong (streamHead cfg i (streamFrom cfg (suc i) xss)) h)
    (prependResult (renderTree cfg (B.index i ∷ []) v) (streamFrom cfg (suc i) xss) out issue laterResult)

streamRoot : ∀ cfg xss out issue → streamFrom cfg 0 xss ≡ report out issue →
  forwardStream cfg xss ≡
  report (renderLine (Config.notation cfg) (Config.color cfg) (B.assignment [] B.arrayMark) ++ˢ out) issue
streamRoot cfg xss out issue h =
  prependResult (renderLine (Config.notation cfg) (Config.color cfg) (B.assignment [] B.arrayMark))
    (streamFrom cfg 0 xss) out issue h

private
  renderAt : ∀ cfg p v w out → arrange (Config.sorting cfg) v ≡ w →
    drawString p (display (Config.notation cfg) (Config.color cfg) w) ≡ out →
    renderTree cfg p v ≡ out
  renderAt cfg p v w out ordered seen =
    trans (cong (λ tree → drawString p (display (Config.notation cfg) (Config.color cfg) tree)) {y = w} ordered) seen

  forwardShows : ∀ cfg xs v rest out → decodePrefix xs ≡ inj₂ (parsed v rest) →
    renderTree cfg [] v ≡ out → forward cfg xs ≡ report out nothing
  forwardShows cfg xs v rest out decoded drawn =
    trans (forwardGood cfg xs v rest decoded) (cong (λ s → report s nothing) drawn)

  streamShowsNext : ∀ cfg i xs xss v rest out piece issue →
    decodePrefix xs ≡ inj₂ (parsed v rest) → renderTree cfg (B.index i ∷ []) v ≡ piece →
    streamFrom cfg (suc i) xss ≡ report out issue →
    streamFrom cfg i (xs ∷ xss) ≡ report (piece ++ˢ out) issue
  streamShowsNext cfg i xs xss v rest out piece issue decoded drawn continued =
    trans (streamNext cfg i xs xss v rest out issue decoded continued)
      (cong (λ s → report (s ++ˢ out) issue) {y = piece} drawn)

  streamShowsRoot : ∀ cfg xss out issue opening →
    renderLine (Config.notation cfg) (Config.color cfg) (B.assignment [] B.arrayMark) ≡ opening →
    streamFrom cfg 0 xss ≡ report out issue → forwardStream cfg xss ≡ report (opening ++ˢ out) issue
  streamShowsRoot cfg xss out issue opening firstLine continued =
    trans (streamRoot cfg xss out issue continued) (cong (λ s → report (s ++ˢ out) issue) {y = opening} firstLine)

  orderStep : ∀ rank kv tail ready result → orderKeys rank tail ≡ ready →
    insertKey rank kv ready ≡ result → orderKeys rank (kv ∷ tail) ≡ result
  orderStep rank kv tail ready result rest inserted =
    trans (orderKeysNext rank kv tail) (trans (cong (insertKey rank kv) {y = ready} rest) inserted)

  singleKeyOrder : ∀ rank key v → orderKeys rank ((key , v) ∷ []) ≡ (key , v) ∷ []
  singleKeyOrder rank key v =
    orderStep rank (key , v) [] [] ((key , v) ∷ [])
      (orderKeysEmpty rank) (insertEmpty rank (key , v))

  arrangeSingleScalar : ∀ key a →
    arrange sorted (B.object ((key , B.scalar a) ∷ [])) ≡ B.object ((key , B.scalar a) ∷ [])
  arrangeSingleScalar key a = cong B.object (singleKeyOrder (λ key → toList (assignmentPart false (B.property key))) key (B.scalar a))

  arrangeObjectVia : (source prepared ordered : List (String × B.Value)) →
    arrangeMembers source ≡ prepared → orderKeys (λ key → toList (assignmentPart false (B.property key))) prepared ≡ ordered →
    arrange sorted (B.object source) ≡ B.object ordered
  arrangeObjectVia source prepared ordered children keys =
    trans (cong (λ fields → B.object (orderKeys (λ key → toList (assignmentPart false (B.property key))) fields)) {y = prepared} children)
      (cong B.object keys)

  arrangeEmptyObject : arrange sorted (B.object []) ≡ B.object []
  arrangeEmptyObject = cong B.object (orderKeysEmpty (λ key → toList (assignmentPart false (B.property key))))


  rowOutputs : ∀ n c ss →
    map Row.output (map (λ s → row s (renderLine n c s)) ss) ≡ map (renderLine n c) ss
  rowOutputs n c [] = refl
  rowOutputs n c (s ∷ ss) = cong (λ out → renderLine n c s ∷ out) (rowOutputs n c ss)

  drawStatementLaw : ∀ p n c v → drawString p (display n c v) ≡
    foldr _++ˢ_ "" (map (renderLine n c) (B.flatten p v))
  drawStatementLaw p n c v = cong (foldr _++ˢ_ "") (rowOutputs n c (B.flatten p v))

  drawFromStatements : ∀ p n c v ss out → B.flatten p v ≡ ss →
    foldr _++ˢ_ "" (map (renderLine n c) ss) ≡ out → drawString p (display n c v) ≡ out
  drawFromStatements p n c v ss out flattened drawn =
    trans (drawStatementLaw p n c v)
      (trans (cong (λ ls → foldr _++ˢ_ "" (map (renderLine n c) ls)) {y = ss} flattened) drawn)

  appendRows : (xs ys heads tails : List B.Statement) →
    xs ≡ heads → ys ≡ tails → xs ++ ys ≡ heads ++ tails
  appendRows xs ys heads tails headEq tailEq =
    trans (cong (λ ls → ls ++ ys) {y = heads} headEq) (cong (λ ls → heads ++ ls) {y = tails} tailEq)

  flattenObjectShape : ∀ p fields body → B.flattenKeys p fields ≡ body →
    B.flatten p (B.object fields) ≡ B.assignment p B.objectMark ∷ body
  flattenObjectShape p fields body result =
    trans (B.flattenObject p fields) (cong (λ ls → B.assignment p B.objectMark ∷ ls) result)

  flattenArrayShape : ∀ p values body → B.flattenFrom p 0 values ≡ body →
    B.flatten p (B.array values) ≡ B.assignment p B.arrayMark ∷ body
  flattenArrayShape p values body result =
    trans (B.flattenArray p values) (cong (λ ls → B.assignment p B.arrayMark ∷ ls) result)

  flattenMember : ∀ p k v fields heads tails →
    B.flatten (p ++ (B.property k ∷ [])) v ≡ heads → B.flattenKeys p fields ≡ tails →
    B.flattenKeys p ((k , v) ∷ fields) ≡ heads ++ tails
  flattenMember p k v fields heads tails headEq tailEq =
    trans (B.flattenKeysNext p k v fields)
      (appendRows (B.flatten (p ++ (B.property k ∷ [])) v) (B.flattenKeys p fields) heads tails headEq tailEq)

  flattenElement : ∀ p i v values heads tails →
    B.flatten (p ++ (B.index i ∷ [])) v ≡ heads → B.flattenFrom p (suc i) values ≡ tails →
    B.flattenFrom p i (v ∷ values) ≡ heads ++ tails
  flattenElement p i v values heads tails headEq tailEq =
    trans (B.flattenFromNext p i v values)
      (appendRows (B.flatten (p ++ (B.index i ∷ [])) v) (B.flattenFrom p (suc i) values) heads tails headEq tailEq)

  -- Each phase of the specified observations is checked against its concrete result.
  decodedSorted : decodePrefix (toList "{\"-?\":4,\"- \":2,\"-!\":3,\"-\":1,\"a$\":5,\"a\":{\"-?\":6},\"A\":7}") ≡ inj₂ (parsed (B.object (("-?" , (B.scalar (B.number "4"))) ∷ ("- " , (B.scalar (B.number "2"))) ∷ ("-!" , (B.scalar (B.number "3"))) ∷ ("-" , (B.scalar (B.number "1"))) ∷ ("a$" , (B.scalar (B.number "5"))) ∷ ("a" , (B.object (("-?" , (B.scalar (B.number "6"))) ∷ []))) ∷ ("A" , (B.scalar (B.number "7"))) ∷ [])) [])
  decodedSorted = cong (fromDecoded fromValue) C.decodedSorted

  sortedKeyOrder : orderKeys (λ key → toList (assignmentPart false (B.property key)))
    (("-?" , (B.scalar (B.number "4"))) ∷ ("- " , (B.scalar (B.number "2"))) ∷ ("-!" , (B.scalar (B.number "3"))) ∷ ("-" , (B.scalar (B.number "1"))) ∷ ("a$" , (B.scalar (B.number "5"))) ∷ ("a" , (B.object (("-?" , (B.scalar (B.number "6"))) ∷ []))) ∷ ("A" , (B.scalar (B.number "7"))) ∷ []) ≡
    (("A" , (B.scalar (B.number "7"))) ∷ ("a" , (B.object (("-?" , (B.scalar (B.number "6"))) ∷ []))) ∷ ("a$" , (B.scalar (B.number "5"))) ∷ ("- " , (B.scalar (B.number "2"))) ∷ ("-!" , (B.scalar (B.number "3"))) ∷ ("-" , (B.scalar (B.number "1"))) ∷ ("-?" , (B.scalar (B.number "4"))) ∷ [])
  sortedKeyOrder = C.sortedKeyOrder
    (B.scalar (B.number "4")) (B.scalar (B.number "2")) (B.scalar (B.number "3"))
    (B.scalar (B.number "1")) (B.scalar (B.number "5"))
    (B.object (("-?" , B.scalar (B.number "6")) ∷ [])) (B.scalar (B.number "7"))

  sortedArrangement : arrange sorted (B.object (("-?" , (B.scalar (B.number "4"))) ∷ ("- " , (B.scalar (B.number "2"))) ∷ ("-!" , (B.scalar (B.number "3"))) ∷ ("-" , (B.scalar (B.number "1"))) ∷ ("a$" , (B.scalar (B.number "5"))) ∷ ("a" , (B.object (("-?" , (B.scalar (B.number "6"))) ∷ []))) ∷ ("A" , (B.scalar (B.number "7"))) ∷ [])) ≡
