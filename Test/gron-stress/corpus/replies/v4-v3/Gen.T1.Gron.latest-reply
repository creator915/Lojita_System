    (renderAt (config pairs false sorted) [] _ _ _ (arrangeSingleScalar (fromList ('x' ∷ fromℕ 11 ∷ fromℕ 8232 ∷ fromℕ 133 ∷ [])) (B.text (fromList (fromℕ 11 ∷ fromℕ 31 ∷ fromℕ 127 ∷ fromℕ 133 ∷ fromℕ 8232 ∷ fromℕ 8233 ∷ toList "<&>/")))) drawnEscaping)

observedDuplicate : forward (config assignments false sorted)
  (toList "{\"a\":1,\"\\u0061\":{\"z\":3},\"b\":2}") ≡
  report "json = {};\njson.a = {};\njson.a.z = 3;\njson.b = 2;\n" nothing
observedDuplicate =
  forwardShows (config assignments false sorted) _ _ [] _ decodedDuplicate
    (renderAt (config assignments false sorted) [] _ _ _ duplicateArrangement drawnDuplicate)

observedMalformedDuplicate : forward (config assignments false sorted)
  (toList "{\"a\":1,\"\\u0061\":nulx}") ≡
  report "" (just "invalid character 'x' in literal null (expecting 'l')")
observedMalformedDuplicate = forwardBad (config assignments false sorted) _ _ decodedMalformed

