module RenderConstructorRepair where

open import Data.List using (List; []; _∷_)
open import Data.Empty using (⊥)
open import Relation.Binary.PropositionalEquality using (_≡_; _≢_; subst; sym)

data Comparison : Set where
  before : Comparison
  equal : Comparison
  after : Comparison

data Permutation {A : Set} : List A → List A → Set where
  permutation-refl : {xs : _} → Permutation xs xs
  permutation-keep : {x : _} → {xs : _} → {ys : _} → Permutation xs ys → Permutation (x ∷ xs) (x ∷ ys)
  permutation-swap : {x : _} → {y : _} → {xs : _} → Permutation (x ∷ (y ∷ xs)) (y ∷ (x ∷ xs))
  permutation-trans : {xs ys zs : _} → Permutation xs ys → Permutation ys zs → Permutation xs zs

data Ordered {A : Set} (compare : A → A → Comparison) : List A → Set where
  ordered-empty : Ordered compare []
  ordered-single : (x : _) → Ordered compare (x ∷ [])
  ordered-next : {x : _} → {y : _} → {ys : _} → (compare x y ≢ Comparison.after) → Ordered compare (y ∷ ys) → Ordered compare (x ∷ (y ∷ ys))

prefixPermutation : {A : Set} → (x : A) → {xs ys : List A} → Permutation xs ys → Permutation (x ∷ xs) (x ∷ ys)
prefixPermutation x proof = permutation-keep {x = x} proof

adjacentOrder : {A : Set} → (cmp : A → A → Comparison) → (x y : A) → (ys : List A) → cmp x y ≢ after → Ordered cmp (y ∷ ys) → Ordered cmp (x ∷ (y ∷ ys))
adjacentOrder cmp x y ys previous ordered = ordered-next {x = x} {y = y} {ys = ys} previous ordered

noSharedDomain : ((A : Set) → A ≡ List A) → ⊥
noSharedDomain shared = subst (λ A → A) (sym (shared ⊥)) []
