module RenderBinderCheck where

open import Data.Empty using (⊥; ⊥-elim)
open import Data.List using (List; []; _∷_)
open import Data.Nat using (ℕ; _<_; _<?_)
open import Data.Nat.Properties using (<-irrefl)
open import Relation.Binary.PropositionalEquality using (refl)
open import Relation.Nullary using (Dec; yes; no)

variable
  B : Set
  x y : B
  xs ys : List B

data Permutation {A : Set} : List A → List A → Set where
  permutation-refl : {xs : _} → Permutation xs xs
  permutation-keep : {x xs ys : _} → Permutation xs ys → Permutation (x ∷ xs) (x ∷ ys)
  permutation-swap : {x y xs : _} → Permutation (x ∷ (y ∷ xs)) (y ∷ (x ∷ xs))
  permutation-trans : {xs ys zs : _} → Permutation xs ys → Permutation ys zs → Permutation xs zs

selfByDecision : (n : ℕ) → (xs : List ℕ) → Dec (n < n) → Permutation xs xs
selfByDecision n xs (yes lt) = ⊥-elim (<-irrefl refl lt)
selfByDecision n xs (no neg) = permutation-refl

self : (n : ℕ) → (xs : List ℕ) → Permutation (n ∷ xs) (n ∷ xs)
self n xs = permutation-keep {x = n} (selfByDecision n xs (n <? n))
