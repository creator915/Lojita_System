module Gen.T2.JsonInput.Comparison.Primitive where

open import Agda.Builtin.Char using (primCharEquality)
open import Agda.Builtin.String using (primStringEquality)
open import Data.Char using (Char)
open import Data.String using (String)
open import Data.Bool using (Bool; true; false)
open import Data.Empty using (⊥)
open import Relation.Binary.PropositionalEquality using (_≡_)
open import Relation.Nullary using (Dec; does; yes; no)
import Data.Char.Properties as Char
import Data.String.Properties as String
import Gen.T2.JsonInput.Comparison.Primitive.Reflection as Reflection

private
  compareDecision : {P : Set} {b : Bool} → (P → b ≡ true) → ((P → ⊥) → b ≡ false) →
                    (decision : Dec P) → b ≡ does decision
  compareDecision proveEqual proveDifferent (yes same) = proveEqual same
  compareDecision proveEqual proveDifferent (no different) = proveDifferent different

charAgreement : (c d : Char) → primCharEquality c d ≡ does (c Char.≟ d)
charAgreement c d =
  compareDecision (Reflection.charEqual c d) (Reflection.charDifferent c d) (c Char.≟ d)

stringAgreement : (s t : String) → primStringEquality s t ≡ does (s String.≟ t)
stringAgreement s t =
  compareDecision (Reflection.stringEqual s t) (Reflection.stringDifferent s t) (s String.≟ t)
