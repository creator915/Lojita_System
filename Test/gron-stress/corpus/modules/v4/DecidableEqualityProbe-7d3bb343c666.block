module DecidableEqualityProbe where

open import Data.Bool using (Bool; true; false)
open import Data.Char using (Char)
import Data.Char.Properties as Char
open import Data.Empty using (⊥-elim)
open import Data.String using (String)
import Data.String.Properties as String
open import Relation.Nullary using (Dec; does; yes; no)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)

charTest : Char → Char → Bool
charTest a b = does (a Char.≟ b)

stringTest : String → String → Bool
stringTest a b = does (a String.≟ b)

selfTest : {A : Set} {a : A} → (d : Dec (a ≡ a)) → does d ≡ true
selfTest (yes proof) = refl
selfTest (no refute) = ⊥-elim (refute refl)

trueTest : {A : Set} {a b : A} → (d : Dec (a ≡ b)) → does d ≡ true → a ≡ b
trueTest (yes proof) eq = proof
trueTest (no refute) ()

charReflexive : (a : Char) → charTest a a ≡ true
charReflexive a = selfTest (a Char.≟ a)

stringReflexive : (s : String) → stringTest s s ≡ true
stringReflexive s = selfTest (s String.≟ s)
