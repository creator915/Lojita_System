{-# OPTIONS --guardedness #-}
module JsonInputProbe where

open import Agda.Builtin.Char using (primNatToChar)
open import Data.List using (List; []; _∷_; replicate)
open import Data.Nat.Show renaming (show to showNat)
open import Data.Product using (_,_; proj₂)
open import Data.String using (String; fromList; show) renaming (_++_ to _++ˢ_)
open import Data.Unit using (⊤; tt)
import IO.Primitive as IO
import IO.Primitive.Finite as F
open import Ownership using (St; Dir; Chan; Srv; Prog; withEphemeral; mkdir; open′; call; stop; rmdir; done; _>>_; _>>=_)
open import OwnershipIO.FFI using (ProcResult; procResult)
open import SessionEnv

record Trial : Set where
  constructor trial
  field
    label : String
    args : List String
    input : String

settings : List Trial
settings =
  trial "backspace-glyph" [] (fromList ('"' ∷ (primNatToChar 8 ∷ []))) ∷
  trial "tab-glyph" [] "\"\t\"" ∷
  trial "formfeed-glyph" [] (fromList ('"' ∷ (primNatToChar 12 ∷ []))) ∷
  trial "return-glyph" [] "\"\r\"" ∷
  trial "delete-glyph" [] (fromList (primNatToChar 127 ∷ [])) ∷
  trial "capped-stream-after-invalid" ("-s" ∷ []) ("true\n[!\nnull" ++ˢ fromList (replicate 1048572 ' ')) ∷
  []

previousSettings : List Trial
previousSettings =
  trial "strict-spaced" ("-ju" ∷ []) "[[\"a\"],true]\n" ∷
  trial "strict-spaced-real" ("-j" ∷ "-u" ∷ []) " [ [ \"a\" , 1 ] , true ] \r\n" ∷
  trial "strict-trailing-space" ("-j" ∷ "-u" ∷ []) "[[],true]\r \t\n" ∷
  trial "strict-empty" ("-j" ∷ "-u" ∷ []) "" ∷
  trial "forward-zero-eof" [] "0" ∷
  trial "forward-true-suffix" [] "true!false" ∷
  trial "forward-array-suffix" [] "[]!false" ∷
  trial "empty-line" ("-s" ∷ []) "\n" ∷
  trial "final-cr-only" ("-s" ∷ []) "\r" ∷
  trial "long-line-last-accepted" ("-s" ∷ []) ("true" ++ˢ (fromList (replicate 65531 ' ') ++ˢ "\nnull\n")) ∷
  trial "long-line-first-rejected" ("-s" ∷ []) ("true" ++ˢ (fromList (replicate 65532 ' ') ++ˢ "\nnull\n")) ∷
  trial "long-line-later-rejected" ("-s" ∷ []) ("true\nnull" ++ˢ (fromList (replicate 65532 ' ') ++ˢ "\nfalse\n")) ∷
  trial "long-line-final-rejected" ("-s" ∷ []) ("true" ++ˢ fromList (replicate 65532 ' ')) ∷
  trial "nul" [] "\0" ∷
  trial "apostrophe" [] "'" ∷
  trial "slash" [] "\\" ∷
  trial "bell" [] "\a" ∷
  trial "vertical-tab" [] "\v" ∷
  trial "non-ascii-two" [] "é" ∷
  trial "non-ascii-three" [] "中" ∷
  trial "non-ascii-four" [] "😀" ∷
  trial "unfinished-escape" [] "\"\\u12" ∷
  trial "unfinished-keyword" [] "tru" ∷
  trial "non-hex-after-high" [] "\"\\uD800\\u00X0\"" ∷
  trial "high-then-low" [] "\"\\uD800\\uDBFF\\uDFFF\"" ∷
  []

Live : St
Live = Dir (("procExec" , Chan (Srv ProcReq ProcOut (Dir []))) ∷ [])

resultText : String → ProcResult → String
resultText label (procResult code out err) =
  label ++ˢ " [" ++ˢ showNat code ++ˢ "] " ++ˢ show out ++ˢ " " ++ˢ show err

observe : List Trial → Prog SessionΨ Live Live (List String)
observe [] = done []
observe (trial label args input ∷ rest) =
  call "procExec" (procReq "ref" args input) >>= λ result →
  observe rest >>= λ others →
  done (resultText label result ∷ others)

probe : Prog SessionΨ (Dir []) (Dir []) (List String)
probe = withEphemeral "inputProbe"
  (mkdir "procExec" >> open′ "procExec" >> observe settings >>= λ result →
   stop "procExec" >> rmdir "procExec" >> done result)

printAll : List String → IO.IO ⊤
printAll [] = IO.return tt
printAll (x ∷ xs) = F.putStrLn x IO.>>= λ _ → printAll xs

main : IO.IO ⊤
main = evalIO sessionEnv probe tt IO.>>= λ result → printAll (proj₂ result)
