module NativeAgreementProbe where

open import Data.Bool using (Bool)
open import Data.Char using (Char)
open import Data.String using (String)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Relation.Nullary using (does)
import Data.Char as Char using (_≟_)
import Data.String as String using (_≟_)

char-equal : Char → Char → Bool
char-equal c d = does (c Char.≟ d)

char-agrees : (c d : Char) → char-equal c d ≡ does (c Char.≟ d)
char-agrees c d = refl

string-equal : String → String → Bool
string-equal s t = does (s String.≟ t)

string-agrees : (s t : String) → string-equal s t ≡ does (s String.≟ t)
string-agrees s t = refl
