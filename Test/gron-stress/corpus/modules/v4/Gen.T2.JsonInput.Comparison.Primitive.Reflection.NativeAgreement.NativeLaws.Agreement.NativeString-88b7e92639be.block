module Gen.T2.JsonInput.Comparison.Primitive.Reflection.NativeAgreement.NativeLaws.Agreement.NativeString where

open import Agda.Builtin.String using (String; primStringEquality)
open import Agda.Builtin.String.Properties using (primStringToListInjective)
open import Data.String.Properties using (_≟_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Relation.Nullary using (Dec; does; yes; no)
open import Data.Empty using (⊥-elim)
open import Data.Bool using (true)

private
  decision-true : ∀ {A : Set} (d : Dec A) → A → does d ≡ true
  decision-true (yes _) _ = refl
  decision-true (no noA) a = ⊥-elim (noA a)

  decision-proof : ∀ {A : Set} (d : Dec A) → does d ≡ true → A
  decision-proof (yes a) _ = a
  decision-proof (no _) ()

string-complete : (s t : String) → (s ≡ t) → primStringEquality s t ≡ true
string-complete s t p = decision-true (s ≟ t) p

string-sound : (s t : String) → (primStringEquality s t ≡ true) → s ≡ t
string-sound s t p = decision-proof (s ≟ t) p
