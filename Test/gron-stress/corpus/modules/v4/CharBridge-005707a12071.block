module CharBridge where
open import Agda.Builtin.Char using (Char; primCharEquality)
open import Agda.Builtin.Char.Properties using (primCharToNatInjective; primCharEqualityRefl; primCharEqualityTrue; primCharToNatToChar; primCharToNatBound; primCharEqualityInjective; primCharEqualityCorrect; primCharEqualityReflexive; primNatToCharToNat)
open import Data.Char.Properties using (toℕ-injective; ==-reflexive; ==-refl; ==-irrefl; ==⇒≡; ≡⇒==; ==-reflects; ==-correct; ≟-refl)
open import Relation.Nullary using (does)
open import Data.Bool using (false; true)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
checked : (c d : Char) → does (Fast._≟_ c d) ≡ primCharEquality c d
checked c d with true
... | true = refl
... | false = refl
