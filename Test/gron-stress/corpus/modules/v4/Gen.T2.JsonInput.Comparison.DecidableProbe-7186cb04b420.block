module Gen.T2.JsonInput.Comparison.DecidableProbe where

open import Data.Bool using (Bool; true)
open import Data.Char using (Char)
open import Data.Empty using (⊥-elim)
open import Data.String using (String)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Relation.Nullary using (Dec; does; yes; no)
import Data.Char.Properties as Char
import Data.String.Properties as String

charEq : Char → Char → Bool
charEq c d = does (Char._≟_ c d)

stringEq : String → String → Bool
stringEq s t = does (String._≟_ s t)

private
  decTrue : {P : Set} → (d : Dec P) → P → does d ≡ true
  decTrue (yes _) _ = refl
  decTrue (no notP) p = ⊥-elim (notP p)

  decSound : {P : Set} → (d : Dec P) → (does d ≡ true) → P
  decSound (yes p) _ = p
  decSound (no _) ()

charReflexive : (c : Char) → charEq c c ≡ true
charReflexive c = decTrue (Char._≟_ c c) refl

charSound : (c d : Char) → (charEq c d ≡ true) → c ≡ d
charSound c d = decSound (Char._≟_ c d)

stringReflexive : (s : String) → stringEq s s ≡ true
stringReflexive s = decTrue (String._≟_ s s) refl

stringSound : (s t : String) → (stringEq s t ≡ true) → s ≡ t
stringSound s t = decSound (String._≟_ s t)
