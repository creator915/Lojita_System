module FrameDraft where

open import Agda.Builtin.Char using (primCharEquality)
open import Data.Bool using (Bool; false; true; _∧_; _∨_)
open import Data.Char using (Char; toℕ)
open import Data.Empty using (⊥-elim)
open import Data.List using (List; []; _∷_; [_]; _++_; any)
open import Data.Nat using (ℕ; zero; suc; _+_; _<ᵇ_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl; cong)

record FrameScan : Set where
  constructor frameScan
  field
    frames : List (List Char)
    tooLong : Bool

falseAtOne : (n : ℕ) → ((suc n) <ᵇ 1) ≡ false
falseAtOne n with n
... | zero = refl
... | suc k = refl

cutFor : (lower gap n : ℕ) → (((lower + gap) <ᵇ n) ≡ true) → (n <ᵇ suc lower) ≡ false
cutFor zero gap zero ()
cutFor (suc lower) gap zero ()
cutFor zero gap (suc n) eq = falseAtOne n
cutFor (suc lower) gap (suc n) eq = cutFor lower gap n eq

bothLeft : (a b : Bool) → ((a ∧ b) ≡ true) → a ≡ true
bothLeft true b eq = refl
bothLeft false b ()

bothRight : (a b : Bool) → ((a ∧ b) ≡ true) → b ≡ true
bothRight true b eq = eq
bothRight false b ()

widthOf : ℕ → ℕ
widthOf n with n <ᵇ 128
... | true = 1
... | false with n <ᵇ 2048
...   | true = 2
...   | false with n <ᵇ 65536
...     | true = 3
...     | false = 4

utf8Width : Char → ℕ
utf8Width c = widthOf (toℕ c)

asciiWidth : (c : _) → ((toℕ c <ᵇ 128) ≡ true) → utf8Width c ≡ 1
asciiWidth c p rewrite p = refl

twoByteWidth : (c : _) → (((127 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 2048)) ≡ true) → utf8Width c ≡ 2
twoByteWidth c p rewrite cutFor 127 0 (toℕ c) (bothLeft (127 <ᵇ toℕ c) (toℕ c <ᵇ 2048) p) | bothRight (127 <ᵇ toℕ c) (toℕ c <ᵇ 2048) p = refl

threeByteWidth : (c : _) → (((2047 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 65536)) ≡ true) → utf8Width c ≡ 3
threeByteWidth c p rewrite cutFor 127 1920 (toℕ c) (bothLeft (2047 <ᵇ toℕ c) (toℕ c <ᵇ 65536) p) | cutFor 2047 0 (toℕ c) (bothLeft (2047 <ᵇ toℕ c) (toℕ c <ᵇ 65536) p) | bothRight (2047 <ᵇ toℕ c) (toℕ c <ᵇ 65536) p = refl

fourByteWidth : (c : _) → ((65535 <ᵇ toℕ c) ≡ true) → utf8Width c ≡ 4
fourByteWidth c p rewrite cutFor 127 65408 (toℕ c) p | cutFor 2047 63488 (toℕ c) p | cutFor 65535 0 (toℕ c) p = refl

byteCount : List Char → ℕ
byteCount [] = zero
byteCount (c ∷ xs) = utf8Width c + byteCount xs

noBytes : byteCount [] ≡ 0
noBytes = refl

moreBytes : (c : _) → (xs : _) → byteCount (c ∷ xs) ≡ (utf8Width c + byteCount xs)
moreBytes c xs = refl

lineContent : List Char → List Char
lineContent [] = []
lineContent (c ∷ d ∷ xs) = c ∷ lineContent (d ∷ xs)
lineContent (c ∷ []) with primCharEquality c '\r'
... | true = []
... | false = [ c ]

noLineContent : lineContent [] ≡ []
noLineContent = refl

stripFinalCR : (xs : _) → lineContent (xs ++ ([ '\r' ])) ≡ xs
stripFinalCR [] = refl
stripFinalCR (c ∷ []) = refl
stripFinalCR (c ∷ d ∷ xs) = cong (λ ys → c ∷ ys) (stripFinalCR (d ∷ xs))

keepFinalChar : (xs : _) → (c : _) → (primCharEquality c '\r' ≡ false) → lineContent (xs ++ ([ c ])) ≡ (xs ++ ([ c ]))
keepFinalChar [] c eq rewrite eq = refl
keepFinalChar (d ∷ []) c eq = cong (λ ys → d ∷ ys) (keepFinalChar [] c eq)
keepFinalChar (d ∷ e ∷ xs) c eq = cong (λ ys → d ∷ ys) (keepFinalChar (e ∷ xs) c eq)

frameLimit : ℕ
frameLimit = 1048576

lineBufferCapacity : frameLimit ≡ 1048576
lineBufferCapacity = refl

data LineView : Set where
  end : LineView
  final : List Char → LineView
  terminated : List Char → FrameScan → LineView

keepFrame : List Char → FrameScan → FrameScan
keepFrame xs (frameScan ls capped) = frameScan (lineContent xs ∷ ls) capped

finishLine : Bool → List Char → FrameScan → FrameScan
finishLine true xs after = keepFrame xs after
finishLine false xs after = frameScan [] true

renderView : LineView → FrameScan
renderView end = frameScan [] false
renderView (final xs) = finishLine (byteCount xs <ᵇ frameLimit) xs (frameScan [] false)
renderView (terminated xs after) = finishLine (byteCount xs <ᵇ frameLimit) xs after

extendLine : Bool → Char → LineView → LineView
extendLine true c next = terminated [] (renderView next)
extendLine false c end = final [ c ]
extendLine false c (final xs) = final (c ∷ xs)
extendLine false c (terminated xs after) = terminated (c ∷ xs) after

lineView : List Char → LineView
lineView [] = end
lineView (c ∷ xs) = extendLine (primCharEquality '\n' c) c (lineView xs)

physicalLines : List Char → FrameScan
physicalLines xs = renderView (lineView xs)

noPhysicalLines : physicalLines [] ≡ frameScan [] false
noPhysicalLines = refl

viewTerminated : (xs ys : List Char) → any (primCharEquality '\n') xs ≡ false →
  lineView (xs ++ ('\n' ∷ ys)) ≡ terminated xs (physicalLines ys)
viewTerminated [] ys eq = refl
viewTerminated (c ∷ xs) ys eq with primCharEquality '\n' c
... | false = cong (extendLine false c) (viewTerminated xs ys eq)
... | true with eq
...   | ()

lastView : List Char → LineView
lastView [] = end
lastView (c ∷ xs) = final (c ∷ xs)

extendFinal : (c : Char) → (xs : List Char) →
  extendLine false c (lastView xs) ≡ final (c ∷ xs)
extendFinal c [] = refl
extendFinal c (d ∷ xs) = refl

viewFinal : (xs : List Char) → any (primCharEquality '\n') xs ≡ false → lineView xs ≡ lastView xs
viewFinal [] eq = refl
viewFinal (c ∷ xs) eq with primCharEquality '\n' c
... | false rewrite viewFinal xs eq = extendFinal c xs
... | true with eq
...   | ()

terminatedLine : (xs : _) → (ys : _) → (ls : _) → (capped : _) → (any (primCharEquality '\n') xs ≡ false) → ((byteCount xs <ᵇ frameLimit) ≡ true) → (physicalLines ys ≡ frameScan ls capped) → physicalLines (xs ++ ('\n' ∷ ys)) ≡ frameScan (lineContent xs ∷ ls) capped
terminatedLine xs ys ls capped noLF within tailEq rewrite viewTerminated xs ys noLF | within | tailEq = refl

finalLine : (c : _) → (xs : _) → (any (primCharEquality '\n') (c ∷ xs) ≡ false) → ((byteCount (c ∷ xs) <ᵇ frameLimit) ≡ true) → physicalLines (c ∷ xs) ≡ frameScan ([ lineContent (c ∷ xs) ]) false
finalLine c xs noLF within rewrite viewFinal (c ∷ xs) noLF | within = refl

oversizedLine : (xs : _) → (ys : _) → (any (primCharEquality '\n') xs ≡ false) → ((byteCount xs <ᵇ frameLimit) ≡ false) → physicalLines (xs ++ ('\n' ∷ ys)) ≡ frameScan [] true
oversizedLine xs ys noLF exceeds rewrite viewTerminated xs ys noLF | exceeds = refl

oversizedFinalLine : (c : _) → (xs : _) → (any (primCharEquality '\n') (c ∷ xs) ≡ false) → ((byteCount (c ∷ xs) <ᵇ frameLimit) ≡ false) → physicalLines (c ∷ xs) ≡ frameScan [] true
oversizedFinalLine c xs noLF exceeds rewrite viewFinal (c ∷ xs) noLF | exceeds = refl
