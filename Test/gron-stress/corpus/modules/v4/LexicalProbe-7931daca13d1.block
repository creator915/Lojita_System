module LexicalProbe where

open import Agda.Builtin.Char using (primCharEquality)
open import Agda.Builtin.String using (primStringEquality)
open import Data.Bool using (true; false)
open import Data.Char using (Char; toℕ)
import Data.Char.Properties as Char
open import Data.Nat using (_≡ᵇ_)
open import Data.String using (String)
import Data.String.Properties as String
open import Relation.Nullary using (does)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)

charConversion : (c d : Char) → does (c Char.≟ d) ≡ (toℕ c ≡ᵇ toℕ d)
charConversion c d with true
... | true = refl
... | false = refl

stringConversion : (s t : String) → primStringEquality s t ≡ does (s String.≟ t)
stringConversion s t with true
... | true = refl
... | false = refl
