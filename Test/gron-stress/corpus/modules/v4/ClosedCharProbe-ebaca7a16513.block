module ClosedCharProbe where
open import Agda.Builtin.Char using (primCharEquality)
open import Data.Bool using (true; false)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)

carriage : primCharEquality '\r' '\r' ≡ true
carriage with true
... | true = refl
... | false = refl

newline : primCharEquality '\n' '\n' ≡ true
newline with true
... | true = refl
... | false = refl
