module Gen.T2.JsonInput.Comparison.Primitive.Reflection where

open import Data.Bool using (Bool; true; false)
open import Data.Char as Char using (Char)
open import Data.Empty using (⊥-elim)
open import Data.String as String using (String)
open import Relation.Binary.PropositionalEquality using (_≡_; _≢_; refl)
open import Relation.Nullary using (Dec; does; yes; no; ¬_)
import Data.Char as CharDec using (_≟_)
import Data.String as StringDec using (_≟_)

private
  decide-true : {P : Set} → (p : Dec P) → P → does p ≡ true
  decide-true (yes _) _ = refl
  decide-true (no not-p) p = ⊥-elim (not-p p)

  decide-false : {P : Set} → (p : Dec P) → ¬ P → does p ≡ false
  decide-false (yes p) not-p = ⊥-elim (not-p p)
  decide-false (no _) _ = refl

charCompare : Char → Char → Bool
charCompare c d = does (c CharDec.≟ d)

stringCompare : String → String → Bool
stringCompare s t = does (s StringDec.≟ t)

charEqual : (c d : Char) → (c ≡ d) → charCompare c d ≡ true
charEqual c d eq = decide-true (c CharDec.≟ d) eq

charDifferent : (c d : Char) → (c ≢ d) → charCompare c d ≡ false
charDifferent c d neq = decide-false (c CharDec.≟ d) neq

stringEqual : (s t : String) → (s ≡ t) → stringCompare s t ≡ true
stringEqual s t eq = decide-true (s StringDec.≟ t) eq

stringDifferent : (s t : String) → (s ≢ t) → stringCompare s t ≡ false
stringDifferent s t neq = decide-false (s StringDec.≟ t) neq
