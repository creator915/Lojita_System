module Gen.T1.Gron where

open import Data.Bool using (Bool; true; false; not; _∧_; _∨_; if_then_else_)
open import Data.Char using (Char; toℕ; fromℕ)
import Agda.Builtin.Char.Properties as CharProof
import Agda.Builtin.String.Properties as StringProof
open import Data.List using (List; []; _∷_; _++_; all; map; foldr; length)
open import Data.Empty using (⊥; ⊥-elim)
open import Data.Maybe using (Maybe; just; nothing)
open import Data.Nat using (ℕ; zero; suc; _+_; _*_; _∸_; _<ᵇ_; _≡ᵇ_)
import Data.Nat.Show as Nat
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Data.String using (String; toList; fromList) renaming (_++_ to _++ˢ_)
open import Data.Sum using (_⊎_; inj₁; inj₂)
open import Relation.Binary.PropositionalEquality using (_≡_; _≢_; refl; cong; sym; trans; subst)
import Gen.T0.Gron as B

data Notation : Set where
  assignments pairs : Notation

data Ordering : Set where
  before equal after : Ordering

data SortMode : Set where
  sorted given : SortMode

data Shade : Set where
  name container numeral quoted constant : Shade

data Listed (word : List Char) : List (List Char) → Set where
  first : ∀ {words} → Listed word (word ∷ words)
  later : ∀ {other words} → Listed word words → Listed word (other ∷ words)

record Parsed (A : Set) : Set where
  constructor parsed
  field
    value : A
    rest : List Char

record Display : Set where
  constructor display
  field
    notation : Notation
    color : Bool
    tree : B.Value

record Row : Set where
  constructor row
  field
    statement : B.Statement
    output : String

record Config : Set where
  constructor config
  field
    notation : Notation
    color : Bool
    sorting : SortMode

record Report : Set where
  constructor report
  field
    output : String
    issue : Maybe String

private
  sameChars : List Char → List Char → Bool
  sameChars [] [] = true
  sameChars [] (d ∷ ds) = false
  sameChars (c ∷ cs) [] = false
  sameChars (c ∷ cs) (d ∷ ds) = (toℕ c ≡ᵇ toℕ d) ∧ sameChars cs ds

  sameCharsCons : ∀ c cs d ds →
    sameChars (c ∷ cs) (d ∷ ds) ≡ (toℕ c ≡ᵇ toℕ d) ∧ sameChars cs ds
  sameCharsCons c cs d ds = refl

  sameCharsLeftEmpty : ∀ d ds → sameChars [] (d ∷ ds) ≡ false
  sameCharsLeftEmpty d ds = refl

  sameCharsRightEmpty : ∀ c cs → sameChars (c ∷ cs) [] ≡ false
  sameCharsRightEmpty c cs = refl

  sameNatRefl : ∀ n → (n ≡ᵇ n) ≡ true
  sameNatRefl zero = refl
  sameNatRefl (suc n) = sameNatRefl n

  sameNatSound : ∀ m n → (m ≡ᵇ n) ≡ true → m ≡ n
  sameNatSound zero zero h = refl
  sameNatSound zero (suc n) ()
  sameNatSound (suc m) zero ()
  sameNatSound (suc m) (suc n) h = cong suc (sameNatSound m n h)

  andTrue : ∀ p q → p ∧ q ≡ true → (p ≡ true) × (q ≡ true)
  andTrue false q ()
  andTrue true q h = refl , h

  falseTrue : false ≡ true → ⊥
  falseTrue ()

  staysFalse : ∀ b → (b ≡ true → ⊥) → b ≡ false
  staysFalse false impossible = refl
  staysFalse true impossible = ⊥-elim (impossible refl)

  sameCharsRefl : ∀ cs → sameChars cs cs ≡ true
  sameCharsRefl [] = refl
  sameCharsRefl (c ∷ cs) =
    trans (sameCharsCons c cs c cs)
      (trans (cong (λ b → b ∧ sameChars cs cs) (sameNatRefl (toℕ c))) (sameCharsRefl cs))

  sameCharsSound : ∀ cs ds → sameChars cs ds ≡ true → cs ≡ ds
  sameCharsSound [] [] h = refl
  sameCharsSound [] (d ∷ ds) h = ⊥-elim (falseTrue (trans (sym (sameCharsLeftEmpty d ds)) h))
  sameCharsSound (c ∷ cs) [] h = ⊥-elim (falseTrue (trans (sym (sameCharsRightEmpty c cs)) h))
  sameCharsSound (c ∷ cs) (d ∷ ds) h =
    let both = andTrue (toℕ c ≡ᵇ toℕ d) (sameChars cs ds) (trans (sym (sameCharsCons c cs d ds)) h)
        heads = CharProof.primCharToNatInjective c d (sameNatSound (toℕ c) (toℕ d) (proj₁ both)) in
    trans (cong (λ head → head ∷ cs) heads)
      (cong (λ tail → d ∷ tail) (sameCharsSound cs ds (proj₂ both)))

hasKey : String → List (String × B.Value) → Bool
hasKey k [] = false
hasKey k ((j , v) ∷ xs) = sameChars (toList k) (toList j) ∨ hasKey k xs

private
  hasKeyStep : ∀ k j v xs → hasKey k ((j , v) ∷ xs) ≡ sameChars (toList k) (toList j) ∨ hasKey k xs
  hasKeyStep k j v xs = refl

keepLatest : List (String × B.Value) → List (String × B.Value)
keepLatest [] = []
keepLatest ((k , v) ∷ xs) =
  let kept = keepLatest xs in
  if hasKey k kept then kept else (k , v) ∷ kept

hasKeyEmpty : ∀ k → hasKey k [] ≡ false
hasKeyEmpty k = refl

hasKeySame : ∀ k v xs → hasKey k ((k , v) ∷ xs) ≡ true
hasKeySame k v xs =
  trans (hasKeyStep k k v xs) (cong (λ b → b ∨ hasKey k xs) (sameCharsRefl (toList k)))

hasKeyOther : ∀ k j v xs → k ≢ j → hasKey k ((j , v) ∷ xs) ≡ hasKey k xs
hasKeyOther k j v xs different =
  trans (hasKeyStep k j v xs)
    (cong (λ b → b ∨ hasKey k xs)
      (staysFalse (sameChars (toList k) (toList j))
        (λ h → different (StringProof.primStringToListInjective k j (sameCharsSound (toList k) (toList j) h)))))

keepLatestEmpty : keepLatest [] ≡ []
keepLatestEmpty = refl

keepLatestNext : ∀ k v xs → keepLatest ((k , v) ∷ xs) ≡
  (if hasKey k (keepLatest xs) then keepLatest xs else (k , v) ∷ keepLatest xs)
keepLatestNext k v xs = refl

compareText : List Char → List Char → Ordering
compareText [] [] = equal
compareText [] (d ∷ ds) = before
compareText (c ∷ cs) [] = after
compareText (c ∷ cs) (d ∷ ds) =
  if toℕ c <ᵇ toℕ d then before else if toℕ d <ᵇ toℕ c then after else compareText cs ds

compareEmpty : compareText [] [] ≡ equal
compareEmpty = refl

compareLeftEmpty : ∀ c cs → compareText [] (c ∷ cs) ≡ before
compareLeftEmpty c cs = refl

compareRightEmpty : ∀ c cs → compareText (c ∷ cs) [] ≡ after
compareRightEmpty c cs = refl

compareNext : ∀ c cs d ds → compareText (c ∷ cs) (d ∷ ds) ≡
  (if toℕ c <ᵇ toℕ d then before else if toℕ d <ᵇ toℕ c then after else compareText cs ds)
compareNext c cs d ds = refl

private
  precede : {A : Set} → Ordering → A → A → A
  precede before earlier laterValue = earlier
  precede equal earlier laterValue = earlier
  precede after earlier laterValue = laterValue

insertKey : (String → List Char) → (String × B.Value) → List (String × B.Value) → List (String × B.Value)
insertKey rank kv [] = kv ∷ []
insertKey rank kv (head ∷ tail) =
  precede (compareText (rank (proj₁ kv)) (rank (proj₁ head)))
    (kv ∷ head ∷ tail) (head ∷ insertKey rank kv tail)

orderKeys : (String → List Char) → List (String × B.Value) → List (String × B.Value)
orderKeys rank [] = []
orderKeys rank (kv ∷ xs) = insertKey rank kv (orderKeys rank xs)

insertEmpty : ∀ rank kv → insertKey rank kv [] ≡ kv ∷ []
insertEmpty rank kv = refl

insertBefore : ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ before →
  insertKey rank (k , v) ((j , w) ∷ xs) ≡ (k , v) ∷ (j , w) ∷ xs
insertBefore rank k v j w xs order =
  cong (λ o → precede o ((k , v) ∷ (j , w) ∷ xs) ((j , w) ∷ insertKey rank (k , v) xs)) order

insertEqual : ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ equal →
  insertKey rank (k , v) ((j , w) ∷ xs) ≡ (k , v) ∷ (j , w) ∷ xs
insertEqual rank k v j w xs order =
  cong (λ o → precede o ((k , v) ∷ (j , w) ∷ xs) ((j , w) ∷ insertKey rank (k , v) xs)) order

insertAfter : ∀ rank k v j w xs → compareText (rank k) (rank j) ≡ after →
  insertKey rank (k , v) ((j , w) ∷ xs) ≡ (j , w) ∷ insertKey rank (k , v) xs
insertAfter rank k v j w xs order =
  cong (λ o → precede o ((k , v) ∷ (j , w) ∷ xs) ((j , w) ∷ insertKey rank (k , v) xs)) order

orderKeysEmpty : ∀ rank → orderKeys rank [] ≡ []
orderKeysEmpty rank = refl

orderKeysNext : ∀ rank kv xs → orderKeys rank (kv ∷ xs) ≡ insertKey rank kv (orderKeys rank xs)
orderKeysNext rank kv xs = refl

private
  digitCode : ℕ → Bool
  digitCode n = (47 <ᵇ n) ∧ (n <ᵇ 58)

  asciiName : ℕ → Bool
  asciiName n = (n ≡ᵇ 36) ∨ (n ≡ᵇ 95) ∨ ((64 <ᵇ n) ∧ (n <ᵇ 91)) ∨ ((96 <ᵇ n) ∧ (n <ᵇ 123))

  -- Inclusive Unicode 17 category ranges. Each bound uses four base-64 digits.
  -- The first table holds L and Nl. The second holds Mn, Mc, Nd and Pc.
  sextet : Char → ℕ
  sextet '+' = 62
  sextet '/' = 63
  sextet c =
    let n = toℕ c in
    if n <ᵇ 58 then n ∸ 48 else if n <ᵇ 91 then n ∸ 55 else n ∸ 61

  rangeBound : Char → Char → Char → Char → ℕ
  rangeBound a b c d = (sextet a * 64 + sextet b) * 4096 + sextet c * 64 + sextet d

  inRanges : ℕ → List Char → Bool
  inRanges n (a ∷ b ∷ c ∷ d ∷ e ∷ f ∷ g ∷ h ∷ rs) =
    if n <ᵇ rangeBound a b c d then false
    else if rangeBound e f g h <ᵇ n then inRanges n rs
    else true
  inRanges n _ = false

  startRanges : List Char
  startRanges = toList ""

  continueRanges : List Char
  continueRanges = toList ""

canStart canContinue : Char → Bool
canStart c =
  let n = toℕ c in
  if n <ᵇ 128 then asciiName n else inRanges n startRanges
canContinue c =
  let n = toℕ c in
  canStart c ∨ (if n <ᵇ 128 then digitCode n else inRanges n continueRanges)

asciiStart : ∀ c → (toℕ c <ᵇ 128) ≡ true → canStart c ≡
  ((toℕ c ≡ᵇ 36) ∨ (toℕ c ≡ᵇ 95) ∨
   ((64 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 91)) ∨ ((96 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 123)))
asciiStart c isAscii =
  cong (λ b → if b then asciiName (toℕ c) else inRanges (toℕ c) startRanges) isAscii

asciiContinue : ∀ c → (toℕ c <ᵇ 128) ≡ true → canContinue c ≡
  (canStart c ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58)))
asciiContinue c isAscii =
  cong (λ b → canStart c ∨ (if b then digitCode (toℕ c) else inRanges (toℕ c) continueRanges)) isAscii

reservedWords : List (List Char)
reservedWords = map toList
  ("break" ∷ "case" ∷ "catch" ∷ "class" ∷ "const" ∷ "continue" ∷ "debugger" ∷
   "default" ∷ "delete" ∷ "do" ∷ "else" ∷ "export" ∷ "extends" ∷ "false" ∷
   "finally" ∷ "for" ∷ "function" ∷ "if" ∷ "import" ∷ "in" ∷ "instanceof" ∷
   "new" ∷ "null" ∷ "return" ∷ "super" ∷ "switch" ∷ "this" ∷ "throw" ∷
   "true" ∷ "try" ∷ "typeof" ∷ "var" ∷ "void" ∷ "while" ∷ "with" ∷ "yield" ∷ [])

private
  reservedIn : List Char → List (List Char) → Bool
  reservedIn w [] = false
  reservedIn w (j ∷ ws) = sameChars w j ∨ reservedIn w ws

  reservedInEmpty : ∀ w → reservedIn w [] ≡ false
  reservedInEmpty w = refl

  reservedInNext : ∀ w j ws → reservedIn w (j ∷ ws) ≡ sameChars w j ∨ reservedIn w ws
  reservedInNext w j ws = refl

  orTrueRight : ∀ b → b ∨ true ≡ true
  orTrueRight true = refl
  orTrueRight false = refl

  orTrue : ∀ p q → p ∨ q ≡ true → (p ≡ true) ⊎ (q ≡ true)
  orTrue true q h = inj₁ refl
  orTrue false q h = inj₂ h

  listedTrue : ∀ {w ws} → Listed w ws → reservedIn w ws ≡ true
  listedTrue {w} (first {words}) =
    trans (reservedInNext w w words) (cong (λ b → b ∨ reservedIn w words) (sameCharsRefl w))
  listedTrue {w} (later {other} {words} found) =
    trans (reservedInNext w other words)
      (trans (cong (λ b → sameChars w other ∨ b) (listedTrue found)) (orTrueRight (sameChars w other)))

  listedEither : ∀ w j ws → (sameChars w j ≡ true) ⊎ (reservedIn w ws ≡ true) →
    (reservedIn w ws ≡ true → Listed w ws) → Listed w (j ∷ ws)
  listedEither w j ws (inj₁ h) findTail =
    subst (λ key → Listed key (j ∷ ws)) (sym (sameCharsSound w j h)) first
  listedEither w j ws (inj₂ h) findTail = later (findTail h)

  trueListed : ∀ w ws → reservedIn w ws ≡ true → Listed w ws
  trueListed w [] h = ⊥-elim (falseTrue (trans (sym (reservedInEmpty w)) h))
  trueListed w (j ∷ ws) h =
    listedEither w j ws (orTrue (sameChars w j) (reservedIn w ws) (trans (sym (reservedInNext w j ws)) h))
      (λ hTail → trueListed w ws hTail)

reserved identifier : List Char → Bool
reserved w = reservedIn w reservedWords
identifier [] = false
identifier (c ∷ cs) = canStart c ∧ all canContinue cs ∧ not (reserved (c ∷ cs))

private
  reservedAt : ∀ w → reserved w ≡ reservedIn w reservedWords
  reservedAt w = refl

reservedIncluded : ∀ w → Listed w reservedWords → reserved w ≡ true
reservedIncluded w found = trans (reservedAt w) (listedTrue found)

reservedExcluded : ∀ w → (Listed w reservedWords → ⊥) → reserved w ≡ false
reservedExcluded w missing =
  trans (reservedAt w) (staysFalse (reservedIn w reservedWords) (λ h → missing (trueListed w reservedWords h)))

emptyIdentifier : identifier [] ≡ false
emptyIdentifier = refl

identifierForm : ∀ c cs → identifier (c ∷ cs) ≡ (canStart c ∧ all canContinue cs ∧ not (reserved (c ∷ cs)))
identifierForm c cs = refl

observedReservedWords : reservedWords ≡ map toList
  ("break" ∷ "case" ∷ "catch" ∷ "class" ∷ "const" ∷ "continue" ∷ "debugger" ∷
   "default" ∷ "delete" ∷ "do" ∷ "else" ∷ "export" ∷ "extends" ∷ "false" ∷
   "finally" ∷ "for" ∷ "function" ∷ "if" ∷ "import" ∷ "in" ∷ "instanceof" ∷
   "new" ∷ "null" ∷ "return" ∷ "super" ∷ "switch" ∷ "this" ∷ "throw" ∷
   "true" ∷ "try" ∷ "typeof" ∷ "var" ∷ "void" ∷ "while" ∷ "with" ∷ "yield" ∷ [])
observedReservedWords = refl

private
  -- Each place is at least one sixteenth of the remaining bound.
  splitDigit : ℕ → ℕ → ℕ → ℕ × ℕ
  splitDigit zero place n = 0 , n
  splitDigit (suc limit) place n =
    if n <ᵇ place then (0 , n) else
    let smaller = splitDigit limit place (n ∸ place) in
    suc (proj₁ smaller) , proj₂ smaller

  hexDigit : Bool → ℕ → Char
  hexDigit upper n =
    fromℕ (if n <ᵇ 10 then 48 + n else (if upper then 55 else 87) + n)

  hexPlaces : Bool → List ℕ → ℕ → List Char
  hexPlaces upper [] n = hexDigit upper n ∷ []
  hexPlaces upper (place ∷ places) n =
    let digit = splitDigit 15 place n in
    hexDigit upper (proj₁ digit) ∷ hexPlaces upper places (proj₂ digit)

  shortEscape : Char → List Char
  shortEscape c = '\\' ∷ c ∷ []

  escapeSpecial : ℕ → List Char
  escapeSpecial 8 = shortEscape 'b'
  escapeSpecial 9 = shortEscape 't'
  escapeSpecial 10 = shortEscape 'n'
  escapeSpecial 12 = shortEscape 'f'
  escapeSpecial 13 = shortEscape 'r'
  escapeSpecial 34 = shortEscape '"'
  escapeSpecial 92 = shortEscape '\\'
  escapeSpecial n = '\\' ∷ 'u' ∷ hexPlaces true (4096 ∷ 256 ∷ 16 ∷ []) n

  quoteSpecial : ℕ → Bool
  quoteSpecial n = (n ≡ᵇ 34) ∨ (n ≡ᵇ 92) ∨ (n ≡ᵇ 8232) ∨ (n ≡ᵇ 8233)

  printable : ℕ → Bool
  printable n = (n <ᵇ 127) ∨ (159 <ᵇ n)

escapeChar : Char → List Char
escapeChar c =
  let n = toℕ c in
  if (31 <ᵇ n) ∧ (printable n ∧ not (quoteSpecial n)) then c ∷ [] else escapeSpecial n

escapeBody : List Char → List Char
escapeBody [] = []
escapeBody (c ∷ cs) = escapeChar c ++ escapeBody cs

quoteForward : String → String
quoteForward s = fromList ('"' ∷ (escapeBody (toList s) ++ ('"' ∷ [])))

escapeBodyEmpty : escapeBody [] ≡ []
escapeBodyEmpty = refl

escapeBodyNext : ∀ c cs → escapeBody (c ∷ cs) ≡ escapeChar c ++ escapeBody cs
escapeBodyNext c cs = refl

literalChar : ∀ c → (31 <ᵇ toℕ c) ≡ true →
  ((toℕ c <ᵇ 127) ∨ (159 <ᵇ toℕ c)) ≡ true →
  ((toℕ c ≡ᵇ 34) ∨ (toℕ c ≡ᵇ 92) ∨ (toℕ c ≡ᵇ 8232) ∨ (toℕ c ≡ᵇ 8233)) ≡ false →
  escapeChar c ≡ c ∷ []
literalChar c above outside plainChar =
  cong (λ literal → if literal then c ∷ [] else escapeSpecial (toℕ c))
    (trans (cong (λ b → b ∧ (printable (toℕ c) ∧ not (quoteSpecial (toℕ c)))) above)
      (trans (cong (λ b → b ∧ not (quoteSpecial (toℕ c))) outside) (cong not plainChar)))

quoteShape : ∀ s → quoteForward s ≡ fromList ('"' ∷ (escapeBody (toList s) ++ ('"' ∷ [])))
quoteShape s = refl

csi : String
csi = fromList (fromℕ 27 ∷ '[' ∷ [])

csiPrefix : csi ≡ fromList (fromℕ 27 ∷ '[' ∷ [])
csiPrefix = refl

paint : Bool → Shade → String → String
paint false hue s = s
paint true name s = csi ++ˢ "34;1m" ++ˢ s ++ˢ csi ++ˢ "0;22m"
paint true container s = csi ++ˢ "35m" ++ˢ s ++ˢ csi ++ˢ "0m"
paint true numeral s = csi ++ˢ "31m" ++ˢ s ++ˢ csi ++ˢ "0m"
paint true quoted s = csi ++ˢ "33m" ++ˢ s ++ˢ csi ++ˢ "0m"
paint true constant s = csi ++ˢ "36m" ++ˢ s ++ˢ csi ++ˢ "0m"

paintPlain : ∀ hue s → paint false hue s ≡ s
paintPlain hue s = refl

paintName : ∀ s → paint true name s ≡ csi ++ˢ "34;1m" ++ˢ s ++ˢ csi ++ˢ "0;22m"
paintName s = refl

paintContainer : ∀ s → paint true container s ≡ csi ++ˢ "35m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintContainer s = refl

paintNumeral : ∀ s → paint true numeral s ≡ csi ++ˢ "31m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintNumeral s = refl

paintQuoted : ∀ s → paint true quoted s ≡ csi ++ˢ "33m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintQuoted s = refl

paintConstant : ∀ s → paint true constant s ≡ csi ++ˢ "36m" ++ˢ s ++ˢ csi ++ˢ "0m"
paintConstant s = refl

renderPayload : Bool → B.Payload → String
renderPayload c (B.atom B.null) = paint c constant "null"
renderPayload c (B.atom (B.boolean true)) = paint c constant "true"
renderPayload c (B.atom (B.boolean false)) = paint c constant "false"
renderPayload c (B.atom (B.number n)) = paint c numeral n
renderPayload c (B.atom (B.text s)) = paint c quoted (quoteForward s)
renderPayload c B.arrayMark = paint c container "[]"
renderPayload c B.objectMark = paint c container "{}"

payloadNull : ∀ c → renderPayload c (B.atom B.null) ≡ paint c constant "null"
payloadNull c = refl

payloadTrue : ∀ c → renderPayload c (B.atom (B.boolean true)) ≡ paint c constant "true"
payloadTrue c = refl

payloadFalse : ∀ c → renderPayload c (B.atom (B.boolean false)) ≡ paint c constant "false"
payloadFalse c = refl

payloadNumber : ∀ c n → renderPayload c (B.atom (B.number n)) ≡ paint c numeral n
payloadNumber c n = refl

payloadText : ∀ c s → renderPayload c (B.atom (B.text s)) ≡ paint c quoted (quoteForward s)
payloadText c s = refl

payloadArray : ∀ c → renderPayload c B.arrayMark ≡ paint c container "[]"
payloadArray c = refl

payloadObject : ∀ c → renderPayload c B.objectMark ≡ paint c container "{}"
payloadObject c = refl

assignmentPart : Bool → B.Segment → String
assignmentPart c (B.property k) =
  if identifier (toList k) then "." ++ˢ paint c name k
  else paint c container "[" ++ˢ paint c quoted (quoteForward k) ++ˢ paint c container "]"
assignmentPart c (B.index i) =
  paint c container "[" ++ˢ paint c numeral (Nat.show i) ++ˢ paint c container "]"

assignmentSuffix : Bool → List B.Segment → String
assignmentSuffix c [] = ""
assignmentSuffix c (p ∷ ps) = assignmentPart c p ++ˢ assignmentSuffix c ps

assignmentDotted : ∀ c k → identifier (toList k) ≡ true →
  assignmentPart c (B.property k) ≡ "." ++ˢ paint c name k
assignmentDotted c k isIdent =
  cong (λ b → if b then "." ++ˢ paint c name k
              else paint c container "[" ++ˢ paint c quoted (quoteForward k) ++ˢ paint c container "]") isIdent

assignmentBracketed : ∀ c k → identifier (toList k) ≡ false →
  assignmentPart c (B.property k) ≡ paint c container "[" ++ˢ paint c quoted (quoteForward k) ++ˢ paint c container "]"
assignmentBracketed c k isBracket =
  cong (λ b → if b then "." ++ˢ paint c name k
              else paint c container "[" ++ˢ paint c quoted (quoteForward k) ++ˢ paint c container "]") isBracket

assignmentIndex : ∀ c i →
  assignmentPart c (B.index i) ≡ paint c container "[" ++ˢ paint c numeral (Nat.show i) ++ˢ paint c container "]"
assignmentIndex c i = refl

assignmentSuffixEmpty : ∀ c → assignmentSuffix c [] ≡ ""
assignmentSuffixEmpty c = refl

assignmentSuffixNext : ∀ c p ps → assignmentSuffix c (p ∷ ps) ≡ assignmentPart c p ++ˢ assignmentSuffix c ps
assignmentSuffixNext c p ps = refl

pairPart : Bool → B.Segment → String
pairPart c (B.property k) = paint c quoted (quoteForward k)
pairPart c (B.index i) = paint c numeral (Nat.show i)

private
  pairTail : Bool → B.Segment → List B.Segment → String
  pairTail c p [] = pairPart c p
  pairTail c p (q ∷ ps) = pairPart c p ++ˢ "," ++ˢ pairTail c q ps

pairParts : Bool → List B.Segment → String
pairParts c [] = ""
pairParts c (p ∷ ps) = pairTail c p ps

pairProperty : ∀ c k → pairPart c (B.property k) ≡ paint c quoted (quoteForward k)
pairProperty c k = refl

pairIndex : ∀ c i → pairPart c (B.index i) ≡ paint c numeral (Nat.show i)
pairIndex c i = refl

pairPartsEmpty : ∀ c → pairParts c [] ≡ ""
pairPartsEmpty c = refl

pairPartsSingle : ∀ c p → pairParts c (p ∷ []) ≡ pairPart c p
pairPartsSingle c p = refl

pairPartsNext : ∀ c p q ps → pairParts c (p ∷ q ∷ ps) ≡ pairPart c p ++ˢ "," ++ˢ pairParts c (q ∷ ps)
pairPartsNext c p q ps = refl

renderLine : Notation → Bool → B.Statement → String
renderLine assignments c (B.assignment ps r) =
  paint c name "json" ++ˢ assignmentSuffix c ps ++ˢ " = " ++ˢ renderPayload c r ++ˢ ";\n"
renderLine pairs c (B.assignment ps r) =
  paint c container "[" ++ˢ paint c container "[" ++ˢ pairParts c ps ++ˢ paint c container "]" ++ˢ
  "," ++ˢ renderPayload c r ++ˢ paint c container "]" ++ˢ "\n"

renderAssignment : ∀ c ps r → renderLine assignments c (B.assignment ps r) ≡
  paint c name "json" ++ˢ assignmentSuffix c ps ++ˢ " = " ++ˢ renderPayload c r ++ˢ ";\n"
renderAssignment c ps r = refl

renderPair : ∀ c ps r → renderLine pairs c (B.assignment ps r) ≡
  paint c container "[" ++ˢ paint c container "[" ++ˢ pairParts c ps ++ˢ paint c container "]" ++ˢ
  "," ++ˢ renderPayload c r ++ˢ paint c container "]" ++ˢ "\n"
renderPair c ps r = refl

arrangeSorted : B.Value → B.Value
arrangeValues : List B.Value → List B.Value
arrangeMembers : List (String × B.Value) → List (String × B.Value)
arrangeSorted (B.scalar a) = B.scalar a
arrangeSorted (B.array vs) = B.array (arrangeValues vs)
arrangeSorted (B.object kvs) = B.object (orderKeys (λ k → toList (assignmentPart false (B.property k))) (arrangeMembers kvs))
arrangeValues [] = []
arrangeValues (v ∷ vs) = arrangeSorted v ∷ arrangeValues vs
arrangeMembers [] = []
arrangeMembers ((k , v) ∷ kvs) = (k , arrangeSorted v) ∷ arrangeMembers kvs

arrange : SortMode → B.Value → B.Value
arrange given v = v
arrange sorted v = arrangeSorted v

private
  arrangeValuesLaw : ∀ vs → arrangeValues vs ≡ map (arrange sorted) vs
  arrangeValuesLaw [] = refl
  arrangeValuesLaw (v ∷ vs) = cong (λ rs → arrange sorted v ∷ rs) (arrangeValuesLaw vs)

  arrangeMembersLaw : ∀ kvs →
    arrangeMembers kvs ≡ map (λ kv → proj₁ kv , arrange sorted (proj₂ kv)) kvs
  arrangeMembersLaw [] = refl
  arrangeMembersLaw ((k , v) ∷ kvs) =
    cong (λ rs → (k , arrange sorted v) ∷ rs) (arrangeMembersLaw kvs)

givenOrder : ∀ v → arrange given v ≡ v
givenOrder v = refl

arrangedScalar : ∀ a → arrange sorted (B.scalar a) ≡ B.scalar a
arrangedScalar a = refl

arrangedArray : ∀ vs → arrange sorted (B.array vs) ≡ B.array (map (arrange sorted) vs)
arrangedArray vs = cong B.array (arrangeValuesLaw vs)

arrangedObject : ∀ kvs → arrange sorted (B.object kvs) ≡
  B.object (orderKeys (λ k → toList (assignmentPart false (B.property k)))
    (map (λ kv → proj₁ kv , arrange sorted (proj₂ kv)) kvs))
arrangedObject kvs = cong (λ rs → B.object (orderKeys (λ k → toList (assignmentPart false (B.property k))) rs)) (arrangeMembersLaw kvs)

draw : List B.Segment → Display → List Row
draw p (display n c v) = map (λ s → row s (renderLine n c s)) (B.flatten p v)

private
  rowStatements : ∀ n c ss → map Row.statement (map (λ s → row s (renderLine n c s)) ss) ≡ ss
  rowStatements n c [] = refl
  rowStatements n c (s ∷ ss) = cong (λ rest → s ∷ rest) (rowStatements n c ss)

drawLines : ∀ p n c v → draw p (display n c v) ≡
  map (λ s → row s (renderLine n c s)) (map Row.statement (draw p (display n c v)))
drawLines p n c v =
  cong (map (λ s → row s (renderLine n c s))) (sym (rowStatements n c (B.flatten p v)))

drawSquare : ∀ p d → map Row.statement (draw p d) ≡ B.flatten p (Display.tree d)
drawSquare p (display n c v) = rowStatements n c (B.flatten p v)

private
  drawString : List B.Segment → Display → String
  drawString p d = foldr _++ˢ_ "" (map Row.output (draw p d))

  drawStringShape : ∀ p d → drawString p d ≡ foldr _++ˢ_ "" (map Row.output (draw p d))
  drawStringShape p d = refl

renderTree : Config → List B.Segment → B.Value → String
renderTree cfg p v =
  drawString p (display (Config.notation cfg) (Config.color cfg) (arrange (Config.sorting cfg) v))

renderTreeLaw : ∀ cfg p v → renderTree cfg p v ≡
  foldr _++ˢ_ "" (map Row.output
    (draw p (display (Config.notation cfg) (Config.color cfg) (arrange (Config.sorting cfg) v))))
renderTreeLaw cfg p v =
  drawStringShape p (display (Config.notation cfg) (Config.color cfg) (arrange (Config.sorting cfg) v))

observedColor : renderLine pairs true (B.assignment [] (B.atom (B.boolean true))) ≡
  csi ++ˢ "35m[" ++ˢ csi ++ˢ "0m" ++ˢ csi ++ˢ "35m[" ++ˢ csi ++ˢ "0m" ++ˢ
  csi ++ˢ "35m]" ++ˢ csi ++ˢ "0m," ++ˢ csi ++ˢ "36mtrue" ++ˢ csi ++ˢ "0m" ++ˢ
  csi ++ˢ "35m]" ++ˢ csi ++ˢ "0m\n"
observedColor = refl

private
  Decode : Set → Set
  Decode A = String ⊎ Parsed A

  success : {A : Set} → A → List Char → Decode A
  success a xs = inj₂ (parsed a xs)

  mapParsed : {A C : Set} → (A → C) → Decode A → Decode C
  mapParsed f (inj₁ e) = inj₁ e
  mapParsed f (inj₂ (parsed a xs)) = success (f a) xs

  nextParsed : {A C : Set} → Decode A → (A → List Char → Decode C) → Decode C
  nextParsed (inj₁ e) next = inj₁ e
  nextParsed (inj₂ (parsed a xs)) next = next a xs

  truncated : {A : Set} → Decode A
  truncated = inj₁ "unexpected EOF"

  reverseOnto : List Char → List Char → List Char
  reverseOnto [] acc = acc
  reverseOnto (c ∷ cs) acc = reverseOnto cs (c ∷ acc)

  fromReversed : List Char → String
  fromReversed chars = fromList (reverseOnto chars [])

  firstByte : ℕ → ℕ
  firstByte n =
    if n <ᵇ 128 then n
    else if n <ᵇ 2048 then 192 + proj₁ (splitDigit 31 64 n)
    else if n <ᵇ 65536 then 224 + proj₁ (splitDigit 15 4096 n)
    else 240 + proj₁ (splitDigit 4 262144 n)

  diagnosticGlyph : ℕ → List Char
  diagnosticGlyph 7 = shortEscape 'a'
  diagnosticGlyph 8 = shortEscape 'b'
  diagnosticGlyph 9 = shortEscape 't'
  diagnosticGlyph 10 = shortEscape 'n'
  diagnosticGlyph 11 = shortEscape 'v'
  diagnosticGlyph 12 = shortEscape 'f'
  diagnosticGlyph 13 = shortEscape 'r'
  diagnosticGlyph 39 = shortEscape (fromℕ 39)
  diagnosticGlyph 92 = shortEscape '\\'
  diagnosticGlyph n =
    if (n <ᵇ 32) ∨ (n ≡ᵇ 127) then '\\' ∷ 'x' ∷ hexPlaces false (16 ∷ []) n else fromℕ n ∷ []

  diagnosticChar : Char → String
  diagnosticChar c = fromList (fromℕ 39 ∷ (diagnosticGlyph (firstByte (toℕ c)) ++ (fromℕ 39 ∷ [])))

  invalidAt : {A : Set} → Char → String → Decode A
  invalidAt c context = inj₁ ("invalid character " ++ˢ diagnosticChar c ++ˢ " " ++ˢ context)

  collectDigits : List Char → List Char → Parsed (List Char)
  collectDigits acc [] = parsed acc []
  collectDigits acc (c ∷ xs) =
    if digitCode (toℕ c) then collectDigits (c ∷ acc) xs else parsed acc (c ∷ xs)

  needDigits : String → List Char → List Char → Decode (List Char)
  needDigits context acc [] = truncated
  needDigits context acc (c ∷ xs) =
    if digitCode (toℕ c) then inj₂ (collectDigits (c ∷ acc) xs) else invalidAt c context

  finishExponent : List Char → List Char → Decode String
  finishExponent acc xs = mapParsed fromReversed (needDigits "in exponent of numeric literal" acc xs)

  exponentSign : List Char → List Char → Decode String
  exponentSign acc ('+' ∷ xs) = finishExponent ('+' ∷ acc) xs
  exponentSign acc ('-' ∷ xs) = finishExponent ('-' ∷ acc) xs
  exponentSign acc xs = finishExponent acc xs

  numberExponent : List Char → List Char → Decode String
  numberExponent acc ('e' ∷ xs) = exponentSign ('e' ∷ acc) xs
  numberExponent acc ('E' ∷ xs) = exponentSign ('E' ∷ acc) xs
  numberExponent acc xs = success (fromReversed acc) xs

  numberFraction : List Char → List Char → Decode String
  numberFraction acc ('.' ∷ xs) =
    nextParsed (needDigits "after decimal point in numeric literal" ('.' ∷ acc) xs) numberExponent
  numberFraction acc xs = numberExponent acc xs

  numberUnsigned : List Char → List Char → Decode String
  numberUnsigned acc ('0' ∷ xs) = numberFraction ('0' ∷ acc) xs
  numberUnsigned acc xs = nextParsed (needDigits "in numeric literal" acc xs) numberFraction

decodeNumber : List Char → String ⊎ Parsed String
decodeNumber [] = inj₁ "EOF"
decodeNumber ('-' ∷ xs) = numberUnsigned ('-' ∷ []) xs
decodeNumber (c ∷ xs) = numberUnsigned [] (c ∷ xs)

private
  hexValue : ℕ → ℕ
  hexValue n =
    if digitCode n then n ∸ 48
    else if (64 <ᵇ n) ∧ (n <ᵇ 71) then n ∸ 55
    else if (96 <ᵇ n) ∧ (n <ᵇ 103) then n ∸ 87
    else 16

  highUnit : ℕ → Bool
  highUnit n = (55295 <ᵇ n) ∧ (n <ᵇ 56320)

  lowUnit : ℕ → Bool
  lowUnit n = (56319 <ᵇ n) ∧ (n <ᵇ 57344)

  flushUnit : Maybe ℕ → List Char → List Char
  flushUnit nothing acc = acc
  flushUnit (just high) acc = fromℕ 65533 ∷ acc

  singleUnit : ℕ → List Char → Maybe ℕ × List Char
  singleUnit n acc =
    if highUnit n then (just n , acc)
    else (nothing , fromℕ (if lowUnit n then 65533 else n) ∷ acc)

  addUnit : ℕ → Maybe ℕ → List Char → Maybe ℕ × List Char
  addUnit n nothing acc = singleUnit n acc
  addUnit n (just high) acc =
    if lowUnit n then (nothing , fromℕ (65536 + (high ∸ 55296) * 1024 + (n ∸ 56320)) ∷ acc)
    else singleUnit n (fromℕ 65533 ∷ acc)

  simpleEscape : Char → Maybe Char
  simpleEscape '"' = just '"'
  simpleEscape '\\' = just '\\'
  simpleEscape '/' = just '/'
  simpleEscape 'b' = just (fromℕ 8)
  simpleEscape 'f' = just (fromℕ 12)
  simpleEscape 'n' = just '\n'
  simpleEscape 'r' = just '\r'
  simpleEscape 't' = just '\t'
  simpleEscape c = nothing

  acceptEscape : Maybe Char → (Char → Decode String) → Char → Decode String
  acceptEscape nothing continue c = invalidAt c "in string escape code"
  acceptEscape (just c) continue original = continue c

  data QuoteMode : Set where
    quoteText quoteEscape : QuoteMode
    quoteHex : ℕ → ℕ → QuoteMode

  scanQuote : List Char → QuoteMode → Maybe ℕ → List Char → Decode String
  scanQuote [] mode high acc = truncated
  scanQuote (c ∷ xs) quoteText high acc =
    let n = toℕ c in
    if n ≡ᵇ 34 then success (fromReversed (flushUnit high acc)) xs
    else if n ≡ᵇ 92 then scanQuote xs quoteEscape high acc
    else if n <ᵇ 32 then invalidAt c "in string literal"
    else scanQuote xs quoteText nothing (c ∷ flushUnit high acc)
  scanQuote ('u' ∷ xs) quoteEscape high acc = scanQuote xs (quoteHex 3 0) high acc
  scanQuote (c ∷ xs) quoteEscape high acc =
    acceptEscape (simpleEscape c) (λ decoded → scanQuote xs quoteText nothing (decoded ∷ flushUnit high acc)) c
  scanQuote (c ∷ xs) (quoteHex zero n) high acc =
    let digit = hexValue (toℕ c)
        step = addUnit (n * 16 + digit) high acc in
    if digit <ᵇ 16 then scanQuote xs quoteText (proj₁ step) (proj₂ step)
    else invalidAt c "in \\u hexadecimal character escape"
  scanQuote (c ∷ xs) (quoteHex (suc left) n) high acc =
    let digit = hexValue (toℕ c) in
    if digit <ᵇ 16 then scanQuote xs (quoteHex left (n * 16 + digit)) high acc
    else invalidAt c "in \\u hexadecimal character escape"

decodeQuoted : List Char → String ⊎ Parsed String
decodeQuoted xs = scanQuote xs quoteText nothing []

private
  skipSpace : List Char → List Char
  skipSpace (' ' ∷ xs) = skipSpace xs
  skipSpace ('\t' ∷ xs) = skipSpace xs
  skipSpace ('\r' ∷ xs) = skipSpace xs
  skipSpace ('\n' ∷ xs) = skipSpace xs
  skipSpace xs = xs

  numberStart : Char → Bool
  numberStart c = (toℕ c ≡ᵇ 45) ∨ digitCode (toℕ c)

  readLiteral : List Char → String → B.Atom → List Char → Decode B.Value
  readLiteral [] kind val xs = success (B.scalar val) xs
  readLiteral (want ∷ wants) kind val [] = truncated
  readLiteral (want ∷ wants) kind val (c ∷ xs) =
    if toℕ c ≡ᵇ toℕ want then readLiteral wants kind val xs
    else invalidAt c ("in literal " ++ˢ kind ++ˢ " (expecting " ++ˢ diagnosticChar want ++ˢ ")")

  chooseValue : Bool → (List Char → Decode (List B.Value)) →
    (List Char → Decode (List (String × B.Value))) → Decode B.Value → Char → List Char → Decode B.Value
  chooseValue true readArray readObject whitespace c xs =
    mapParsed (λ s → B.scalar (B.number s)) (decodeNumber (c ∷ xs))
  chooseValue false readArray readObject whitespace ' ' xs = whitespace
  chooseValue false readArray readObject whitespace '\t' xs = whitespace
  chooseValue false readArray readObject whitespace '\r' xs = whitespace
  chooseValue false readArray readObject whitespace '\n' xs = whitespace
  chooseValue false readArray readObject whitespace 't' xs = readLiteral ('r' ∷ 'u' ∷ 'e' ∷ []) "true" (B.boolean true) xs
  chooseValue false readArray readObject whitespace 'f' xs = readLiteral ('a' ∷ 'l' ∷ 's' ∷ 'e' ∷ []) "false" (B.boolean false) xs
  chooseValue false readArray readObject whitespace 'n' xs = readLiteral ('u' ∷ 'l' ∷ 'l' ∷ []) "null" B.null xs
  chooseValue false readArray readObject whitespace '"' xs = mapParsed (λ s → B.scalar (B.text s)) (decodeQuoted xs)
  chooseValue false readArray readObject whitespace '[' xs = mapParsed B.array (readArray xs)
  chooseValue false readArray readObject whitespace '{' xs = mapParsed (λ kvs → B.object (keepLatest kvs)) (readObject xs)
  chooseValue false readArray readObject whitespace c xs = invalidAt c "looking for beginning of value"

  arrayRest : B.Value → (List Char → Decode (List B.Value)) → List Char → Decode (List B.Value)
  arrayRest v more [] = truncated
  arrayRest v more (']' ∷ xs) = success (v ∷ []) xs
  arrayRest v more (',' ∷ xs) = mapParsed (λ vs → v ∷ vs) (more (skipSpace xs))
  arrayRest v more (c ∷ xs) = invalidAt c "after array element"

  objectRest : String × B.Value → (List Char → Decode (List (String × B.Value))) →
    List Char → Decode (List (String × B.Value))
  objectRest kv more [] = truncated
  objectRest kv more ('}' ∷ xs) = success (kv ∷ []) xs
  objectRest kv more (',' ∷ xs) = mapParsed (λ kvs → kv ∷ kvs) (more (skipSpace xs))
  objectRest kv more (c ∷ xs) = invalidAt c "after object key:value pair"

  memberValue : String → (List Char → Decode B.Value) → (List Char → Decode (List (String × B.Value))) →
    List Char → Decode (List (String × B.Value))
  memberValue k readValue more [] = truncated
  memberValue k readValue more (':' ∷ xs) =
    nextParsed (readValue (skipSpace xs)) (λ v rest → objectRest (k , v) more (skipSpace rest))
  memberValue k readValue more (c ∷ xs) = invalidAt c "after object key"

  -- A recursive path consumes a character within two container or value steps.
  parseBudget : List Char → ℕ
  parseBudget xs = suc (2 * length xs)

  data Readers : Set where
    readers : (List Char → Decode B.Value) →
      (Bool → List Char → Decode (List B.Value)) →
      (Bool → List Char → Decode (List (String × B.Value))) → Readers

  treeInput : Readers → List Char → Decode B.Value
  treeInput (readers tree elements members) = tree

  elementsInput : Readers → Bool → List Char → Decode (List B.Value)
  elementsInput (readers tree elements members) = elements

  membersInput : Readers → Bool → List Char → Decode (List (String × B.Value))
  membersInput (readers tree elements members) = members

  extendTree : Readers → List Char → Decode B.Value
  extendTree prior [] = truncated
  extendTree prior (c ∷ xs) =
    chooseValue (numberStart c)
      (λ ys → elementsInput prior true (skipSpace ys)) (λ ys → membersInput prior true (skipSpace ys))
      (treeInput prior xs) c xs

  extendElements : Readers → Bool → List Char → Decode (List B.Value)
  extendElements prior firstElement [] = truncated
  extendElements prior true (']' ∷ xs) = success [] xs
  extendElements prior firstElement xs =
    nextParsed (treeInput prior xs)
      (λ v rest → arrayRest v (elementsInput prior false) (skipSpace rest))

  extendMembers : Readers → Bool → List Char → Decode (List (String × B.Value))
  extendMembers prior firstMember [] = truncated
  extendMembers prior true ('}' ∷ xs) = success [] xs
  extendMembers prior firstMember ('"' ∷ xs) =
    nextParsed (decodeQuoted xs)
      (λ k rest → memberValue k (treeInput prior) (membersInput prior false) (skipSpace rest))
  extendMembers prior firstMember (c ∷ xs) = invalidAt c "looking for beginning of object key string"

  readLayers : ℕ → Readers
  readLayers zero = readers (λ xs → truncated) (λ firstElement xs → truncated) (λ firstMember xs → truncated)
  readLayers (suc fuel) =
    let prior = readLayers fuel in readers (extendTree prior) (extendElements prior) (extendMembers prior)

decodeElements : List Char → String ⊎ Parsed (List B.Value)
decodeElements xs = elementsInput (readLayers (parseBudget xs)) true (skipSpace xs)

decodeMembers : List Char → String ⊎ Parsed (List (String × B.Value))
decodeMembers xs = membersInput (readLayers (parseBudget xs)) true (skipSpace xs)

decodePrefix : List Char → String ⊎ Parsed B.Value
decodePrefix [] = inj₁ "EOF"
decodePrefix (c ∷ xs) =
  chooseValue ((toℕ c ≡ᵇ 45) ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58)))
    decodeElements decodeMembers (decodePrefix xs) c xs

endOfInput : decodePrefix [] ≡ inj₁ "EOF"
endOfInput = refl

leadingSpace : ∀ xs → decodePrefix (' ' ∷ xs) ≡ decodePrefix xs
leadingSpace xs = refl

leadingTab : ∀ xs → decodePrefix ('\t' ∷ xs) ≡ decodePrefix xs
leadingTab xs = refl

leadingCR : ∀ xs → decodePrefix ('\r' ∷ xs) ≡ decodePrefix xs
leadingCR xs = refl

leadingLF : ∀ xs → decodePrefix ('\n' ∷ xs) ≡ decodePrefix xs
leadingLF xs = refl

truePrefix : ∀ xs → decodePrefix ('t' ∷ 'r' ∷ 'u' ∷ 'e' ∷ xs) ≡ inj₂ (parsed (B.scalar (B.boolean true)) xs)
truePrefix xs = refl

falsePrefix : ∀ xs → decodePrefix ('f' ∷ 'a' ∷ 'l' ∷ 's' ∷ 'e' ∷ xs) ≡ inj₂ (parsed (B.scalar (B.boolean false)) xs)
falsePrefix xs = refl

nullPrefix : ∀ xs → decodePrefix ('n' ∷ 'u' ∷ 'l' ∷ 'l' ∷ xs) ≡ inj₂ (parsed (B.scalar B.null) xs)
nullPrefix xs = refl

closeQuote : ∀ xs → decodeQuoted ('"' ∷ xs) ≡ inj₂ (parsed "" xs)
closeQuote xs = refl

closeArray : ∀ xs → decodeElements (']' ∷ xs) ≡ inj₂ (parsed [] xs)
closeArray xs = refl

closeObject : ∀ xs → decodeMembers ('}' ∷ xs) ≡ inj₂ (parsed [] xs)
closeObject xs = refl

quotedPrefix : ∀ xs s rest → decodeQuoted xs ≡ inj₂ (parsed s rest) →
  decodePrefix ('"' ∷ xs) ≡ inj₂ (parsed (B.scalar (B.text s)) rest)
quotedPrefix xs s rest h = cong (mapParsed (λ text → B.scalar (B.text text))) h

quotedError : ∀ xs e → decodeQuoted xs ≡ inj₁ e → decodePrefix ('"' ∷ xs) ≡ inj₁ e
quotedError xs e h = cong (mapParsed (λ text → B.scalar (B.text text))) h

numericPrefix : ∀ c xs s rest →
  ((toℕ c ≡ᵇ 45) ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58))) ≡ true →
  decodeNumber (c ∷ xs) ≡ inj₂ (parsed s rest) →
  decodePrefix (c ∷ xs) ≡ inj₂ (parsed (B.scalar (B.number s)) rest)
numericPrefix c xs s rest start h =
  trans (cong (λ b → chooseValue b decodeElements decodeMembers (decodePrefix xs) c xs) start)
    (cong (mapParsed (λ n → B.scalar (B.number n))) h)

numericError : ∀ c xs e →
  ((toℕ c ≡ᵇ 45) ∨ ((47 <ᵇ toℕ c) ∧ (toℕ c <ᵇ 58))) ≡ true →
  decodeNumber (c ∷ xs) ≡ inj₁ e → decodePrefix (c ∷ xs) ≡ inj₁ e
numericError c xs e start h =
  trans (cong (λ b → chooseValue b decodeElements decodeMembers (decodePrefix xs) c xs) start)
    (cong (mapParsed (λ n → B.scalar (B.number n))) h)

arrayPrefix : ∀ xs vs rest → decodeElements xs ≡ inj₂ (parsed vs rest) →
  decodePrefix ('[' ∷ xs) ≡ inj₂ (parsed (B.array vs) rest)
arrayPrefix xs vs rest h = cong (mapParsed B.array) h

arrayError : ∀ xs e → decodeElements xs ≡ inj₁ e → decodePrefix ('[' ∷ xs) ≡ inj₁ e
arrayError xs e h = cong (mapParsed B.array) h

objectPrefix : ∀ xs kvs rest → decodeMembers xs ≡ inj₂ (parsed kvs rest) →
  decodePrefix ('{' ∷ xs) ≡ inj₂ (parsed (B.object (keepLatest kvs)) rest)
objectPrefix xs kvs rest h = cong (mapParsed (λ fields → B.object (keepLatest fields))) h

objectError : ∀ xs e → decodeMembers xs ≡ inj₁ e → decodePrefix ('{' ∷ xs) ≡ inj₁ e
objectError xs e h = cong (mapParsed (λ fields → B.object (keepLatest fields))) h

private
  forwardResult : Config → Decode B.Value → Report
  forwardResult cfg (inj₁ e) = report "" (just e)
  forwardResult cfg (inj₂ (parsed v rest)) = report (renderTree cfg [] v) nothing

  prependOutput : String → Report → Report
  prependOutput prefix (report out issue) = report (prefix ++ˢ out) issue

  prependResult : ∀ prefix r out issue → r ≡ report out issue →
    prependOutput prefix r ≡ report (prefix ++ˢ out) issue
  prependResult prefix r out issue h =
    cong (prependOutput prefix) {x = r} {y = report out issue} h

  streamHead : Config → ℕ → Report → Decode B.Value → Report
  streamHead cfg i tail (inj₁ e) = report "" (just e)
  streamHead cfg i tail (inj₂ (parsed v rest)) = prependOutput (renderTree cfg (B.index i ∷ []) v) tail

forward : Config → List Char → Report
forward cfg xs = forwardResult cfg (decodePrefix xs)

streamFrom : Config → ℕ → List (List Char) → Report
streamFrom cfg i [] = report "" nothing
streamFrom cfg i (xs ∷ xss) = streamHead cfg i (streamFrom cfg (suc i) xss) (decodePrefix xs)

forwardStream : Config → List (List Char) → Report
forwardStream cfg xss =
  prependOutput (renderLine (Config.notation cfg) (Config.color cfg) (B.assignment [] B.arrayMark)) (streamFrom cfg 0 xss)

forwardGood : ∀ cfg xs v rest → decodePrefix xs ≡ inj₂ (parsed v rest) →
  forward cfg xs ≡ report (renderTree cfg [] v) nothing
forwardGood cfg xs v rest h = cong (forwardResult cfg) h

forwardBad : ∀ cfg xs e → decodePrefix xs ≡ inj₁ e → forward cfg xs ≡ report "" (just e)
forwardBad cfg xs e h = cong (forwardResult cfg) h

streamDone : ∀ cfg i → streamFrom cfg i [] ≡ report "" nothing
streamDone cfg i = refl

streamBad : ∀ cfg i xs xss e → decodePrefix xs ≡ inj₁ e →
  streamFrom cfg i (xs ∷ xss) ≡ report "" (just e)
streamBad cfg i xs xss e h = cong (streamHead cfg i (streamFrom cfg (suc i) xss)) h

streamNext : ∀ cfg i xs xss v rest out issue → decodePrefix xs ≡ inj₂ (parsed v rest) →
  streamFrom cfg (suc i) xss ≡ report out issue →
  streamFrom cfg i (xs ∷ xss) ≡ report (renderTree cfg (B.index i ∷ []) v ++ˢ out) issue
streamNext cfg i xs xss v rest out issue h laterResult =
  trans (cong (streamHead cfg i (streamFrom cfg (suc i) xss)) h)
    (prependResult (renderTree cfg (B.index i ∷ []) v) (streamFrom cfg (suc i) xss) out issue laterResult)

streamRoot : ∀ cfg xss out issue → streamFrom cfg 0 xss ≡ report out issue →
  forwardStream cfg xss ≡
  report (renderLine (Config.notation cfg) (Config.color cfg) (B.assignment [] B.arrayMark) ++ˢ out) issue
streamRoot cfg xss out issue h =
  prependResult (renderLine (Config.notation cfg) (Config.color cfg) (B.assignment [] B.arrayMark))
    (streamFrom cfg 0 xss) out issue h

private
  renderAt : ∀ cfg p v w out → arrange (Config.sorting cfg) v ≡ w →
    drawString p (display (Config.notation cfg) (Config.color cfg) w) ≡ out →
    renderTree cfg p v ≡ out
  renderAt cfg p v w out ordered seen =
    trans (cong (λ tree → drawString p (display (Config.notation cfg) (Config.color cfg) tree)) {y = w} ordered) seen

  forwardShows : ∀ cfg xs v rest out → decodePrefix xs ≡ inj₂ (parsed v rest) →
    renderTree cfg [] v ≡ out → forward cfg xs ≡ report out nothing
  forwardShows cfg xs v rest out decoded drawn =
    trans (forwardGood cfg xs v rest decoded) (cong (λ s → report s nothing) drawn)

  streamShowsNext : ∀ cfg i xs xss v rest out piece issue →
    decodePrefix xs ≡ inj₂ (parsed v rest) → renderTree cfg (B.index i ∷ []) v ≡ piece →
    streamFrom cfg (suc i) xss ≡ report out issue →
    streamFrom cfg i (xs ∷ xss) ≡ report (piece ++ˢ out) issue
  streamShowsNext cfg i xs xss v rest out piece issue decoded drawn continued =
    trans (streamNext cfg i xs xss v rest out issue decoded continued)
      (cong (λ s → report (s ++ˢ out) issue) {y = piece} drawn)

  streamShowsRoot : ∀ cfg xss out issue opening →
    renderLine (Config.notation cfg) (Config.color cfg) (B.assignment [] B.arrayMark) ≡ opening →
    streamFrom cfg 0 xss ≡ report out issue → forwardStream cfg xss ≡ report (opening ++ˢ out) issue
  streamShowsRoot cfg xss out issue opening firstLine continued =
    trans (streamRoot cfg xss out issue continued) (cong (λ s → report (s ++ˢ out) issue) {y = opening} firstLine)

  orderStep : ∀ rank kv tail ready result → orderKeys rank tail ≡ ready →
    insertKey rank kv ready ≡ result → orderKeys rank (kv ∷ tail) ≡ result
  orderStep rank kv tail ready result rest inserted =
    trans (orderKeysNext rank kv tail) (trans (cong (insertKey rank kv) {y = ready} rest) inserted)

  singleKeyOrder : ∀ rank key v → orderKeys rank ((key , v) ∷ []) ≡ (key , v) ∷ []
  singleKeyOrder rank key v =
    orderStep rank (key , v) [] [] ((key , v) ∷ [])
      (orderKeysEmpty rank) (insertEmpty rank (key , v))

  insertPast : ∀ rank k v j w tail result → compareText (rank k) (rank j) ≡ after →
    insertKey rank (k , v) tail ≡ result →
    insertKey rank (k , v) ((j , w) ∷ tail) ≡ (j , w) ∷ result
  insertPast rank k v j w tail result ord next =
    trans (insertAfter rank k v j w tail ord) (cong (λ ls → (j , w) ∷ ls) next)

  arrangeSingleScalar : ∀ key a →
    arrange sorted (B.object ((key , B.scalar a) ∷ [])) ≡ B.object ((key , B.scalar a) ∷ [])
  arrangeSingleScalar key a = cong B.object (singleKeyOrder (λ key → toList (assignmentPart false (B.property key))) key (B.scalar a))

  arrangeObjectVia : (source prepared ordered : List (String × B.Value)) →
    arrangeMembers source ≡ prepared → orderKeys (λ key → toList (assignmentPart false (B.property key))) prepared ≡ ordered →
    arrange sorted (B.object source) ≡ B.object ordered
  arrangeObjectVia source prepared ordered children keys =
    trans (cong (λ fields → B.object (orderKeys (λ key → toList (assignmentPart false (B.property key))) fields)) {y = prepared} children)
      (cong B.object keys)

  arrangeEmptyObject : arrange sorted (B.object []) ≡ B.object []
  arrangeEmptyObject = cong B.object (orderKeysEmpty (λ key → toList (assignmentPart false (B.property key))))


  rowOutputs : ∀ n c ss →
    map Row.output (map (λ s → row s (renderLine n c s)) ss) ≡ map (renderLine n c) ss
  rowOutputs n c [] = refl
  rowOutputs n c (s ∷ ss) = cong (λ out → renderLine n c s ∷ out) (rowOutputs n c ss)

  drawStatementLaw : ∀ p n c v → drawString p (display n c v) ≡
    foldr _++ˢ_ "" (map (renderLine n c) (B.flatten p v))
  drawStatementLaw p n c v = cong (foldr _++ˢ_ "") (rowOutputs n c (B.flatten p v))

  drawFromStatements : ∀ p n c v ss out → B.flatten p v ≡ ss →
    foldr _++ˢ_ "" (map (renderLine n c) ss) ≡ out → drawString p (display n c v) ≡ out
  drawFromStatements p n c v ss out flattened drawn =
    trans (drawStatementLaw p n c v)
      (trans (cong (λ ls → foldr _++ˢ_ "" (map (renderLine n c) ls)) {y = ss} flattened) drawn)

  appendRows : (xs ys heads tails : List B.Statement) →
    xs ≡ heads → ys ≡ tails → xs ++ ys ≡ heads ++ tails
  appendRows xs ys heads tails headEq tailEq =
    trans (cong (λ ls → ls ++ ys) {y = heads} headEq) (cong (λ ls → heads ++ ls) {y = tails} tailEq)

  flattenObjectShape : ∀ p fields body → B.flattenKeys p fields ≡ body →
    B.flatten p (B.object fields) ≡ B.assignment p B.objectMark ∷ body
  flattenObjectShape p fields body result =
    trans (B.flattenObject p fields) (cong (λ ls → B.assignment p B.objectMark ∷ ls) result)

  flattenArrayShape : ∀ p values body → B.flattenFrom p 0 values ≡ body →
    B.flatten p (B.array values) ≡ B.assignment p B.arrayMark ∷ body
  flattenArrayShape p values body result =
    trans (B.flattenArray p values) (cong (λ ls → B.assignment p B.arrayMark ∷ ls) result)

  flattenMember : ∀ p k v fields heads tails →
    B.flatten (p ++ (B.property k ∷ [])) v ≡ heads → B.flattenKeys p fields ≡ tails →
    B.flattenKeys p ((k , v) ∷ fields) ≡ heads ++ tails
  flattenMember p k v fields heads tails headEq tailEq =
    trans (B.flattenKeysNext p k v fields)
      (appendRows (B.flatten (p ++ (B.property k ∷ [])) v) (B.flattenKeys p fields) heads tails headEq tailEq)

  flattenElement : ∀ p i v values heads tails →
    B.flatten (p ++ (B.index i ∷ [])) v ≡ heads → B.flattenFrom p (suc i) values ≡ tails →
    B.flattenFrom p i (v ∷ values) ≡ heads ++ tails
  flattenElement p i v values heads tails headEq tailEq =
    trans (B.flattenFromNext p i v values)
      (appendRows (B.flatten (p ++ (B.index i ∷ [])) v) (B.flattenFrom p (suc i) values) heads tails headEq tailEq)

