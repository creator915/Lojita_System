import LojitaCtx.World
import LojitaCtx.CharClass
import LojitaCtx.Blueprint
import Gen.T0.Gron
namespace Gen.T1.Gron
open LojitaCtx.Terminal

/- The input port projects a resolved invocation to the T0 exit class.
   The output port retains the exit status and the presence of each byte stream.
   The open-input observation is taken after source selection and before EOF.
   Calibration seeds are 3407 and 451 for documents, 811 for streams,
   17609 for assignments, 171203 for binary64 rows, and 21702 for flags. -/
inductive J where
  | null
  | bool (b : Bool)
  | num (lexeme : String)
  | str (value : String)
  | arr (items : List J)
  | obj (entries : List (String × J))
deriving Inhabited
def hexDigit (upper : Bool) (n : Nat) : Char :=
  Char.ofNat (if n < 10 then n + 48 else if upper then n + 55 else n + 87)
def hexEscape (upper : Bool) (n : Nat) : String :=
  String.ofList ['\\', 'u', hexDigit upper (n / 4096 % 16), hexDigit upper (n / 256 % 16),
    hexDigit upper (n / 16 % 16), hexDigit upper (n % 16)]
def quoteChar (c : Char) (js : Bool) : String :=
  match c with
  | '"' => "\\\""
  | '\\' => "\\\\"
  | '\x08' => "\\b"
  | '\x0c' => "\\f"
  | '\t' => "\\t"
  | '\n' => "\\n"
  | '\r' => "\\r"
  | _ =>
    let n := c.toNat
    if n < 32 || (js && (127 ≤ n && n < 160)) || n == 8232 || n == 8233 then hexEscape js n
    else String.singleton c
def quote (s : String) (js : Bool := true) : String :=
  "\"" ++ String.join (s.toList.map (quoteChar · js)) ++ "\""
def byteQuoted (b : UInt8) : String :=
  let n := b.toNat
  let c := Char.ofNat n
  let rendered :=
    match n with
    | 7 => "\\a"
    | 11 => "\\v"
    | 39 => "\\'"
    | 34 => "\""
    | _ =>
      if (n < 32 && ![8, 9, 10, 12, 13].contains n) || n == 127 then
        String.ofList ['\\', 'x', hexDigit false (n / 16), hexDigit false (n % 16)]
      else if (128 ≤ n && n ≤ 160) || n == 173 then hexEscape false n
      else quoteChar c false
  "'" ++ rendered ++ "'"
inductive JsonErr where
  | incomplete (empty : Bool)
  | invalid (byte : UInt8) (context : String)
  | tooDeep (opener : UInt8)
deriving Inhabited
def message (strict : Bool) : JsonErr → String
  | .incomplete empty =>
    if strict then "unexpected end of JSON input" else if empty then "EOF" else "unexpected EOF"
  | .invalid b context => "invalid character " ++ byteQuoted b ++ " " ++ context
  | .tooDeep b => "invalid character " ++ byteQuoted b ++ " exceeded max depth"
def jsonSpace (b : UInt8) : Bool := b == 32 || b == 9 || b == 13 || b == 10
def digit (b : UInt8) : Bool := 48 ≤ b && b ≤ 57
def hexVal (b : UInt8) : Option Nat :=
  if digit b then some (b.toNat - 48)
  else if 97 ≤ b && b ≤ 102 then some (b.toNat - 87)
  else if 65 ≤ b && b ≤ 70 then some (b.toNat - 55)
  else none
def requireHex : Nat → Nat → Bytes → Except JsonErr (Nat × Bytes)
  | 0, a, bs => .ok (a, bs)
  | n+1, a, b::bs =>
    match hexVal b with
    | some v => requireHex n (a*16+v) bs
    | none => .error (.invalid b "in \\u hexadecimal character escape")
  | _+1, _, [] => .error (.incomplete false)
termination_by structural n _ _ => n
def utf16Escape (n : Nat) (bs : Bytes) : Nat × Bytes :=
  if 0xd800 ≤ n && n < 0xdc00 then
    match bs with
    | 92 :: 117 :: tail =>
      match requireHex 4 0 tail with
      | .ok (m, rest) =>
        if 0xdc00 ≤ m && m < 0xe000 then (0x10000 + (n-0xd800)*1024 + (m-0xdc00), rest)
        else (0xfffd, bs)
      | .error _ => (0xfffd, bs)
    | _ => (0xfffd, bs)
  else if 0xdc00 ≤ n && n < 0xe000 then (0xfffd, bs)
  else (n, bs)
def readString : Nat → Bytes → Bytes → Except JsonErr (String × Bytes)
  | 0, _, _ | _, [], _ => .error (.incomplete false)
  | n+1, b::bs, rev =>
    if b == 34 then .ok (LojitaCtx.World.decodeUtf8Lossy rev.reverse, bs)
    else if b == 92 then
      match bs with
      | [] => .error (.incomplete false)
      | e :: tail =>
        if e == 117 then do
          let (cp, rest) ← requireHex 4 0 tail
          let (scalar, rest) := utf16Escape cp rest
          readString n rest ((bytes (String.singleton (Char.ofNat scalar))).reverse ++ rev)
        else
          let single : Option UInt8 :=
            match e with
            | 34 | 47 | 92 => some e
            | 98 => some 8
            | 102 => some 12
            | 110 => some 10
            | 114 => some 13
            | 116 => some 9
            | _ => none
          match single with
          | some x => readString n tail (x :: rev)
          | none => .error (.invalid e "in string escape code")
    else if b < 32 then .error (.invalid b "in string literal")
    else readString n bs (b :: rev)
termination_by structural n _ _ => n
def stripLiteral (name : String) : Bytes → Bytes → Except JsonErr Bytes
  | [], bs => .ok bs
  | _, [] => .error (.incomplete false)
  | x::xs, b::bs =>
    if x == b then stripLiteral name xs bs
    else .error (.invalid b ("in literal " ++ name ++ " (expecting " ++ byteQuoted x ++ ")"))
termination_by structural xs _ => xs
def takeDigits (bs : Bytes) : Bytes × Bytes :=
  (bs.takeWhile digit, bs.dropWhile digit)
def requireDigits (ctx : String) (bs : Bytes) : Except JsonErr (Bytes × Bytes) :=
  match bs with
  | [] => .error (.incomplete false)
  | b :: _ => if digit b then .ok (takeDigits bs) else .error (.invalid b ctx)
def fraction (bs : Bytes) : Except JsonErr (Bytes × Bytes) :=
  match bs with
  | 46 :: tail => do
    let (s, rest) ← requireDigits "after decimal point in numeric literal" tail
    return (46 :: s, rest)
  | _ => .ok ([], bs)
def exponent (bs : Bytes) : Except JsonErr (Bytes × Bytes) :=
  match bs with
  | 69 :: tail | 101 :: tail => do
    let (sgn, tail) : Bytes × Bytes := match tail with
      | 43 :: rest => ([43], rest)
      | 45 :: rest => ([45], rest)
      | _ => ([], tail)
    let (s, rest) ← requireDigits "in exponent of numeric literal" tail
    return (bs.take 1 ++ sgn ++ s, rest)
  | _ => .ok ([], bs)
def readNumber (bs : Bytes) : Except JsonErr (String × Bytes) := do
  let (sgn, tail) : Bytes × Bytes := match bs with
    | 45 :: rest => ([45], rest)
    | _ => ([], bs)
  let (digits, tail) ← match tail with
    | 48 :: rest => pure ([48], rest)
    | _ => requireDigits "in numeric literal" tail
  let (dec, tail) ← fraction tail
  let (exp, rest) ← exponent tail
  return (String.fromUTF8! (sgn ++ digits ++ dec ++ exp).toByteArray, rest)
def setKey (xs : List (String × J)) (k : String) (v : J) :=
  match xs with
  | [] => [(k,v)]
  | (a,b) :: tail => if a == k then (k,v) :: tail else (a,b) :: setKey tail k v
termination_by structural xs
mutual
  def jsonValue : Nat → Nat → Bytes → Except JsonErr (J × Bytes)
    | 0, _, _ => .error (.incomplete false)
    | f+1, depth, bs =>
      match bs.dropWhile jsonSpace with
      | [] => .error (.incomplete false)
      | 34 :: tail => do
        let (s, rest) ← readString (tail.length + 1) tail []
        return (.str s, rest)
      | 123 :: tail =>
        if depth >= 10000 then .error (.tooDeep 123)
        else jsonFields f (depth+1) tail [] true
      | 91 :: tail =>
        if depth >= 10000 then .error (.tooDeep 91)
        else jsonItems f (depth+1) tail [] true
      | 116 :: tail => do return (.bool true, ← stripLiteral "true" (bytes "rue") tail)
      | 102 :: tail => do return (.bool false, ← stripLiteral "false" (bytes "alse") tail)
      | 110 :: tail => do return (.null, ← stripLiteral "null" (bytes "ull") tail)
      | b :: tail =>
        if b == 45 || digit b then do
          let (s, rest) ← readNumber (b :: tail)
          return (.num s, rest)
        else .error (.invalid b "looking for beginning of value")
  termination_by structural fuel _ _ => fuel
  def jsonItems : Nat → Nat → Bytes → List J → Bool → Except JsonErr (J × Bytes)
    | 0, _, _, _, _ => .error (.incomplete false)
    | f+1, depth, bs, rev, allowEmpty =>
      match bs.dropWhile jsonSpace with
      | 93 :: tail =>
        if allowEmpty then .ok (.arr [], tail)
        else .error (.invalid 93 "looking for beginning of value")
      | ys => do
        let (v, rest) ← jsonValue f depth ys
        match rest.dropWhile jsonSpace with
        | 93 :: tail => return (.arr (v :: rev).reverse, tail)
        | 44 :: tail => jsonItems f depth tail (v :: rev) false
        | [] => .error (.incomplete false)
        | b :: _ => .error (.invalid b "after array element")
  termination_by structural fuel _ _ _ _ => fuel
  def jsonFields : Nat → Nat → Bytes → List (String × J) → Bool → Except JsonErr (J × Bytes)
    | 0, _, _, _, _ => .error (.incomplete false)
    | f+1, depth, bs, fields, allowEmpty =>
      match bs.dropWhile jsonSpace with
      | 125 :: tail =>
        if allowEmpty then .ok (.obj [], tail)
        else .error (.invalid 125 "looking for beginning of object key string")
      | 34 :: tail => do
        let (k, rest) ← readString (tail.length + 1) tail []
        match rest.dropWhile jsonSpace with
        | 58 :: tail =>
          let (v, rest) ← jsonValue f depth tail
          let fields := setKey fields k v
          match rest.dropWhile jsonSpace with
          | 125 :: tail => return (.obj fields, tail)
          | 44 :: tail => jsonFields f depth tail fields false
          | [] => .error (.incomplete false)
          | b :: _ => .error (.invalid b "after object key:value pair")
        | [] => .error (.incomplete false)
        | b :: _ => .error (.invalid b "after object key")
      | [] => .error (.incomplete false)
      | b :: _ => .error (.invalid b "looking for beginning of object key string")
  termination_by structural fuel _ _ _ _ => fuel
end
def parsePrefix (bs : Bytes) : Except JsonErr (J × Bytes) :=
  let xs := bs.dropWhile jsonSpace
  if xs.isEmpty then .error (.incomplete true)
  else jsonValue (2 * xs.length + 3) 0 xs
def parseDoc (bs : Bytes) (strict : Bool := false) : Except JsonErr J := do
  let (v, rest) ← parsePrefix bs
  match rest.dropWhile jsonSpace with
  | b :: _ => if strict then .error (.invalid b "after top-level value") else return v
  | [] => return v
def rangesContain (rs : Array (Nat × Nat)) (c : Char) : Bool :=
  let rec search : Nat → Nat → Nat → Bool
    | 0, _, _ => false
    | k+1, lo, hi =>
      let mid := (lo + hi) / 2
      match rs[mid]? with
      | none => false
      | some (a,b) =>
        if c.toNat < a then search k lo mid
        else if b < c.toNat then search k (mid+1) hi
        else true
  search (rs.size.log2 + 1) 0 rs.size
